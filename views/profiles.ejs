<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%
  let pageTitle = globalSeoSettings && globalSeoSettings.profilesPageMetaTitle ? globalSeoSettings.profilesPageMetaTitle : "Muslim Matrimony UK | Browse 500+ Verified Profiles | shadiamour";
  let metaDescription = globalSeoSettings && globalSeoSettings.profilesPageMetaDescription ? globalSeoSettings.profilesPageMetaDescription : "Find your perfect Muslim matrimony partner for Islamic wedding and Nikkah ceremony. Browse verified Muslim couples, Pakistani marriage profiles in London, Manchester. UK's leading halal marriage site.";
  let keywords = "Muslim matrimony, Islamic wedding, Nikkah wedding ceremony, Pakistani marriage, Shaadi London, Nikkah London, halal marriage site UK, Pakistani couple, Muslim couple, Sunni Muslim marriage, Muslim marriage services, Islam love marriage, Muslim matrimonial, Muslim marriage Manchester, Pakistani wedding London";

  // Determine if this is a filtered/paginated view (non-indexable)
  const hasNonGenderFilters = filters && (filters.minAge || filters.maxAge || filters.minHeight || filters.maxHeight || filters.city || filters.country || filters.nationality);
  const isDeepPagination = page > 1;
  const shouldNoIndexPage = hasNonGenderFilters || isDeepPagination;

  // Build canonical URL: only gender filter is canonical-worthy
  let canonicalUrl = "https://shadiamour.com/profiles";
  if (filters && filters.gender && !hasNonGenderFilters && !isDeepPagination) {
    canonicalUrl = "https://shadiamour.com/profiles?gender=" + encodeURIComponent(filters.gender);
  }

  if (filters && filters.gender === 'male') {
    pageTitle = "Muslim Men for Matrimony | Islamic Wedding Grooms | Nikkah Partners UK";
    metaDescription = "Discover Muslim men seeking Islamic wedding and Nikkah ceremony. Browse Pakistani marriage profiles of single Muslim men in London, Manchester for halal matrimony.";
    keywords = "Muslim men matrimony, Islamic wedding grooms, Nikkah ceremony men, Pakistani marriage men, Muslim couple men, Sunni Muslim men marriage, halal marriage men UK, Shaadi London men, Muslim matrimonial men";
  } else if (filters && filters.gender === 'female') {
    pageTitle = "Muslim Women for Matrimony | Islamic Wedding Brides | Nikkah Partners UK";
    metaDescription = "Connect with Muslim women for Islamic wedding and Nikkah ceremony. Browse Pakistani marriage profiles of single Muslim women in London, Manchester for halal matrimony.";
    keywords = "Muslim women matrimony, Islamic wedding brides, Nikkah ceremony women, Pakistani marriage women, Muslim couple women, Sunni Muslim women marriage, halal marriage women UK, Shaadi London women, Muslim matrimonial women";
  }
%>
  <title><%= pageTitle %> | shadiamour</title>

  <!-- SEO Meta Tags -->
  <meta name="description" content="<%= metaDescription %>">
  <meta name="keywords" content="<%= keywords %>">
  <% if (shouldNoIndexPage) { %>
  <meta name="robots" content="noindex, follow">
  <% } %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#00113a">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://shadiamour.com/profiles">
  <meta property="og:title" content="<%= pageTitle %> | shadiamour">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:image" content="https://shadiamour.com/images/og-image-profiles.jpg">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="https://shadiamour.com/profiles">
  <meta property="twitter:title" content="<%= pageTitle %> | shadiamour">
  <meta property="twitter:description" content="<%= metaDescription %>">
  <meta property="twitter:image" content="https://shadiamour.com/images/og-image-profiles.jpg">

  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>

  <!-- FAQ Schema for profiles page (GEO) -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I find a Muslim spouse on shadiamour?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Browse verified Muslim profiles by gender, age, location, and ethnicity using the filters on this page. Create a free account to view full profiles and express interest. All profiles are manually verified by our team to ensure authenticity."
          }
        },
        {
          "@type": "Question",
          "name": "Are the Muslim marriage profiles on shadiamour verified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, every profile on shadiamour is manually reviewed and verified by our matchmaking team before it becomes visible. We check for authenticity, completeness, and genuine intent for halal marriage. Fake profiles and time wasters are rejected."
          }
        },
        {
          "@type": "Question",
          "name": "What is the safest matrimony site for Muslim women in the UK?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "shadiamour is designed with women's safety as a priority. Your phone number is never shared without explicit consent, profiles are verified before approval, and all communication can be managed through our team. We are GDPR-compliant and built exclusively for serious halal marriage — not casual dating."
          }
        },
        {
          "@type": "Question",
          "name": "Can I search Muslim profiles by city in the UK?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. You can filter profiles by city including London, Birmingham, Manchester, Bradford, Leeds, Leicester, Sheffield, and more. We also have dedicated city hub pages for the most popular Muslim marriage locations in the UK."
          }
        }
      ]
    }
  </script>

  <link rel="stylesheet" href="/css/output.css">

  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"></noscript>
  <style>
    :where([class^="ri-"])::before {
      content: "\f3c2";
    }

    #mobileFilterPanel {
      box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
    }

    /* Backdrop blur effect (optional) */
    #mobileFilterOverlay {
      backdrop-filter: blur(2px);
    }

    /* Ensure smooth transitions */
    #mobileFilterOverlay,
    #mobileFilterPanel {
      will-change: transform, opacity;
    }

    /* Compatibility score circle overlay on profile cards */
    .match-score-badge {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 12px;
      z-index: 10;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }
    .match-score-high { background: #dcfce7; color: #16a34a; border: 2px solid #16a34a; }
    .match-score-mid { background: #fef3c7; color: #d97706; border: 2px solid #d97706; }
    .match-score-low { background: #f1f5f9; color: #94a3b8; border: 2px solid #94a3b8; }

    /* Skeleton loader for images */
    .aspect-\[4\/5\] {
      background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
      background-size: 200% 100%;
      animation: loading 1.5s infinite;
    }

    @keyframes loading {
      0% {
        background-position: 200% 0;
      }

      100% {
        background-position: -200% 0;
      }
    }

    .aspect-\[4\/5\]:has(img.loaded) {
      background: none;
      animation: none;
    }

    /* Progressive image loading */
    img {
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    img.loaded,
    img[src*="ui-avatars"] {
      opacity: 1;
    }

    /* Prevent horizontal overflow */
    body {
      overflow-x: hidden;
    }

    html {
      overflow-x: hidden;
    }

    /* Ensure pagination stays within viewport */
    .pagination-container {
      max-width: 100%;
      overflow-x: auto;
    }
  </style>
  <!-- **ENHANCED**: Structured Data for SEO -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "<%= pageTitle %>",
      "description": "<%= metaDescription %>",
      "url": "https://shadiamour.com/profiles",
      "mainEntity": {
        "@type": "ItemList",
        "name": "Muslim Matrimony Profiles",
