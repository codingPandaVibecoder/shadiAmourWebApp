            </button>
            <button id="fourCol" class="w-10 h-10 flex items-center justify-center rounded-lg border-2 border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary transition-all duration-300 relative group" aria-label="Compact Cards">
              <span class="material-symbols-outlined text-lg">calendar_view_month</span>
              <div class="absolute bottom-12 left-1/2 transform -translate-x-1/2 bg-on-surface text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap">
                Compact Cards
