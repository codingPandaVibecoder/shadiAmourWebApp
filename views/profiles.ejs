        </div>

        <!-- Featured Profiles Section -->
        <% if (featuredProfiles && featuredProfiles.length > 0) { %>
        <div class="mb-12">
          <div class="flex items-center justify-center mb-8">
            <div class="flex items-center">
              <span class="material-symbols-outlined text-2xl text-premium-gold mr-3" style="font-variation-settings: 'FILL' 1;">star</span>
              <h2 class="text-headline-lg font-headline-lg text-primary">Featured Muslim Matrimony Profiles</h2>
              <span class="material-symbols-outlined text-2xl text-premium-gold ml-3" style="font-variation-settings: 'FILL' 1;">star</span>
            </div>
          </div>
          <p class="text-center text-on-surface-variant mb-8 max-w-2xl mx-auto">
            Discover highlighted Muslim singles ready for Islamic wedding and Nikkah ceremony. These verified profiles represent our most active members seeking Pakistani marriage and halal matrimony.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-element-gap mb-8">
            <% featuredProfiles.forEach(profile => { %>
            <a href="/profiles/<%= profile.profileSlug || profile._id %>" data-track="true" data-event-name="featured_profile_click" data-category="engagement" data-label="<%= profile.username %>" class="bg-surface-white rounded-[16px] overflow-hidden shadow-[0px_4px_20px_rgba(0,35,102,0.05)] border border-outline-variant/20 hover:-translate-y-1 transition-transform duration-300 flex flex-col h-full block relative group">
              <!-- Featured Badge -->
              <div class="absolute top-3 right-3 z-10">
                <div class="bg-premium-gold text-white px-2 py-1 rounded-full text-xs font-semibold flex items-center">
                  <span class="material-symbols-outlined text-sm mr-1" style="font-variation-settings: 'FILL' 1;">star</span>
                  Featured
                </div>
              </div>
              <!-- Staff Verified badge (staff-added only) -->
              <% if (profile.registrationSource === 'admin') { %>
              <div class="absolute top-3 left-3 z-10 bg-white/90 backdrop-blur-sm px-2.5 py-1 rounded-full flex items-center gap-1 shadow-sm border border-premium-gold/30">
                <span class="material-symbols-outlined text-halal-green text-[16px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                <span class="text-[10px] font-label-md text-primary tracking-wider uppercase">Staff Verified</span>
              </div>
              <% } %>
              <!-- Compatibility score badge (logged-in only) -->
              <% if (typeof user !== 'undefined' && user) { %>
                <%
                  const fmScore = profile.matchScore != null ? profile.matchScore : 0;
                  let fmClass = 'match-score-low';
                  if (fmScore >= 70) fmClass = 'match-score-high';
                  else if (fmScore >= 50) fmClass = 'match-score-mid';
                %>
                <div class="match-score-badge <%= fmClass %>" style="top: 44px; right: 8px;" title="Compatibility Score"><%= fmScore %>%</div>
              <% } %>
              <div class="relative h-64 w-full overflow-hidden">
                <% if (profile.profilePic && profile.profilePic.url) { %>
                <img src="<%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_300,h_400,q_auto,f_auto/') %>" srcset="<%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_200,h_267,q_auto,f_auto/') %> 200w, <%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_300,h_400,q_auto,f_auto/') %> 300w, <%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_400,h_533,q_auto,f_auto/') %> 400w" sizes="(max-width: 640px) 50vw, (max-width: 1024px) 25vw, 300px" alt="<%= profile.name || profile.username %><%= profile.age ? ', ' + profile.age + ' year old' : '' %><%= profile.work ? ' ' + profile.work : '' %> - Muslim matrimony profile<%= profile.city ? ' in ' + profile.city : '' %>" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" width="300" height="400" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(profile.name || profile.username) %>&background=<%= profile.gender === 'male' ? '0077be' : 'e91e63' %>&color=fff&size=300&format=png'">
                <% } else { %>
                <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(profile.name || profile.username) %>&background=<%= profile.gender === 'male' ? '0077be' : 'e91e63' %>&color=fff&size=300&format=png" alt="<%= profile.name || profile.username %>" class="w-full h-full object-cover" loading="lazy">
                <% } %>
              </div>
              <div class="p-5 flex flex-col flex-grow">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-[20px] font-headline-md text-primary leading-tight truncate"><%= profile.username %></h3>
                  <% if (profile.age) { %>
                  <span class="text-sm text-on-surface-variant bg-surface-container-low px-2 py-1 rounded-full flex-shrink-0"><%= profile.age %></span>
                  <% } %>
                </div>
                <p class="text-on-surface-variant text-body-md font-body-md mb-2 truncate">
                  <% if (profile.city && profile.country) { %><%= profile.city %>, <%= profile.country %><% } else if (profile.city) { %><%= profile.city %><% } else if (profile.country) { %><%= profile.country %><% } else { %>Location not specified<% } %>
                </p>
                <div class="mt-auto pt-3">
                  <span class="w-full py-2.5 border border-primary text-primary font-label-md text-label-md rounded-lg hover:bg-primary/5 transition-colors text-center block">View Profile</span>
                </div>
              </div>
            </a>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Other Profiles Section -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4">
          <div>
            <h2 class="text-headline-lg font-headline-lg text-primary mb-2">
              <% if (featuredProfiles && featuredProfiles.length > 0) { %>
              More Muslim Matrimony Profiles
              <% } else { %>
              All Muslim Matrimony Profiles
              <% } %>
            </h2>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <!-- Sort By Dropdown -->
            <div class="flex items-center gap-2">
              <label class="text-sm font-medium text-on-surface-variant whitespace-nowrap">Sort by:</label>
              <select id="sortBySelect" class="px-3 py-2.5 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-on-surface bg-white text-sm">
                <% if (typeof user !== 'undefined' && user && !isSameGenderBrowse) { %>
                <option value="top-matches" <%= (!sortBy || sortBy === 'top-matches') ? 'selected' : '' %>>Top Matches</option>
                <% } %>
                <option value="newly-created" <%= (sortBy === 'newly-created' || isSameGenderBrowse) ? 'selected' : '' %>>Newly Created</option>
                <option value="random" <%= sortBy === 'random' ? 'selected' : '' %>>Random</option>
              </select>
            </div>

            <!-- Results Count -->
            <div class="text-sm text-on-surface-variant whitespace-nowrap">
              <% if (filters) { %>
              Showing <%= profiles.length %> filtered results
              <% } else { %>
              Showing <%= profiles.length %> of <%= totalProfiles %> profiles
              <% } %>
            </div>
          </div>
        </div>

        <!-- Profiles Grid -->
        <div id="profileGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-element-gap">
          <!-- Show user's own profile card if not approved -->
          <% if (currentUserProfile && !currentUserProfile.isApproved) { %>
          <a href="/profiles/<%= currentUserProfile.profileSlug || currentUserProfile._id %>" data-track="true" data-event-name="own_profile_view" data-category="engagement" data-label="Your Pending Profile" class="bg-surface-white rounded-[16px] overflow-hidden shadow-[0px_4px_20px_rgba(0,35,102,0.05)] border-2 border-amber-300 hover:-translate-y-1 transition-transform duration-300 flex flex-col h-full block relative">
            <div class="absolute top-3 left-3 z-10 bg-amber-500 text-white px-2 py-1 rounded-full text-xs font-medium flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">visibility_off</span>
              Your Profile (Pending)
            </div>
            <div class="relative h-64 w-full overflow-hidden">
              <% if (currentUserProfile.profilePic && currentUserProfile.profilePic.url) { %>
              <img src="<%= currentUserProfile.profilePic.url.replace('/upload/', '/upload/c_fill,w_300,h_400,q_auto,f_auto/') %>" alt="<%= currentUserProfile.name || currentUserProfile.username %>" class="w-full h-full object-cover object-top" loading="lazy" onload="this.classList.add('loaded')">
              <% } else { %>
              <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(currentUserProfile.name || currentUserProfile.username) %>&background=<%= currentUserProfile.gender === 'male' ? '0077be' : 'e91e63' %>&color=fff&size=300&format=png" alt="<%= currentUserProfile.name || currentUserProfile.username %>" class="w-full h-full object-cover" loading="lazy">
              <% } %>
            </div>
            <div class="p-5 flex flex-col flex-grow">
              <h3 class="text-[20px] font-headline-md text-primary leading-tight mb-1"><%= currentUserProfile.username %></h3>
              <p class="text-on-surface-variant text-body-md font-body-md mb-1">
                <% if (currentUserProfile.city && currentUserProfile.country) { %><%= currentUserProfile.city %>, <%= currentUserProfile.country %><% } else if (currentUserProfile.city) { %><%= currentUserProfile.city %><% } else if (currentUserProfile.country) { %><%= currentUserProfile.country %><% } else { %>Location not specified<% } %>
              </p>
              <% if (currentUserProfile.age) { %>
              <p class="text-on-surface-variant text-body-md font-body-md"><%= currentUserProfile.age %> years old</p>
              <% } %>
            </div>
          </a>
          <% } %>

          <% if (profiles && profiles.length > 0) { %>
          <% profiles.forEach(profile => { %>
          <%
            let locText = 'Location not specified';
            if (profile.city && profile.country) locText = profile.city + ', ' + profile.country;
            else if (profile.city) locText = profile.city;
            else if (profile.country) locText = profile.country;

            let workIcon = 'work';
            const w = (profile.work || '').toLowerCase();
            if (/doctor|nurse|medic|pharma|dental|health/.test(w)) workIcon = 'medical_services';
            else if (/student|phd|ph\.?d|research|scholar/.test(w)) workIcon = 'school';
            else if (/software|engineer|developer|tech|computer|data/.test(w)) workIcon = 'laptop_mac';
            else if (/architect/.test(w)) workIcon = 'architecture';
            else if (/teacher|lecturer|professor|education|tutor/.test(w)) workIcon = 'school';
            else if (/lawyer|legal|solicitor|barrister/.test(w)) workIcon = 'balance';
            else if (/account|finance|bank|audit/.test(w)) workIcon = 'account_balance';
            else if (/business|manager|management|ceo|director|executive|admin/.test(w)) workIcon = 'business_center';
          %>
          <a href="/profiles/<%= profile.profileSlug || profile._id %>" data-track="true" data-event-name="profile_card_click" data-category="engagement" data-label="<%= profile.username %>" class="bg-surface-white rounded-[16px] overflow-hidden shadow-[0px_4px_20px_rgba(0,35,102,0.05)] border border-outline-variant/20 hover:-translate-y-1 transition-transform duration-300 flex flex-col h-full block relative group">
            <div class="relative h-64 w-full overflow-hidden">
              <% if (profile.profilePic && profile.profilePic.url) { %>
              <img src="<%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_300,h_400,q_auto,f_auto/') %>" srcset="<%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_200,h_267,q_auto,f_auto/') %> 200w, <%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_300,h_400,q_auto,f_auto/') %> 300w, <%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_400,h_533,q_auto,f_auto/') %> 400w" sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 300px" alt="<%= profile.name || profile.username %><%= profile.age ? ', ' + profile.age + ' year old' : '' %><%= profile.work ? ' ' + profile.work : '' %> - Muslim marriage profile<%= profile.city ? ' in ' + profile.city : '' %>" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" width="300" height="400" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(profile.name || profile.username) %>&background=<%= profile.gender === 'male' ? '0077be' : 'e91e63' %>&color=fff&size=300&format=png'">
              <% } else { %>
              <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(profile.name || profile.username) %>&background=<%= profile.gender === 'male' ? '0077be' : 'e91e63' %>&color=fff&size=300&format=png" alt="<%= profile.name || profile.username %><%= profile.age ? ', ' + profile.age + ' year old' : '' %><%= profile.work ? ' ' + profile.work : '' %> - Muslim marriage profile<%= profile.city ? ' in ' + profile.city : '' %>" class="w-full h-full object-cover" loading="lazy">
              <% } %>
              <!-- Staff Verified badge (staff-added only) -->
              <% if (profile.registrationSource === 'admin') { %>
              <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-sm border border-premium-gold/30">
                <span class="material-symbols-outlined text-halal-green text-[18px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                <span class="text-[12px] font-label-md text-primary tracking-wider uppercase">Staff Verified</span>
              </div>
              <% } %>
              <!-- Compatibility score badge (logged-in users only) -->
              <% if (typeof user !== 'undefined' && user) { %>
                <%
                  const mScore = profile.matchScore != null ? profile.matchScore : 0;
                  let mClass = 'match-score-low';
                  if (mScore >= 70) mClass = 'match-score-high';
                  else if (mScore >= 50) mClass = 'match-score-mid';
                %>
                <div class="match-score-badge <%= mClass %>" title="Compatibility Score"><%= mScore %>%</div>
              <% } %>
            </div>
            <div class="p-5 flex flex-col flex-grow">
              <div class="mb-2">
                <h3 class="text-[20px] font-headline-md text-primary leading-tight truncate"><%= profile.username %></h3>
                <p class="text-on-surface-variant text-body-md font-body-md">
                  <%= profile.age ? profile.age + ' • ' : '' %><%= locText %>
                </p>
              </div>
              <% if (profile.work) { %>
              <p class="text-body-md font-body-md text-on-surface mb-6 flex-grow flex items-center gap-2">
                <span class="material-symbols-outlined text-outline text-[20px]"><%= workIcon %></span>
                <%= profile.work %>
              </p>
              <% } else { %>
              <div class="mb-6 flex-grow"></div>
              <% } %>
              <div class="mt-auto">
                <span class="w-full py-2.5 border border-primary text-primary font-label-md text-label-md rounded-lg hover:bg-primary/5 transition-colors text-center block">View Profile</span>
              </div>
            </div>
          </a>
          <% }) %>
          <% } else { %>
          <!-- No profiles found message -->
          <div class="col-span-full text-center py-16">
            <div class="max-w-md mx-auto">
              <div class="mb-4">
                <span class="material-symbols-outlined text-6xl text-outline/40">person_search</span>
              </div>
              <h3 class="text-xl font-semibold text-on-surface-variant mb-2">No Profiles Found</h3>
              <p class="text-on-surface-variant mb-6">
                <% if (filters) { %>
                No profiles match your current filters. Try adjusting your search criteria.
                <% } else { %>
                There are currently no profiles to display.
                <% } %>
              </p>
              <% if (filters) { %>
              <a href="/profiles" class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary text-on-primary rounded-lg hover:bg-primary-container transition-colors">
                <span class="material-symbols-outlined text-lg">refresh</span>
                <span>Clear Filters</span>
              </a>
              <% } %>
            </div>
          </div>
          <% } %>
        </div>

        <!-- Pagination -->
        <% if (profiles && profiles.length > 0 && totalPages > 1) { %>
        <div class="pagination-container flex justify-center items-center gap-2 sm:gap-4 mt-12 overflow-x-auto pb-2">
          <% if (page > 1) { %>
          <a href="/profiles?page=<%= page - 1 %><% if (filters) { %><% Object.keys(filters).forEach(key => { if (filters[key]) { %>&<%= key %>=<%= encodeURIComponent(filters[key]) %><% } }) %><% } %><% if (sortBy && sortBy !== 'newly-created') { %>&sortBy=<%= sortBy %><% } %>" data-track="true" data-event-name="pagination_prev" data-category="engagement" data-label="Previous Page" class="flex items-center gap-1 sm:gap-2 px-2 sm:px-4 py-2 border border-outline-variant rounded-lg text-on-surface-variant hover:border-primary hover:text-primary transition-all duration-300 whitespace-nowrap flex-shrink-0">
            <span class="material-symbols-outlined text-lg">chevron_left</span>
            <span class="sm:hidden">Prev</span>
          </a>
          <% } %>

          <div class="flex items-center gap-1 sm:gap-2 flex-shrink-0">
            <% for (let i = Math.max(1, page - 2); i <= Math.min(totalPages, page + 2); i++) { %>
            <% if (i === page) { %>
            <span class="w-10 h-10 flex items-center justify-center bg-primary text-on-primary rounded-lg"><%= i %></span>
            <% } else { %>
            <a href="/profiles?page=<%= i %><% if (filters) { %><% Object.keys(filters).forEach(key => { if (filters[key]) { %>&<%= key %>=<%= encodeURIComponent(filters[key]) %><% } }) %><% } %><% if (sortBy && sortBy !== 'newly-created') { %>&sortBy=<%= sortBy %><% } %>" data-track="true" data-event-name="pagination_page" data-category="engagement" data-label="Page <%= i %>" class="w-10 h-10 flex items-center justify-center border border-outline-variant rounded-lg text-on-surface-variant hover:border-primary hover:text-primary transition-all duration-300"><%= i %></a>
            <% } %>
            <% } %>
          </div>

          <% if (page < totalPages) { %>
          <a href="/profiles?page=<%= page + 1 %><% if (filters) { %><% Object.keys(filters).forEach(key => { if (filters[key]) { %>&<%= key %>=<%= encodeURIComponent(filters[key]) %><% } }) %><% } %><% if (sortBy && sortBy !== 'newly-created') { %>&sortBy=<%= sortBy %><% } %>" data-track="true" data-event-name="pagination_next" data-category="engagement" data-label="Next Page" class="flex items-center gap-1 sm:gap-2 px-2 sm:px-4 py-2 border border-outline-variant rounded-lg text-on-surface-variant hover:border-primary hover:text-primary transition-all duration-300 whitespace-nowrap flex-shrink-0">
            <span class="hidden sm:inline">Next</span>
            <span class="sm:hidden">Next</span>
            <span class="material-symbols-outlined text-lg">chevron_right</span>
          </a>
          <% } %>
        </div>
        <% } %>
      </div>
    </section>
  </main>

  <!-- Mobile Filter Overlay -->
  <div id="mobileFilterOverlay" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden lg:hidden transition-opacity duration-300 opacity-0">
    <div id="mobileFilterPanel" class="fixed left-0 top-0 h-full w-80 bg-surface-white overflow-y-auto transform -translate-x-full transition-transform duration-300 ease-in-out">
      <div class="p-6">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-headline-md font-headline-md text-primary">Filter Profiles</h3>
          <button id="closeMobileFilter" class="text-on-surface-variant hover:text-primary transition-colors duration-200" aria-label="Close filters">
            <span class="material-symbols-outlined text-xl">close</span>
          </button>
        </div>
        <div class="bg-neutral-gray rounded-xl p-6">
          <form id="mobileFilterForm" class="space-y-6">
            <!-- Gender Filter -->
            <div>
              <label class="block text-label-md font-label-md text-on-surface-variant mb-3 uppercase tracking-wider">Gender</label>
              <div class="space-y-2">
                <label class="flex items-center cursor-pointer">
                  <input type="radio" name="gender" value="" class="h-4 w-4 text-primary focus:ring-primary border-outline-variant" <%= !filters?.gender ? 'checked' : '' %>>
                  <span class="ml-3 text-body-md text-on-surface">All</span>
                </label>
                <label class="flex items-center cursor-pointer">
                  <input type="radio" name="gender" value="male" class="h-4 w-4 text-primary focus:ring-primary border-outline-variant" <%= filters?.gender === 'male' ? 'checked' : '' %>>
                  <span class="ml-3 text-body-md text-on-surface">Male</span>
                </label>
                <label class="flex items-center cursor-pointer">
                  <input type="radio" name="gender" value="female" class="h-4 w-4 text-primary focus:ring-primary border-outline-variant" <%= filters?.gender === 'female' ? 'checked' : '' %>>
                  <span class="ml-3 text-body-md text-on-surface">Female</span>
                </label>
              </div>
            </div>

            <!-- Age Range Filter (selects) -->
            <div>
              <label class="block text-label-md font-label-md text-on-surface-variant mb-3 uppercase tracking-wider">Age Range</label>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <select name="minAge" id="mobileMinAgeSelect" class="block w-full px-3 py-2.5 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-on-surface bg-white text-sm">
                    <option value="">Min Age</option>
                    <% for (let a = 18; a <= 70; a++) { %>
                      <option value="<%= a %>" <%= (filters?.minAge && Number(filters.minAge) === a) ? 'selected' : '' %>><%= a %></option>
                    <% } %>
                  </select>
                </div>
                <div>
                  <select name="maxAge" id="mobileMaxAgeSelect" class="block w-full px-3 py-2.5 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-on-surface bg-white text-sm">
                    <option value="">Max Age</option>
                    <% for (let a = 18; a <= 70; a++) { %>
                      <option value="<%= a %>" <%= (filters?.maxAge && Number(filters.maxAge) === a) ? 'selected' : '' %>><%= a %></option>
                    <% } %>
                  </select>
                </div>
              </div>
            </div>

            <!-- Height Range Filter -->
            <div>
              <label class="block text-label-md font-label-md text-on-surface-variant mb-3 uppercase tracking-wider">Height Range</label>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <select name="minHeight" id="mobileMinHeight" class="block w-full px-3 py-2.5 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-on-surface bg-white text-sm">
                    <option value="">Min Height</option>
                    <%
                    const mobileHeights = [
                      { cm: 152, display: "5'0\"" },
                      { cm: 155, display: "5'1\"" },
                      { cm: 157, display: "5'2\"" },
                      { cm: 160, display: "5'3\"" },
                      { cm: 163, display: "5'4\"" },
                      { cm: 165, display: "5'5\"" },
                      { cm: 168, display: "5'6\"" },
                      { cm: 170, display: "5'7\"" },
                      { cm: 173, display: "5'8\"" },
                      { cm: 175, display: "5'9\"" },
                      { cm: 178, display: "5'10\"" },
                      { cm: 180, display: "5'11\"" },
                      { cm: 183, display: "6'0\"" },
                      { cm: 185, display: "6'1\"" },
                      { cm: 188, display: "6'2\"" },
                      { cm: 191, display: "6'3\"" },
                      { cm: 193, display: "6'4\"" },
                      { cm: 196, display: "6'5\"" },
                      { cm: 198, display: "6'6\"" },
                      { cm: 201, display: "6'7\"" }
                    ];
                    %>
                    <% mobileHeights.forEach(height => { %>
                    <option value="<%= height.cm %>" <%= filters?.minHeight == height.cm ? 'selected' : '' %>>
                      <%= height.display %>
                    </option>
                    <% }) %>
                  </select>
                </div>
                <div>
                  <select name="maxHeight" id="mobileMaxHeight" class="block w-full px-3 py-2.5 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-on-surface bg-white text-sm">
                    <option value="">Max Height</option>
                    <% mobileHeights.forEach(height => { %>
                    <option value="<%= height.cm %>" <%= filters?.maxHeight == height.cm ? 'selected' : '' %>>
                      <%= height.display %>
                    </option>
                    <% }) %>
                  </select>
                </div>
              </div>
            </div>

            <!-- Location Filter: Country & City Selects -->
