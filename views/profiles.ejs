                <!-- Compatibility score badge (logged-in only, below featured badge) -->
                <% if (typeof user !== 'undefined' && user && profile.matchScore != null) { %>
                  <% 
                    const fmScore = profile.matchScore;
                    let fmClass = 'match-score-low';
                    if (fmScore >= 70) fmClass = 'match-score-high';
                    else if (fmScore >= 50) fmClass = 'match-score-mid';
                  %>
                  <div class="match-score-badge <%= fmClass %>" style="top: 44px; right: 8px;" title="Compatibility Score">
                    <%= fmScore %>%
                  </div>
                <% } %>

                <!-- Profile Image -->
                <div class="aspect-[4/5] overflow-hidden relative">
                  <% if (profile.profilePic && profile.profilePic.url) { %>
                  <img src="<%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_300,h_400,q_auto,f_auto/') %>" srcset="<%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_200,h_267,q_auto,f_auto/') %> 200w, <%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_300,h_400,q_auto,f_auto/') %> 300w, <%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_400,h_533,q_auto,f_auto/') %> 400w" sizes="(max-width: 640px) 50vw, (max-width: 1024px) 25vw, 300px" alt="<%= profile.name || profile.username %><%= profile.age ? ', ' + profile.age + ' year old' : '' %><%= profile.work ? ' ' + profile.work : '' %> - Muslim matrimony profile<%= profile.city ? ' in ' + profile.city : '' %>" class="w-full h-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" width="300" height="400" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(profile.name || profile.username) %>&background=<%= profile.gender === 'male' ? '0077be' : 'e91e63' %>&color=fff&size=300&format=png'">
                  <% } else { %>
                  <!-- Default avatar based on gender -->
                  <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(profile.name || profile.username) %>&background=<%= profile.gender === 'male' ? '0077be' : 'e91e63' %>&color=fff&size=300&format=png" alt="<%= profile.name || profile.username %>" class="w-full h-full object-cover" loading="lazy">
                  <% } %>
                </div>

                <!-- Profile Info -->
                <div class="p-4">
                  <div class="flex items-center justify-between mb-2">
                    <h3 class="text-lg font-semibold text-gray-900 truncate">
                      <%= profile.username %>
                    </h3>
                    <% if (profile.age) { %>
                    <span class="text-sm text-gray-500 bg-gray-100 px-2 py-1 rounded-full">
                      <%= profile.age %>
                    </span>
                    <% } %>
                  </div>

                  <!-- Location -->
                  <div class="flex items-center text-gray-600 mb-3 text-sm">
                    <i class="ri-map-pin-line mr-2"></i>
                    <span class="truncate">
                      <% if (profile.city && profile.country) { %>
                      <%= profile.city %>, <%= profile.country %>
                      <% } else if (profile.city) { %>
                      <%= profile.city %>
                      <% } else if (profile.country) { %>
                      <%= profile.country %>
                      <% } else { %>
                      Location not specified
                      <% } %>
                    </span>
                  </div>

                  <!-- View Profile Button -->
                  <a href="/profiles/<%= profile.profileSlug || profile._id %>" data-track="true" data-event-name="featured_profile_click" data-category="engagement" data-label="<%= profile.username %>" class="w-full bg-gradient-to-r from-primary to-secondary text-white py-2 px-4 rounded-button hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300 text-center inline-block font-medium">
                    <i class="ri-eye-line mr-2"></i>
                    View Profile
                  </a>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
          <% } %>

          <!-- **UPDATED**: Other Profiles Section -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4">
            <div>
              <h2 class="text-3xl font-bold text-gray-800 font-['Playfair_Display'] mb-2">
                <% if (featuredProfiles && featuredProfiles.length > 0) { %>
                More Muslim Matrimony Profiles
                <% } else { %>
                All Muslim Matrimony Profiles
                <% } %>
              </h2>
            </div>

            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
              <!-- Sort By Dropdown -->
              <div class="flex items-center gap-2">
                <label class="text-sm font-medium text-gray-700 whitespace-nowrap">Sort by:</label>
                <select id="sortBySelect" class="px-3 py-2 border border-gray-300 rounded-button focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary text-sm bg-white">
                  <option value="newly-created" <%= (sortBy === 'newly-created' || !sortBy) ? 'selected' : '' %>>Newly Created</option>
                  <option value="random" <%= sortBy === 'random' ? 'selected' : '' %>>Random</option>
                </select>
              </div>

              <!-- Results Count -->
              <div class="text-sm text-gray-600 whitespace-nowrap">
                <% if (filters) { %>
                Showing <%= profiles.length %> filtered results
                <% } else { %>
                Showing <%= profiles.length %> of <%= totalProfiles %> profiles
                <% } %>
              </div>
            </div>
          </div>
          <!-- Profiles Grid -->
          <div id="profileGrid" class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
            <!-- Show user's own profile card if not approved -->
            <% if (currentUserProfile && !currentUserProfile.isApproved) { %>
            <a href="/profiles/<%= currentUserProfile.profileSlug || currentUserProfile._id %>" data-track="true" data-event-name="own_profile_view" data-category="engagement" data-label="Your Pending Profile" class="bg-white rounded-2xl overflow-hidden material-shadow hover:material-shadow-hover transition-all duration-300 block relative border-2 border-amber-300">
              <div class="absolute top-2 left-2 z-10 bg-amber-500 text-white px-2 py-1 rounded-full text-xs font-medium flex items-center gap-1">
                <i class="ri-eye-off-line"></i>
                Your Profile (Pending)
              </div>
              <div class="aspect-[4/5] overflow-hidden">
                <% if (currentUserProfile.profilePic && currentUserProfile.profilePic.url) { %>
                <img src="<%= currentUserProfile.profilePic.url.replace('/upload/', '/upload/c_fill,w_300,h_400,q_auto,f_auto/') %>" alt="<%= currentUserProfile.name || currentUserProfile.username %>" class="w-full h-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" onload="this.classList.add('loaded')">
                <% } else { %>
                <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(currentUserProfile.name || currentUserProfile.username) %>&background=<%= currentUserProfile.gender === 'male' ? '0077be' : 'e91e63' %>&color=fff&size=300&format=png" alt="<%= currentUserProfile.name || currentUserProfile.username %>" class="w-full h-full object-cover" loading="lazy">
                <% } %>
              </div>
              <div class="p-4">
                <h3 class="text-lg font-semibold text-gray-900 mb-1">
                  <%= currentUserProfile.username %>
                </h3>
                <div class="flex items-center text-gray-600 mb-2">
                  <i class="ri-map-pin-line mr-2"></i>
                  <span>
                    <% if (currentUserProfile.city && currentUserProfile.country) { %>
                    <%= currentUserProfile.city %>, <%= currentUserProfile.country %>
                    <% } else if (currentUserProfile.city) { %>
                    <%= currentUserProfile.city %>
                    <% } else if (currentUserProfile.country) { %>
                    <%= currentUserProfile.country %>
                    <% } else { %>
                    Location not specified
                    <% } %>
                  </span>
                </div>
                <% if (currentUserProfile.age) { %>
                <div class="flex items-center text-gray-600 mb-2">
                  <i class="ri-calendar-line mr-2"></i>
                  <span><%= currentUserProfile.age %> years old</span>
                </div>
                <% } %>
              </div>
            </a>
            <% } %>
            
            <% if (profiles && profiles.length > 0) { %>
            <% profiles.forEach(profile => { %>
            <a href="/profiles/<%= profile.profileSlug || profile._id %>" data-track="true" data-event-name="profile_card_click" data-category="engagement" data-label="<%= profile.username %>" class="bg-white rounded-2xl overflow-hidden material-shadow hover:material-shadow-hover transition-all duration-300 block relative">
              <!-- Compatibility score badge (logged-in users only) -->
              <% if (typeof user !== 'undefined' && user && profile.matchScore != null) { %>
                <% 
                  const mScore = profile.matchScore;
                  let mClass = 'match-score-low';
                  if (mScore >= 70) mClass = 'match-score-high';
                  else if (mScore >= 50) mClass = 'match-score-mid';
                %>
                <div class="match-score-badge <%= mClass %>" title="Compatibility Score">
                  <%= mScore %>%
                </div>
              <% } %>
              <div class="aspect-[4/5] overflow-hidden">
                <!-- Default placeholder based on gender -->
                <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(profile.name || profile.username) %>&background=<%= profile.gender === 'male' ? '0077be' : 'e91e63' %>&color=fff&size=300&format=png" alt="<%= profile.name || profile.username %><%= profile.age ? ', ' + profile.age + ' year old' : '' %><%= profile.work ? ' ' + profile.work : '' %> - Muslim marriage profile<%= profile.city ? ' in ' + profile.city : '' %>" class="w-full h-full object-cover" loading="lazy" width="300" height="300">
                
              </div>
              <div class="p-4">
                <h3 class="text-lg font-semibold text-gray-900 mb-1">
                  <%= profile.username %>
                </h3>
                <div class="flex items-center text-gray-600 mb-2">
                  <i class="ri-map-pin-line mr-2"></i>
                  <span>
                    <% if (profile.city && profile.country) { %>
                    <%= profile.city %>, <%= profile.country %>
                    <% } else if (profile.city) { %>
                    <%= profile.city %>
                    <% } else if (profile.country) { %>
                    <%= profile.country %>
                    <% } else { %>
                    Location not specified
                    <% } %>
                  </span>
                </div>
                <% if (profile.age) { %>
                <div class="flex items-center text-gray-600 mb-2">
                  <i class="ri-calendar-line mr-2"></i>
                  <span><%= profile.age %> years old</span>
                </div>
                <% } %>
              </div>
            </a>
            <% }) %>
            <% } else { %>
            <!-- No profiles found message -->
            <div class="col-span-3 text-center py-16">
              <div class="max-w-md mx-auto">
                <div class="mb-4">
                  <i class="ri-user-search-line text-6xl text-gray-300"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-600 mb-2">No Profiles Found</h3>
                <p class="text-gray-500 mb-6">
                  <% if (filters) { %>
                  No profiles match your current filters. Try adjusting your search criteria.
                  <% } else { %>
                  There are currently no profiles to display.
                  <% } %>
                </p>
                <% if (filters) { %>
                <a href="/profiles" class="inline-flex items-center gap-2 px-6 py-2 bg-primary text-white rounded-button hover:bg-pink-600 transition-all duration-300">
                  <i class="ri-refresh-line"></i>
                  <span>Clear Filters</span>
                </a>
                <% } %>
              </div>
            </div>
            <% } %>
          </div>

          <!-- Pagination -->
          <% if (profiles && profiles.length > 0 && totalPages > 1) { %>
          <div class="flex justify-center items-center gap-2 sm:gap-4 mt-12 overflow-x-auto pb-2">
            <% if (page > 1) { %>
            <a href="/profiles?page=<%= page - 1 %><% if (filters) { %><% Object.keys(filters).forEach(key => { if (filters[key]) { %>&<%= key %>=<%= encodeURIComponent(filters[key]) %><% } }) %><% } %><% if (sortBy && sortBy !== 'newly-created') { %>&sortBy=<%= sortBy %><% } %>" data-track="true" data-event-name="pagination_prev" data-category="engagement" data-label="Previous Page" class="flex items-center gap-1 sm:gap-2 px-2 sm:px-4 py-2 border border-gray-300 rounded-button text-gray-600 hover:border-primary hover:text-primary transition-all duration-300 whitespace-nowrap flex-shrink-0">
              <i class="ri-arrow-left-line"></i>
              <span class="sm:hidden">Prev</span>
            </a>
            <% } %>

            <div class="flex items-center gap-1 sm:gap-2 flex-shrink-0">
              <% for (let i = Math.max(1, page - 2); i <= Math.min(totalPages, page + 2); i++) { %>
              <% if (i === page) { %>
              <span class="w-10 h-10 flex items-center justify-center bg-primary text-white rounded-button">
                <%= i %>
              </span>
              <% } else { %>
              <a href="/profiles?page=<%= i %><% if (filters) { %><% Object.keys(filters).forEach(key => { if (filters[key]) { %>&<%= key %>=<%= encodeURIComponent(filters[key]) %><% } }) %><% } %><% if (sortBy && sortBy !== 'newly-created') { %>&sortBy=<%= sortBy %><% } %>" data-track="true" data-event-name="pagination_page" data-category="engagement" data-label="Page <%= i %>" class="w-10 h-10 flex items-center justify-center border border-gray-300 rounded-button text-gray-600 hover:border-primary hover:text-primary transition-all duration-300">
                <%= i %>
              </a>
              <% } %>
              <% } %>
            </div>

            <% if (page < totalPages) { %>
            <a href="/profiles?page=<%= page + 1 %><% if (filters) { %><% Object.keys(filters).forEach(key => { if (filters[key]) { %>&<%= key %>=<%= encodeURIComponent(filters[key]) %><% } }) %><% } %><% if (sortBy && sortBy !== 'newly-created') { %>&sortBy=<%= sortBy %><% } %>" data-track="true" data-event-name="pagination_next" data-category="engagement" data-label="Next Page" class="flex items-center gap-1 sm:gap-2 px-2 sm:px-4 py-2 border border-gray-300 rounded-button text-gray-600 hover:border-primary hover:text-primary transition-all duration-300 whitespace-nowrap flex-shrink-0">
              <span class="hidden sm:inline">Next</span>
              <span class="sm:hidden">Next</span>
              <i class="ri-arrow-right-line"></i>
            </a>
            <% } %>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>

