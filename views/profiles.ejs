            </div>
            <p class="text-center text-gray-600 mb-8 max-w-2xl mx-auto">
              Discover highlighted Muslim singles ready for Islamic wedding and Nikkah ceremony. These verified profiles represent our most active members seeking Pakistani marriage and halal matrimony.
            </p>

            <!-- Featured Profiles Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
              <% featuredProfiles.forEach(profile => { %>
              <div class="bg-white rounded-2xl overflow-hidden material-shadow hover:material-shadow-hover transition-all duration-300 group relative">
                <!-- Featured Badge -->
                <div class="absolute top-3 right-3 z-10">
