</head>

<body class="bg-background text-on-background font-body-md antialiased min-h-screen flex flex-col">
  <%- include('partials/header') %>

  <main class="flex-grow pt-[92px]">
    <!-- Page Header -->
    <section class="px-margin-x pt-8 pb-10 max-w-container-max mx-auto text-center md:text-left">
      <h1 class="text-3xl md:text-display-lg-mobile lg:text-display-lg font-display-lg text-primary mb-4 leading-tight">
        <% if (filters && filters.gender === 'male') { %>
        Muslim Men for Halal Marriage UK | Find Single Muslim Grooms for Modern Nikkah
        <% } else if (filters && filters.gender === 'female') { %>
        Muslim Women for Islamic Wedding | Single Muslim Brides Seeking Halal Marriage UK
        <% } else { %>
        Muslim Matrimony UK | Halal Muslim Matchmaking for Young Singles & Islamic Wedding Partners
        <% } %>
      </h1>
      <p class="text-body-lg font-body-lg text-on-surface-variant max-w-3xl leading-relaxed">
        <% if (filters && filters.gender === 'male') { %>
        Discover verified <strong>Muslim men for halal marriage</strong> across London, Manchester, Birmingham &amp; Leicester.
        Connect with <strong>single Muslim grooms</strong> seeking <strong>Islamic wedding</strong>, <strong>modern Nikkah ceremony</strong>
        and blessed <strong>Muslim matrimony</strong> through our trusted <strong>halal Muslim matchmaking platform</strong>.
        Find your perfect <strong>Muslim soulmate</strong> among professional <strong>young Muslim men</strong> ready for <strong>single Muslim marriage</strong>.
        <% } else if (filters && filters.gender === 'female') { %>
        Browse authentic profiles of <strong>Muslim women for Islamic wedding</strong> and <strong>halal Muslim marriage</strong>
        across major UK cities. Our <strong>Muslim matrimonial platform</strong> features <strong>single Muslim brides</strong>
        seeking <strong>modern Nikkah partnerships</strong>, <strong>Muslim shaadi</strong> and meaningful <strong>halal relationships</strong>.
        Connect with <strong>young Muslim women</strong> ready for <strong>Muslim love</strong> and blessed matrimony.
        <% } else { %>
        The UK's leading <strong>Muslim matrimonial platform</strong> connecting hearts for <strong>halal Muslim marriage</strong>,
        <strong>Islamic wedding</strong> and <strong>modern Nikkah ceremony</strong>. Discover thousands of verified
        <strong>Muslim singles UK</strong> seeking <strong>halal matchmaking</strong>, <strong>young Muslim marriage</strong>
        and blessed <strong>Muslim relationships</strong> across London, Manchester, Birmingham and nationwide.
        <% } %>
      </p>
    </section>

    <section class="px-margin-x pb-section-padding max-w-container-max mx-auto flex flex-col lg:flex-row gap-gutter">
      <!-- Sidebar Filter (desktop only — mobile uses slide-in drawer) -->
      <aside class="hidden lg:block w-full lg:w-1/4">
        <%- include('partials/profilesFilter') %>
      </aside>

      <!-- Main Content -->
      <div class="w-full lg:w-3/4">
        <!-- Pending Approval Notice for Current User -->
        <% if (currentUserProfile && !currentUserProfile.isApproved) { %>
        <div class="mb-6 bg-amber-50 border border-amber-200 rounded-xl p-4 sm:p-5">
          <div class="flex flex-col sm:flex-row sm:items-start gap-3 sm:gap-4">
            <div class="flex-1 text-center sm:text-left">
              <h3 class="text-base sm:text-lg font-semibold text-amber-800 mb-1 sm:mb-2">Your Profile is Pending Approval</h3>
              <p class="text-sm sm:text-base text-amber-700 mb-3">
                Your profile is currently only visible to yourself. Once our team reviews and approves your profile, other users will be able to see it and connect with you.
              </p>
              <div class="bg-white rounded-lg p-3 sm:p-4 border border-amber-200">
                <p class="text-xs sm:text-sm text-gray-700 mb-2">
                  <span class="material-symbols-outlined text-sm text-amber-500 mr-1">lightbulb</span>
                  <strong>Tip:</strong> Complete as many fields as possible to increase your chances of approval!
                </p>
                <a href="/account/info" data-track="true" data-event-name="complete_profile_from_profiles" data-category="engagement" data-label="Complete Your Profile" class="inline-flex items-center gap-2 text-primary hover:text-primary/70 font-medium text-sm transition-colors">
                  <span class="material-symbols-outlined text-base">edit</span>
                  Complete Your Profile
                </a>
              </div>
            </div>
          </div>
        </div>
        <% } %>

        <!-- Breadcrumb Navigation -->
        <nav class="flex py-3 px-4 mb-6 bg-neutral-gray rounded-lg text-sm text-on-surface-variant border border-outline-variant/30" aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center">
            <li class="flex items-center">
              <a href="/" class="hover:text-primary transition-colors">Home</a>
              <span class="material-symbols-outlined text-base mx-2">chevron_right</span>
            </li>
            <li class="flex items-center">
              <a href="/profiles" class="hover:text-primary transition-colors">Profiles</a>
              <% if (filters && filters.gender) { %>
              <span class="material-symbols-outlined text-base mx-2">chevron_right</span>
            </li>
            <li class="text-primary font-medium truncate">
              <%= filters.gender === 'male' ? 'Male' : 'Female' %> Profiles
              <% } %>
            </li>
          </ol>
        </nav>

        <!-- Grid Controls -->
        <div class="flex flex-wrap justify-between items-center mb-8 gap-4">
          <!-- Mobile Filter Button -->
          <button id="mobileFilterBtn" data-track="true" data-event-name="mobile_filter_open" data-category="engagement" data-label="Open Filters" class="lg:hidden px-5 py-2.5 bg-primary text-on-primary rounded-lg hover:bg-primary-container transition-colors inline-flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">filter_list</span>Filters
          </button>

          <!-- Results Count and Active Filters -->
          <div class="flex-1 min-w-0">
            <% if (totalProfiles > 0) { %>
            <% if (filters && Object.values(filters).some(f => f)) { %>
            <div class="mb-4">
              <div class="flex ml-3 flex-wrap gap-1.5 sm:gap-2">
                <% if (filters.gender) { %>
                <span class="inline-flex items-center gap-1 px-2 py-1 bg-primary bg-opacity-10 text-primary rounded text-xs sm:text-sm border border-primary border-opacity-20 whitespace-nowrap">
                  <span class="hidden sm:inline">Gender: </span><%= filters.gender.charAt(0).toUpperCase() + filters.gender.slice(1) %>
                  <button onclick="removeFilter('gender')" class="ml-1 text-red-500 hover:text-red-700 transition-colors flex-shrink-0" aria-label="Remove gender filter">
                    <span class="material-symbols-outlined text-sm">close</span>
                  </button>
                </span>
                <% } %>

                <% if (filters.minAge) { %>
                <span class="inline-flex items-center gap-1 px-2 py-1 bg-primary bg-opacity-10 text-primary rounded text-xs sm:text-sm border border-primary border-opacity-20 whitespace-nowrap">
                  <span class="hidden sm:inline">Min Age: </span><%= filters.minAge %>+
                  <button onclick="removeFilter('minAge')" class="ml-1 text-red-500 hover:text-red-700 transition-colors flex-shrink-0" aria-label="Remove min age filter">
                    <span class="material-symbols-outlined text-sm">close</span>
                  </button>
                </span>
                <% } %>

                <% if (filters.maxAge) { %>
                <span class="inline-flex items-center gap-1 px-2 py-1 bg-primary bg-opacity-10 text-primary rounded text-xs sm:text-sm border border-primary border-opacity-20 whitespace-nowrap">
                  <span class="hidden sm:inline">Max Age: </span><%= filters.maxAge %>
                  <button onclick="removeFilter('maxAge')" class="ml-1 text-red-500 hover:text-red-700 transition-colors flex-shrink-0" aria-label="Remove max age filter">
                    <span class="material-symbols-outlined text-sm">close</span>
                  </button>
                </span>
                <% } %>

                <% if (filters.minHeight) { %>
                <span class="inline-flex items-center gap-1 px-2 py-1 bg-primary bg-opacity-10 text-primary rounded text-xs sm:text-sm border border-primary border-opacity-20 whitespace-nowrap">
                  <span class="hidden sm:inline">Min: </span><%= 
                    filters.minHeight == 152 ? "5'0\"" :
                    filters.minHeight == 155 ? "5'1\"" :
                    filters.minHeight == 157 ? "5'2\"" :
                    filters.minHeight == 160 ? "5'3\"" :
                    filters.minHeight == 163 ? "5'4\"" :
                    filters.minHeight == 165 ? "5'5\"" :
                    filters.minHeight == 168 ? "5'6\"" :
                    filters.minHeight == 170 ? "5'7\"" :
                    filters.minHeight == 173 ? "5'8\"" :
                    filters.minHeight == 175 ? "5'9\"" :
                    filters.minHeight == 178 ? "5'10\"" :
                    filters.minHeight == 180 ? "5'11\"" :
                    filters.minHeight == 183 ? "6'0\"" :
                    filters.minHeight == 185 ? "6'1\"" :
                    filters.minHeight == 188 ? "6'2\"" :
                    filters.minHeight == 191 ? "6'3\"" :
                    filters.minHeight == 193 ? "6'4\"" :
                    filters.minHeight == 196 ? "6'5\"" :
                    filters.minHeight == 198 ? "6'6\"" :
                    filters.minHeight == 201 ? "6'7\"" :
                    filters.minHeight + "cm"
                  %>
                  <button onclick="removeFilter('minHeight')" class="ml-1 text-red-500 hover:text-red-700 transition-colors flex-shrink-0" aria-label="Remove min height filter">
                    <span class="material-symbols-outlined text-sm">close</span>
                  </button>
                </span>
                <% } %>

                <% if (filters.maxHeight) { %>
                <span class="inline-flex items-center gap-1 px-2 py-1 bg-primary bg-opacity-10 text-primary rounded text-xs sm:text-sm border border-primary border-opacity-20 whitespace-nowrap">
                  <span class="hidden sm:inline">Max: </span><%= 
                    filters.maxHeight == 152 ? "5'0\"" :
                    filters.maxHeight == 155 ? "5'1\"" :
                    filters.maxHeight == 157 ? "5'2\"" :
                    filters.maxHeight == 160 ? "5'3\"" :
                    filters.maxHeight == 163 ? "5'4\"" :
                    filters.maxHeight == 165 ? "5'5\"" :
                    filters.maxHeight == 168 ? "5'6\"" :
                    filters.maxHeight == 170 ? "5'7\"" :
                    filters.maxHeight == 173 ? "5'8\"" :
                    filters.maxHeight == 175 ? "5'9\"" :
                    filters.maxHeight == 178 ? "5'10\"" :
                    filters.maxHeight == 180 ? "5'11\"" :
                    filters.maxHeight == 183 ? "6'0\"" :
                    filters.maxHeight == 185 ? "6'1\"" :
                    filters.maxHeight == 188 ? "6'2\"" :
                    filters.maxHeight == 191 ? "6'3\"" :
                    filters.maxHeight == 193 ? "6'4\"" :
                    filters.maxHeight == 196 ? "6'5\"" :
                    filters.maxHeight == 198 ? "6'6\"" :
                    filters.maxHeight == 201 ? "6'7\"" :
                    filters.maxHeight + "cm"
