                      <!-- Geo-restricted: show only allowed countries -->
                      <option value="">All Cities</option>
                      <% geoFilterUI.countries.forEach(function(c) { %>
                        <option value="<%= c.value %>" <%= filters?.country === c.value ? 'selected' : '' %>><%= c.label %></option>
                      <% }); %>
                    <% } else { %>
                      <!-- No geo-restriction: show all countries -->
                      <option value="">All Countries</option>
                      <option value="United Kingdom" <%= filters?.country === 'United Kingdom' ? 'selected' : '' %> >United Kingdom</option>
                      <option value="Pakistan" <%= filters?.country === 'Pakistan' ? 'selected' : '' %> >Pakistan</option>
                      <option value="Bangladesh" <%= filters?.country === 'Bangladesh' ? 'selected' : '' %> >Bangladesh</option>
                      <option value="India" <%= filters?.country === 'India' ? 'selected' : '' %> >India</option>
                      <option value="United States" <%= filters?.country === 'United States' ? 'selected' : '' %> >United States</option>
                      <option value="Canada" <%= filters?.country === 'Canada' ? 'selected' : '' %> >Canada</option>
                      <option value="United Arab Emirates" <%= filters?.country === 'United Arab Emirates' ? 'selected' : '' %> >United Arab Emirates</option>
                      <option value="Saudi Arabia" <%= filters?.country === 'Saudi Arabia' ? 'selected' : '' %> >Saudi Arabia</option>
                      <option value="Australia" <%= filters?.country === 'Australia' ? 'selected' : '' %> >Australia</option>
                      <option value="Germany" <%= filters?.country === 'Germany' ? 'selected' : '' %> >Germany</option>
                      <option value="France" <%= filters?.country === 'France' ? 'selected' : '' %> >France</option>
                      <option value="Malaysia" <%= filters?.country === 'Malaysia' ? 'selected' : '' %> >Malaysia</option>
                      <option value="Singapore" <%= filters?.country === 'Singapore' ? 'selected' : '' %> >Singapore</option>
                      <option value="Other" <%= filters?.country === 'Other' ? 'selected' : '' %> >Other</option>
                    <% } %>
                  </select>
                </div>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="ri-map-pin-line text-gray-400"></i>
                  </div>
                  <select name="city" id="mobileFilterCity" class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-button focus:ring-2 focus:ring-primary focus:border-primary text-gray-900 bg-white text-sm appearance-none" disabled>
                    <option value="">Select City</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Apply Filters Button -->
            <button type="submit" class="w-full py-2.5 px-4 bg-primary text-white hover:bg-pink-600 transition-all duration-300 !rounded-button ripple material-shadow">
              <i class="ri-search-line mr-2"></i>Apply Filters
            </button>

            <!-- Clear Filters Button -->
            <button type="button" id="mobileClearFilters" class="w-full py-2.5 px-4 border-2 border-gray-300 text-gray-500 hover:border-primary hover:text-primary transition-all duration-300 !rounded-button">
              <i class="ri-refresh-line mr-2"></i>Clear All Filters
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

