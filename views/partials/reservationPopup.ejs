<!--
  Shared Reservation Popup Partial
  Accepts: popupId (unique DOM id), headingText (the main CTA text), triggerType ("exit" or "scroll")
  Handles: modal display, form submission, localStorage frequency capping
-->
<div id="<%= popupId %>" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden" style="backdrop-filter: blur(4px);">
  <div class="bg-white rounded-2xl p-8 max-w-md mx-4 material-shadow-elevated relative w-full" style="animation: modalEnter 0.3s ease-out forwards;">
    <!-- Close Button -->
    <button class="popup-close absolute top-4 right-4 p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-full transition-colors" aria-label="Close">
      <i class="ri-close-line text-xl"></i>
    </button>

    <!-- Heading -->
    <div class="text-center mb-6">
      <div class="w-14 h-14 mx-auto mb-4 bg-pink-100 rounded-full flex items-center justify-center">
        <i class="ri-calendar-check-line text-2xl text-primary"></i>
      </div>
      <h3 class="text-xl font-bold text-gray-800 mb-2 font-['Playfair_Display']"><%= headingText %></h3>
      <p class="text-sm text-gray-500">100% confidential • No commitment • Free</p>
    </div>

    <!-- Form -->
    <form class="reservation-popup-form space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Your Name *</label>
        <input type="text" name="name" required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
          placeholder="Enter your full name">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Phone or Email *</label>
        <input type="text" name="phoneOrEmail" required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
          placeholder="Your phone number or email">
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Preferred Date *</label>
          <input type="date" name="date" required
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
            min="<%= new Date().toISOString().split('T')[0] %>">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Preferred Time *</label>
          <input type="time" name="time" required
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-colors">
        </div>
      </div>

      <button type="submit"
        class="w-full gradient-bg text-white font-semibold py-3 rounded-xl hover:opacity-90 transition-opacity duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
        <i class="ri-calendar-check-line mr-2"></i>Book My Free Call
      </button>
    </form>

    <!-- Success Message (hidden by default) -->
    <div class="popup-success hidden text-center py-6">
      <div class="w-16 h-16 mx-auto mb-4 bg-green-100 rounded-full flex items-center justify-center">
        <i class="ri-check-line text-3xl text-green-600"></i>
      </div>
      <h3 class="text-xl font-bold text-gray-800 mb-2 font-['Playfair_Display']">Thank You!</h3>
      <p class="text-gray-600">We'll contact you soon to confirm your free consultation.</p>
    </div>
  </div>
</div>

<script>
(function () {
  const POPUP_ID = '<%= popupId %>';
  const TRIGGER_TYPE = '<%= triggerType %>';
  const SOURCE = TRIGGER_TYPE === 'exit' ? 'popup_exit' : 'popup_scroll';

  // ── Frequency Capping Check ──────────────────────────────────────────
  function canShowPopup() {
    // If user already submitted a form, never show again
    if (localStorage.getItem('reservation_popup_submitted') === 'true') {
      return false;
    }
    // If user closed the popup, check 14-day cooldown
    const closedAt = localStorage.getItem('reservation_popup_closed');
    if (closedAt) {
      const elapsed = Date.now() - parseInt(closedAt, 10);
      if (elapsed < 14 * 24 * 60 * 60 * 1000) {
        return false;
      }
    }
    return true;
  }

  // ── Popup Actions ────────────────────────────────────────────────────
  function showPopup() {
    if (!canShowPopup()) return;
    const popup = document.getElementById(POPUP_ID);
    if (popup) popup.classList.remove('hidden');
  }

  function hidePopup() {
    const popup = document.getElementById(POPUP_ID);
    if (popup) popup.classList.add('hidden');
    // Set 14-day cooldown when user manually closes
    localStorage.setItem('reservation_popup_closed', Date.now().toString());
  }

  function markSubmitted() {
    localStorage.setItem('reservation_popup_submitted', 'true');
  }

  // ── Trigger Logic ────────────────────────────────────────────────────
  let hasTriggered = false;

  if (TRIGGER_TYPE === 'exit') {
    // Exit intent: detect mouse leaving viewport toward top (approaching tab close)
    document.addEventListener('mouseout', function (e) {
      if (hasTriggered) return;
      if (e.clientY <= 20 && e.relatedTarget === null) {
        hasTriggered = true;
        showPopup();
      }
    });
  }

  if (TRIGGER_TYPE === 'scroll') {
    // Scroll depth: show at 20% scroll
    window.addEventListener('scroll', function () {
      if (hasTriggered) return;
      const docHeight = document.documentElement.scrollHeight;
      const winHeight = window.innerHeight;
      const scrollY = window.scrollY;
      const scrollPercent = (scrollY / (docHeight - winHeight)) * 100;

      if (scrollPercent >= 20) {
        hasTriggered = true;
        showPopup();
      }
    }, { passive: true });
  }

  // ── DOM Ready: wire up close, overlay click, form submit ────────────
  document.addEventListener('DOMContentLoaded', function () {
    const popup = document.getElementById(POPUP_ID);
    if (!popup) return;

    // Close button
    const closeBtn = popup.querySelector('.popup-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        hidePopup();
      });
    }

    // Click overlay to close
    popup.addEventListener('click', function (e) {
      if (e.target === popup) {
        hidePopup();
      }
    });

    // Form submission
    const form = popup.querySelector('.reservation-popup-form');
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        data.source = SOURCE;
        data.pageUrl = window.location.href;

        // Disable button
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="ri-loader-4-line animate-spin mr-2"></i>Booking...';
        submitBtn.disabled = true;

        try {
          const response = await fetch('/api/reservations/book', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (result.success) {
            markSubmitted();
            // Show success message, hide form
            form.classList.add('hidden');
            const successMsg = popup.querySelector('.popup-success');
            if (successMsg) successMsg.classList.remove('hidden');
            // Auto-close after 2.5 seconds
            setTimeout(function () {
              hidePopup();
            }, 2500);
          } else {
            alert(result.error || 'Something went wrong. Please try again.');
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
          }
        } catch (err) {
          console.error('Reservation popup submit error:', err);
          alert('Network error. Please try again.');
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
        }
      });
    }
  });
})();
</script>
