  Shared Reservation Popup Partial
  Accepts: popupId (unique DOM id), headingText (the main CTA text), triggerType ("exit" or "scroll")
  Handles: modal display, form submission, localStorage frequency capping
-->
<div id="<%= popupId %>" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden" style="backdrop-filter: blur(4px);">
  <div class="bg-white rounded-2xl p-8 max-w-md mx-4 material-shadow-elevated relative w-full" style="animation: modalEnter 0.3s ease-out forwards;">
