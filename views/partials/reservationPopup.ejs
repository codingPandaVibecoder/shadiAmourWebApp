<script>
(function () {
  const POPUP_ID = '<%= popupId %>';
  const TRIGGER_TYPE = '<%= triggerType %>';
  const SOURCE = TRIGGER_TYPE === 'exit' ? 'popup_exit' : 'popup_scroll';

  // ── Frequency Capping Check ──────────────────────────────────────────
  function canShowPopup() {
    // If user already submitted a form, never show again
    if (localStorage.getItem('reservation_popup_submitted') === 'true') {
      return false;
    }
    // If user closed the popup, check 14-day cooldown
    const closedAt = localStorage.getItem('reservation_popup_closed');
    if (closedAt) {
      const elapsed = Date.now() - parseInt(closedAt, 10);
      if (elapsed < 14 * 24 * 60 * 60 * 1000) {
        return false;
      }
    }
    return true;
  }

  // ── Popup Actions ────────────────────────────────────────────────────
  function showPopup() {
    if (!canShowPopup()) return;
    const popup = document.getElementById(POPUP_ID);
    if (popup) popup.classList.remove('hidden');
  }

  function hidePopup() {
    const popup = document.getElementById(POPUP_ID);
    if (popup) popup.classList.add('hidden');
    // Set 14-day cooldown when user manually closes
    localStorage.setItem('reservation_popup_closed', Date.now().toString());
  }

  function markSubmitted() {
    localStorage.setItem('reservation_popup_submitted', 'true');
  }

  // ── Trigger Logic ────────────────────────────────────────────────────
  let hasTriggered = false;

  if (TRIGGER_TYPE === 'exit') {
    // Exit intent: detect mouse leaving viewport toward top (approaching tab close)
    document.addEventListener('mouseout', function (e) {
      if (hasTriggered) return;
      if (e.clientY <= 20 && e.relatedTarget === null) {
        hasTriggered = true;
        showPopup();
      }
    });
  }

  if (TRIGGER_TYPE === 'scroll') {
    // Scroll depth: show at 20% scroll
    window.addEventListener('scroll', function () {
      if (hasTriggered) return;
      const docHeight = document.documentElement.scrollHeight;
      const winHeight = window.innerHeight;
      const scrollY = window.scrollY;
      const scrollPercent = (scrollY / (docHeight - winHeight)) * 100;

      if (scrollPercent >= 20) {
        hasTriggered = true;
        showPopup();
      }
    }, { passive: true });
  }

  // ── DOM Ready: wire up close, overlay click, form submit ────────────
  document.addEventListener('DOMContentLoaded', function () {
    const popup = document.getElementById(POPUP_ID);
    if (!popup) return;

    // Close button
    const closeBtn = popup.querySelector('.popup-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        hidePopup();
      });
    }

    // Click overlay to close
    popup.addEventListener('click', function (e) {
      if (e.target === popup) {
        hidePopup();
      }
    });

    // Form submission
    const form = popup.querySelector('.reservation-popup-form');
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        // Validate phone before submission
        const phoneInput = form.querySelector('.reservation-phone');
        if (phoneInput && !window.validateReservationPhone(phoneInput)) {
          alert('Please enter a valid phone number.');
          return;
        }

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        data.source = SOURCE;
        data.pageUrl = window.location.href;

        // Disable button
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="ri-loader-4-line animate-spin mr-2"></i>Booking...';
        submitBtn.disabled = true;

        try {
          const response = await fetch('/api/reservations/book', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (result.success) {
            markSubmitted();
            // Show success message, hide form
            form.classList.add('hidden');
            const successMsg = popup.querySelector('.popup-success');
            if (successMsg) successMsg.classList.remove('hidden');
            // Auto-close after 2.5 seconds
            setTimeout(function () {
              hidePopup();
            }, 2500);
          } else {
            alert(result.error || 'Something went wrong. Please try again.');
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
          }
        } catch (err) {
          console.error('Reservation popup submit error:', err);
          alert('Network error. Please try again.');
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
        }
      });
    }
  });
})();
</script>
