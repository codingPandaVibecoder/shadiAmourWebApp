<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Meet Our Team — D'amour Muslim</title>

  <!-- SEO Meta Tags -->
  <meta name="description" content="Meet the dedicated team behind D'amour Muslim — the UK's trusted halal Muslim matrimonial platform. Learn about the people committed to helping Muslims find their spouse the halal way." />
  <meta name="keywords" content="damour muslim team, muslim matrimony team uk, damour muslim founders, halal matchmaking team, muslim marriage platform team" />
  <link rel="canonical" href="https://damourmuslim.com/our-team" />

  <!-- Open Graph -->
  <meta property="og:title" content="Meet Our Team — D'amour Muslim" />
  <meta property="og:description" content="Meet the dedicated people behind D'amour Muslim, the UK's trusted halal Muslim matrimonial platform." />
  <meta property="og:url" content="https://damourmuslim.com/our-team" />
  <meta property="og:type" content="website" />

  <!-- Structured Data: Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "D'amour Muslim",
    "url": "https://damourmuslim.com",
    "description": "The UK's trusted halal Muslim matrimonial platform"
  }
  </script>

  <!-- Favicon -->
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#E91E63">

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/output.css" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" />

  <style>
    .gradient-bg { background: linear-gradient(135deg, #E91E63 0%, #673AB7 100%); }
    .material-shadow { box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .material-shadow-hover { box-shadow: 0 4px 16px rgba(0,0,0,0.15); }
    .team-card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .team-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 32px rgba(233,30,99,0.12);
    }
    .team-card .photo-wrapper {
      position: relative;
      overflow: hidden;
    }
    .team-card .photo-wrapper::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 60%, rgba(233,30,99,0.1) 100%);
    }
    .value-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.375rem 0.875rem;
      border-radius: 9999px;
      font-size: 0.8125rem;
      font-weight: 500;
    }
  </style>
</head>

<body class="bg-gray-50 font-['Roboto']">
  <%- include('./partials/header') %>

  <!-- Hero Banner -->
  <section class="gradient-bg text-white pt-28 pb-20 relative overflow-hidden mt-6">
    <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
      <div class="inline-flex items-center gap-2 bg-white bg-opacity-20 rounded-full px-4 py-2 text-sm font-medium mb-6">
        <i class="ri-team-line"></i>
        <span>The People Behind the Platform</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-5 font-['Playfair_Display'] leading-tight">
        Meet Our Team
      </h1>
      <p class="text-lg md:text-xl text-pink-100 mb-6 max-w-2xl mx-auto leading-relaxed">
        D'amour Muslim is built and operated by a passionate team of Muslims committed to helping the British Muslim community find their spouse through a trusted, halal-first platform.
      </p>
    </div>
    <!-- Decorative blobs -->
    <div class="absolute -top-20 -right-20 w-64 h-64 bg-white bg-opacity-5 rounded-full"></div>
    <div class="absolute -bottom-10 -left-10 w-48 h-48 bg-white bg-opacity-5 rounded-full"></div>
  </section>

  <main class="py-14 min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <!-- Mission Statement -->
      <div class="bg-white rounded-2xl material-shadow p-8 mb-12">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-4 font-['Playfair_Display']">Who We Are</h2>
            <p class="text-gray-700 leading-relaxed mb-4">
              D'amour Muslim was founded with a single clear purpose: to provide UK Muslims with a trustworthy, halal, and family-friendly platform to find a marriage partner — without compromising their values or privacy.
            </p>
            <p class="text-gray-700 leading-relaxed mb-4">
              Our team is made up of British Muslims from diverse backgrounds — technology professionals, community advocates, and relationship advisors — united by a shared belief that the Muslim marriage search deserves better than mainstream dating apps.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Every profile verified, every feature built, and every community campaign run is the result of this team's ongoing dedication to serving the Muslim community with integrity.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-pink-50 rounded-xl p-5 border border-pink-100 text-center">
              <i class="ri-shield-check-line text-3xl text-primary mb-2 block"></i>
              <p class="font-semibold text-gray-800 text-sm">Manual Verification</p>
              <p class="text-gray-500 text-xs mt-1">Every profile reviewed by our team</p>
            </div>
            <div class="bg-purple-50 rounded-xl p-5 border border-purple-100 text-center">
              <i class="ri-heart-line text-3xl text-purple-600 mb-2 block"></i>
              <p class="font-semibold text-gray-800 text-sm">Halal-First Design</p>
              <p class="text-gray-500 text-xs mt-1">Islamic values in every feature</p>
            </div>
            <div class="bg-green-50 rounded-xl p-5 border border-green-100 text-center">
              <i class="ri-customer-service-2-line text-3xl text-green-600 mb-2 block"></i>
              <p class="font-semibold text-gray-800 text-sm">Community Support</p>
              <p class="text-gray-500 text-xs mt-1">Dedicated member assistance</p>
            </div>
            <div class="bg-blue-50 rounded-xl p-5 border border-blue-100 text-center">
              <i class="ri-lock-line text-3xl text-blue-600 mb-2 block"></i>
              <p class="font-semibold text-gray-800 text-sm">Privacy First</p>
              <p class="text-gray-500 text-xs mt-1">UK GDPR compliant platform</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Team Grid -->
<% if (members && members.length > 0) { %>

<!-- Team Grid -->
<% if (members && members.length > 0) { %>

<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-900 font-['Playfair_Display'] mb-2">
    The Team
  </h2>

  <p class="text-gray-500">
    The people working every day to make D'amour Muslim the UK's most trusted Muslim matrimonial platform.
  </p>
</div>

<!-- ONE CARD PER ROW -->
<div class="space-y-8 mb-14">

  <% members.forEach(member => { %>

  <div class="team-card bg-white rounded-3xl overflow-hidden material-shadow">

    <div class="grid lg:grid-cols-2 gap-0 items-stretch">

      <!-- IMAGE SECTION -->
      <div class="photo-wrapper bg-gradient-to-br from-pink-50 to-purple-50 overflow-hidden">

        <% if (member.photo && member.photo.url) { %>

        <img
          src="<%= member.photo.url %>"
          alt="<%= member.name %> — <%= member.designation %> at D'amour Muslim"
          class="w-full h-full object-cover aspect-[16/9]"
          loading="lazy"
        />

        <% } else { %>

        <!-- FALLBACK -->
        <div class="aspect-[16/9] flex items-center justify-center">
          <div class="w-24 h-24 rounded-full bg-primary bg-opacity-10 flex items-center justify-center">
            <i class="ri-user-line text-4xl text-primary opacity-60"></i>
          </div>
        </div>

        <% } %>

      </div>

      <!-- CONTENT SECTION -->
      <div class="p-8 lg:p-10 flex flex-col justify-center">

        <div class="mb-4">

          <h3 class="text-2xl font-bold text-gray-900 mb-2 font-['Playfair_Display']">
            <%= member.name %>
          </h3>

          <p class="text-base font-semibold text-primary">
            <%= member.designation %>
          </p>

        </div>

        <% if (member.bio) { %>

        <p class="text-gray-600 leading-relaxed text-base">
          <%= member.bio %>
        </p>

        <% } else { %>

        <p class="text-gray-500 leading-relaxed text-base">
          Dedicated member of the D'amour Muslim team helping Muslims find marriage through a halal-first platform.
        </p>

        <% } %>

      </div>

    </div>

  </div>

  <% }) %>

</div>

<% } else { %>

<!-- Empty State -->
<div class="bg-white rounded-2xl material-shadow p-16 text-center mb-14">

  <i class="ri-team-line text-6xl text-gray-200 mb-4 block"></i>

  <h3 class="text-xl font-semibold text-gray-700 mb-2">
    Team Profiles Coming Soon
  </h3>

  <p class="text-gray-500 max-w-md mx-auto">
    We're updating our team page. In the meantime, you can reach us at
    <a
      href="mailto:contact@damourmuslim.com"
      class="text-primary hover:underline"
    >
      contact@damourmuslim.com
    </a>
  </p>

</div>

<% } %>

<% } %>

      <!-- Our Values Section -->
      <div class="bg-white rounded-2xl material-shadow p-8 mb-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 font-['Playfair_Display']">Our Values &amp; Commitments</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4 items-start">
            <div class="w-10 h-10 bg-pink-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
              <i class="ri-book-read-line text-primary"></i>
            </div>
            <div>
              <h3 class="font-semibold text-gray-800 mb-1">Islamic Integrity</h3>
              <p class="text-gray-600 text-sm leading-relaxed">We make decisions guided by Islamic principles. From the features we build to the profiles we approve, every choice reflects our commitment to a halal environment.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
              <i class="ri-user-heart-line text-purple-600"></i>
            </div>
            <div>
              <h3 class="font-semibold text-gray-800 mb-1">Member-First Approach</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Every feature and policy is designed around what is best for our members' marriage search — not what maximises our engagement metrics.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
              <i class="ri-eye-off-line text-green-600"></i>
            </div>
            <div>
              <h3 class="font-semibold text-gray-800 mb-1">Privacy by Design</h3>
              <p class="text-gray-600 text-sm leading-relaxed">We treat your personal data with the same respect your Islamic values demand. No selling of data, no unnecessary exposure, and full UK GDPR compliance.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
              <i class="ri-community-line text-blue-600"></i>
            </div>
            <div>
              <h3 class="font-semibold text-gray-800 mb-1">Community Accountability</h3>
              <p class="text-gray-600 text-sm leading-relaxed">We are members of the community we serve. We listen to feedback, act on reports, and maintain transparency about how the platform works.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-10 h-10 bg-yellow-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
              <i class="ri-family-line text-yellow-600"></i>
            </div>
            <div>
              <h3 class="font-semibold text-gray-800 mb-1">Family Inclusion</h3>
              <p class="text-gray-600 text-sm leading-relaxed">We support families at every step of the marriage search — because in Islam, marriage is a family matter, not just an individual one.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
              <i class="ri-verified-badge-line text-red-600"></i>
            </div>
            <div>
              <h3 class="font-semibold text-gray-800 mb-1">Zero Tolerance for Fraud</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Every profile is manually reviewed before going live. Fake accounts, inappropriate content, and suspicious behaviour are removed immediately.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact CTA -->
      <div class="bg-white rounded-2xl material-shadow p-8 mb-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-4 font-['Playfair_Display']">Get in Touch with Our Team</h2>
        <p class="text-gray-700 mb-6 leading-relaxed">
          Whether you have a question about your profile, want to report an issue, or have a partnership enquiry — our team is available to help. We aim to respond to all enquiries within 24 hours.
        </p>
        <div class="grid sm:grid-cols-3 gap-4">
          <a href="mailto:contact@damourmuslim.com" class="flex items-center gap-3 p-4 bg-pink-50 rounded-xl border border-pink-100 hover:bg-pink-100 transition-all duration-200">
            <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
              <i class="ri-mail-line text-white"></i>
            </div>
            <div>
              <p class="text-xs text-gray-500 mb-0.5">General Enquiries</p>
              <p class="text-sm font-medium text-gray-800">contact@damourmuslim.com</p>
            </div>
          </a>
          <a href="mailto:support@damourmuslim.com" class="flex items-center gap-3 p-4 bg-purple-50 rounded-xl border border-purple-100 hover:bg-purple-100 transition-all duration-200">
            <div class="w-10 h-10 bg-purple-600 rounded-full flex items-center justify-center flex-shrink-0">
              <i class="ri-customer-service-2-line text-white"></i>
            </div>
            <div>
              <p class="text-xs text-gray-500 mb-0.5">Member Support</p>
              <p class="text-sm font-medium text-gray-800">support@damourmuslim.com</p>
            </div>
          </a>
          <a href="mailto:issues@damourmuslim.com" class="flex items-center gap-3 p-4 bg-green-50 rounded-xl border border-green-100 hover:bg-green-100 transition-all duration-200">
            <div class="w-10 h-10 bg-green-600 rounded-full flex items-center justify-center flex-shrink-0">
              <i class="ri-bug-line text-white"></i>
            </div>
            <div>
              <p class="text-xs text-gray-500 mb-0.5">Bug Reports</p>
              <p class="text-sm font-medium text-gray-800">issues@damourmuslim.com</p>
            </div>
          </a>
        </div>
      </div>

    </div>
  </main>

  <%- include('./partials/footer') %>
  <%- include('./partials/analytics') %>
</body>
</html>
