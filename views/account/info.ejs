              <div class="grid grid-cols-1 md:grid-cols-2 gap-element-gap mb-6">
                <div class="input-floating">
                  <select id="ConsiderARevert" name="ConsiderARevert">
                    <option value="true" <%= (accountInfo.ConsiderARevert === true) ? 'selected' : '' %>>Yes</option>
                    <option value="false" <%= (accountInfo.ConsiderARevert === false) ? 'selected' : '' %>>No</option>
                    <option value="N/A" <%= (accountInfo.ConsiderARevert === undefined || accountInfo.ConsiderARevert === null) ? 'selected' : '' %>>N/A</option>
                  </select>
                  <label for="ConsiderARevert">Consider a Revert</label>
                </div>
                <div class="input-floating">
                  <input type="text" id="acceptSomeoneInOtherCountry" name="acceptSomeoneInOtherCountry" placeholder=" " value="<%= accountInfo.acceptSomeoneInOtherCountry || '' %>">
                  <label for="acceptSomeoneInOtherCountry">Accept someone in other country</label>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-element-gap mb-6">
                <div class="input-floating">
                  <input type="text" id="willingToSharePhotosUponRequest" name="willingToSharePhotosUponRequest" placeholder=" " value="<%= accountInfo.willingToSharePhotosUponRequest || '' %>">
                  <label for="willingToSharePhotosUponRequest">Willing to Share Photos Upon Request</label>
                </div>
                <div class="input-floating">
                  <input type="text" id="willingToMeetUpOutside" name="willingToMeetUpOutside" placeholder=" " value="<%= accountInfo.willingToMeetUpOutside || '' %>">
                  <label for="willingToMeetUpOutside">Willing to Meet Up Outside</label>
                </div>
              </div>

              <div class="mb-6 input-floating">
                <select id="willingToConsiderANonUkCitizen" name="willingToConsiderANonUkCitizen">
                  <option value="">Select</option>
                  <option value="Yes" <%= (accountInfo.willingToConsiderANonUkCitizen === 'Yes') ? 'selected' : '' %>>Yes</option>
                  <option value="No" <%= (accountInfo.willingToConsiderANonUkCitizen === 'No') ? 'selected' : '' %>>No</option>
                  <option value="Depends on location" <%= (accountInfo.willingToConsiderANonUkCitizen === 'Depends on location') ? 'selected' : '' %>>Depends on location</option>
                  <option value="N/A" <%= (!accountInfo.willingToConsiderANonUkCitizen || accountInfo.willingToConsiderANonUkCitizen === 'N/A') ? 'selected' : '' %>>N/A</option>
                </select>
                <label for="willingToConsiderANonUkCitizen">Willing to Consider a Non-UK Citizen</label>
              </div>

              <div class="mb-6 input-floating">
                <textarea id="lookingForASpouseThatIs" name="lookingForASpouseThatIs" rows="3" placeholder=" " minlength="5"><%= accountInfo.lookingForASpouseThatIs || '' %></textarea>
                <label for="lookingForASpouseThatIs">Looking for a Spouse That Is</label>
              </div>

              <div class="mb-6 input-floating">
                <input type="text" id="qualitiesYouNeedInYourPartner" name="qualitiesYouNeedInYourPartner" placeholder=" " value="<%= accountInfo.qualitiesYouNeedInYourPartner || '' %>">
                <label for="qualitiesYouNeedInYourPartner">Qualities You Need in Your Partner (comma separated)</label>
              </div>
            </div>

            <!-- Form Actions -->
            <div class="mt-10 pt-6 border-t border-surface-variant flex justify-end gap-4">
              <button type="button" id="cancelBtn" class="px-6 py-3 rounded-lg border border-outline font-label-md text-label-md text-on-surface-variant hover:bg-surface-variant transition-colors">
                Cancel
              </button>
              <button type="submit" id="saveProfileBtn" data-track="true" data-event-name="save_profile_changes" data-category="engagement" data-label="Save Profile Changes" class="px-8 py-3 rounded-lg bg-primary-container text-white font-label-md text-label-md hover:bg-primary transition-colors shadow-sm flex items-center gap-2">
                Save Changes
                <span class="material-symbols-outlined text-[18px]">save</span>
              </button>
            </div>
          </form>

          <!-- Your Requests Section -->
          <div class="request-section" id="request-sent">
            <h2 class="text-headline-md font-headline-md text-primary mb-6 border-b border-surface-variant pb-2">Your Sent Requests</h2>
            <div id="sentRequestsContainer">
              <div class="text-center py-8">
                <i class="ri-loader-4-line animate-spin text-3xl text-outline mb-4"></i>
                <p class="text-on-surface-variant">Loading your requests...</p>
              </div>
            </div>
          </div>

          <!-- Received Requests Section -->
          <div class="request-section" id="request-received">
            <h2 class="text-headline-md font-headline-md text-primary mb-6 border-b border-surface-variant pb-2">Received Requests</h2>
            <div id="receivedRequestsContainer">
              <div class="text-center py-8">
                <i class="ri-loader-4-line animate-spin text-3xl text-outline mb-4"></i>
                <p class="text-on-surface-variant">Loading received requests...</p>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // ---------- Sidebar navigation / tab switching ----------
      const navItems = document.querySelectorAll('.nav-item');
      navItems.forEach(btn => {
        btn.addEventListener('click', function() {
          const tab = this.getAttribute('data-tab');
          const section = this.getAttribute('data-section');
          document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
          document.querySelectorAll('.request-section').forEach(c => c.classList.remove('active'));
          navItems.forEach(i => i.classList.remove('active'));
          this.classList.add('active');
          if (tab && document.getElementById(tab)) {
            document.getElementById(tab).classList.add('active');
          }
          if (section && document.getElementById(section)) {
            document.getElementById(section).classList.add('active');
            if (section === 'request-sent') loadSentRequests();
            if (section === 'request-received') loadReceivedRequests();
          }
          if (window.innerWidth < 768) {
            document.getElementById('profileForm').scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      // ---------- Education / Children builders ----------
      let educationCount = 0;
      let childrenCount = 0;

      function educationItemHtml(index) {
        return `
          <div class="education-item border border-outline-variant rounded-lg p-4 mb-3">
            <div class="flex justify-between items-center mb-3">
              <h4 class="font-medium text-on-surface">Education ${index}</h4>
              <button type="button" class="remove-education text-error hover:text-error/80">
                <i class="ri-delete-bin-line"></i>
              </button>
            </div>
            <div class="grid md:grid-cols-3 gap-4">
              <div class="input-floating">
                <input type="text" name="education[${index}][title]" placeholder=" ">
                <label>Degree/Title</label>
              </div>
              <div class="input-floating">
                <input type="text" name="education[${index}][institute]" placeholder=" ">
                <label>Institute/University</label>
              </div>
              <div class="input-floating">
                <input type="text" name="education[${index}][year]" placeholder=" ">
                <label>Year</label>
              </div>
            </div>
          </div>`;
      }

      function childItemHtml(index) {
        return `
          <div class="child-item border border-outline-variant rounded-lg p-4 mb-3">
            <div class="flex justify-between items-center mb-3">
              <h4 class="font-medium text-on-surface">Child ${index}</h4>
              <button type="button" class="remove-child text-error hover:text-error/80">
                <i class="ri-delete-bin-line"></i>
              </button>
            </div>
            <div class="grid md:grid-cols-3 gap-4">
              <div class="input-floating">
                <input type="text" name="children[${index}][name]" placeholder=" ">
                <label>Child's Name</label>
              </div>
              <div class="input-floating">
                <input type="number" name="children[${index}][age]" placeholder=" ">
                <label>Age</label>
              </div>
              <div class="input-floating">
                <input type="text" name="children[${index}][livingLocation]" placeholder=" ">
                <label>Living Location</label>
              </div>
            </div>
          </div>`;
      }

      const addEducationBtn = document.getElementById('addEducation');
      if (addEducationBtn) {
        addEducationBtn.addEventListener('click', function() {
          educationCount++;
          document.getElementById('educationContainer').insertAdjacentHTML('beforeend', educationItemHtml(educationCount));
        });
      }
      const addChildBtn = document.getElementById('addChild');
      if (addChildBtn) {
        addChildBtn.addEventListener('click', function() {
          childrenCount++;
          document.getElementById('childrenContainer').insertAdjacentHTML('beforeend', childItemHtml(childrenCount));
        });
      }

      document.addEventListener('click', function(e) {
        if (e.target.closest('.remove-education')) {
          e.target.closest('.education-item').remove();
        }
        if (e.target.closest('.remove-child')) {
          e.target.closest('.child-item').remove();
        }
      });

      // ---------- Load existing user data ----------
      function loadUserData() {
        <% if (accountInfo) { %>
        const userDataRaw = <%- JSON.stringify(accountInfo) %>;
        setTimeout(() => {
          Object.keys(userDataRaw).forEach(key => {
            const field = document.querySelector(`[name="${key}"]`);
            if (field && userDataRaw[key] !== undefined && userDataRaw[key] !== null) {
              if (field.tagName === 'SELECT') {
                const rawVal = typeof userDataRaw[key] === 'boolean' ? userDataRaw[key].toString() : userDataRaw[key];
                const optionValues = Array.from(field.options).map(o => o.value);
                if (rawVal && rawVal !== '' && !optionValues.includes(String(rawVal))) {
                  const ciMatch = optionValues.find(o => o.toLowerCase() === String(rawVal).toLowerCase());
                  field.value = ciMatch !== undefined ? ciMatch : '';
                } else {
                  field.value = rawVal || '';
                }
              } else if (field.type === 'checkbox') {
                field.checked = userDataRaw[key] === true || userDataRaw[key] === 'true';
              } else {
                field.value = Array.isArray(userDataRaw[key]) ? userDataRaw[key].join(', ') : userDataRaw[key];
              }
            }
          });
          if (emailField && userDataRaw.email) {
            emailField.value = userDataRaw.email;
            currentEmail = userDataRaw.email;
          }
          // Populate education
          if (userDataRaw.education && Array.isArray(userDataRaw.education)) {
            userDataRaw.education.forEach((edu, index) => {
              educationCount++;
              document.getElementById('educationContainer').insertAdjacentHTML('beforeend', educationItemHtml(educationCount));
              setTimeout(() => {
                const titleField = document.querySelector(`[name="education[${educationCount}][title]"]`);
                const instituteField = document.querySelector(`[name="education[${educationCount}][institute]"]`);
                const yearField = document.querySelector(`[name="education[${educationCount}][year]"]`);
                if (titleField && edu.title) titleField.value = edu.title;
                if (instituteField && edu.institute) instituteField.value = edu.institute;
                if (yearField && edu.year) yearField.value = edu.year;
              }, 50);
            });
          }
          // Populate children
          if (userDataRaw.children && Array.isArray(userDataRaw.children)) {
            userDataRaw.children.forEach((child, index) => {
              childrenCount++;
              document.getElementById('childrenContainer').insertAdjacentHTML('beforeend', childItemHtml(childrenCount));
              setTimeout(() => {
                const nameField = document.querySelector(`[name="children[${childrenCount}][name]"]`);
                const ageField = document.querySelector(`[name="children[${childrenCount}][age]"]`);
                const locationField = document.querySelector(`[name="children[${childrenCount}][livingLocation]"]`);
                if (nameField && child.name) nameField.value = child.name;
                if (ageField && child.age) ageField.value = child.age;
                if (locationField && child.livingLocation) locationField.value = child.livingLocation;
              }, 50);
            });
          }
          // Preferred age / height ranges (From/To)
          if (userDataRaw.preferredAgeRange) {
            const ageParts = String(userDataRaw.preferredAgeRange).match(/\d+/g);
            if (ageParts && ageParts.length >= 2) {
              const fromEl = document.getElementById('preferredAgeFrom');
              const toEl = document.getElementById('preferredAgeTo');
              if (fromEl) fromEl.value = ageParts[0];
              if (toEl) toEl.value = ageParts[1];
            }
          }
          if (userDataRaw.preferredHeightRange) {
            const hParts = String(userDataRaw.preferredHeightRange).match(/\d+/g);
            if (hParts && hParts.length >= 2) {
              const fromEl = document.getElementById('preferredHeightFrom');
              const toEl = document.getElementById('preferredHeightTo');
              if (fromEl) fromEl.value = hParts[0];
              if (toEl) toEl.value = hParts[1];
            }
          }
          // Work: stored value not a standard option → show as "Other" + prefill
          const workSelLoad = document.getElementById('work');
          if (workSelLoad && userDataRaw.work) {
            const stdOpts = Array.from(workSelLoad.options).map(o => o.value);
            if (!stdOpts.includes(String(userDataRaw.work))) {
              workSelLoad.value = 'Other';
              const ows = document.getElementById('otherWorkSection');
              if (ows) ows.classList.remove('hidden');
              const owInput = document.getElementById('otherWork');
              if (owInput && !owInput.value) owInput.value = String(userDataRaw.work);
            }
          }
          // Refresh character counters for pre-populated min-length fields
          ['aboutMe', 'islamIsImportantToMeInfo', 'describeNature', 'lookingForASpouseThatIs'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.dispatchEvent(new Event('input'));
          });
        }, 200);
        <% } %>
      }

      // ---------- Save handler (JSON only) ----------
      const saveButton = document.getElementById('saveProfileBtn');
      if (saveButton) {
        saveButton.addEventListener('click', function(e) {
          e.preventDefault();
          const submitBtn = this;
          const originalText = submitBtn.innerHTML;

          // Validate minimum character fields
          const minCharFields = {
            'aboutMe': 20,
            'islamIsImportantToMeInfo': 30,
            'describeNature': 5,
            'lookingForASpouseThatIs': 5
          };
          for (const [field, minLength] of Object.entries(minCharFields)) {
            const fieldElement = document.getElementById(field);
            if (fieldElement && fieldElement.value && fieldElement.value.trim().length < minLength) {
              showNotification('Validation Error', `${field.replace(/([A-Z])/g, ' $1').toLowerCase()} must be at least ${minLength} characters long`, 'error');
              return;
            }
          }

          // Work "Other" requires a specified occupation
          const workSel = document.getElementById('work');
          const otherWorkEl = document.getElementById('otherWork');
          if (workSel && workSel.value === 'Other' && (!otherWorkEl || !otherWorkEl.value || otherWorkEl.value.trim().length < 2)) {
            showNotification('Validation Error', 'Please specify your occupation (min 2 characters)', 'error');
            return;
          }

          submitBtn.disabled = true;
          submitBtn.innerHTML = '<i class="ri-loader-4-line animate-spin mr-2"></i>Saving Changes...';

          const form = document.getElementById('profileForm');
          const fd = new FormData(form);
          const userData = {};
          userData.userId = '<%= accountInfo._id %>';

          for (let [key, value] of fd.entries()) {
            if (value.trim() === '') continue;
            if (key.includes('[') && key.includes(']')) {
              const match = key.match(/(\w+)\[(\d+)\]\[(\w+)\]/);
              if (match) {
                const [, field, index, subfield] = match;
                if (!userData[field]) userData[field] = [];
                if (!userData[field][index]) userData[field][index] = {};
                userData[field][index][subfield] = value.trim();
              }
            } else if (['hobbies', 'languagesSpoken', 'QualitiesThatYouCanBringToYourMarriage', 'qualitiesYouNeedInYourPartner'].includes(key)) {
              userData[key] = value.trim();
            } else {
              userData[key] = value.trim();
            }
          }

          // Clean up arrays
          ['education', 'children'].forEach(k => {
            if (userData[k]) {
              userData[k] = userData[k].filter(item => item && Object.values(item).some(val => val && val.trim()));
              if (userData[k].length === 0) delete userData[k];
            }
          });

          // Combine preferred age/height From/To into range strings
          if (userData.preferredAgeFrom && userData.preferredAgeTo) {
            userData.preferredAgeRange = userData.preferredAgeFrom + '-' + userData.preferredAgeTo;
          }
          delete userData.preferredAgeFrom;
          delete userData.preferredAgeTo;
          if (userData.preferredHeightFrom && userData.preferredHeightTo) {
            userData.preferredHeightRange = userData.preferredHeightFrom + '-' + userData.preferredHeightTo;
          }
          delete userData.preferredHeightFrom;
          delete userData.preferredHeightTo;
          // Merge work "Other" into work
          if (userData.work === 'Other' && userData.otherWork) {
            userData.work = userData.otherWork;
          }
          delete userData.otherWork;

          fetch('/admin/user/update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(userData)
            })
            .then(response => response.json())
            .then(data => {
              if (data.success) {
                showNotification('Profile Updated', 'Your profile has been updated successfully!', 'success');
              } else {
                console.error('Backend error:', data.error);
                showNotification('Error', data.error || 'Failed to update profile', 'error');
              }
            })
            .catch(error => {
              console.error('Request error:', error);
              showNotification('Error', 'Failed to update profile. Please try again.', 'error');
            })
            .finally(() => {
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalText;
            });
        });
      }

      // Cancel button — reload to reset from database
      const cancelBtn = document.getElementById('cancelBtn');
      if (cancelBtn) {
        cancelBtn.addEventListener('click', function() {
          location.reload();
        });
      }

      // ---------- Requests ----------
      function loadSentRequests() {
        const container = document.getElementById('sentRequestsContainer');
        container.innerHTML = '<div class="text-center py-8"><i class="ri-loader-4-line animate-spin text-3xl text-outline mb-4"></i><p class="text-on-surface-variant">Loading your requests...</p></div>';
        fetch('/api/requests/sent')
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              displaySentRequests(data.requests);
            } else {
              container.innerHTML = '<div class="text-center py-8"><p class="text-error">Failed to load requests</p></div>';
            }
          })
          .catch(error => {
            console.error('Error loading sent requests:', error);
            container.innerHTML = '<div class="text-center py-8"><p class="text-error">Failed to load requests</p></div>';
          });
      }

      function loadReceivedRequests() {
        const container = document.getElementById('receivedRequestsContainer');
        container.innerHTML = '<div class="text-center py-8"><i class="ri-loader-4-line animate-spin text-3xl text-outline mb-4"></i><p class="text-on-surface-variant">Loading received requests...</p></div>';
        fetch('/api/requests/received')
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              displayReceivedRequests(data.requests);
            } else {
              container.innerHTML = '<div class="text-center py-8"><p class="text-error">Failed to load requests</p></div>';
            }
          })
          .catch(error => {
            console.error('Error loading received requests:', error);
            container.innerHTML = '<div class="text-center py-8"><p class="text-error">Failed to load requests</p></div>';
          });
      }

      function statusPill(status) {
        const map = {
          pending: 'bg-secondary-container/20 text-secondary',
          accepted: 'bg-halal-green/10 text-halal-green',
          revoked: 'bg-neutral-gray text-on-surface-variant',
          rejected: 'bg-error-container text-on-error-container'
        };
        return map[status] || 'bg-neutral-gray text-on-surface-variant';
      }

      function displaySentRequests(requests) {
        const container = document.getElementById('sentRequestsContainer');
        if (requests.length === 0) {
          container.innerHTML = `
            <div class="mb-4 flex items-center justify-between">
              <h3 class="text-lg font-semibold text-on-surface">Your Sent Requests</h3>
              <span class="px-3 py-1 rounded-full text-sm font-medium bg-neutral-gray text-on-surface-variant">0 / 5</span>
            </div>
            <div class="text-center py-8">
              <i class="ri-inbox-line text-3xl text-outline mb-4"></i>
              <p class="text-on-surface-variant">No requests sent yet</p>
            </div>`;
          return;
        }
        const headerHtml = `
          <div class="mb-4 flex items-center justify-between">
            <h3 class="text-lg font-semibold text-on-surface">Your Sent Requests</h3>
            <span class="px-3 py-1 rounded-full text-sm font-medium ${requests.length >= 5 ? 'bg-error-container text-on-error-container' : 'bg-halal-green/10 text-halal-green'}">
              ${requests.length} / 5
            </span>
          </div>`;
        const requestsHtml = requests.map(request => `
          <div class="border border-outline-variant rounded-lg p-6 mb-4">
            <div class="flex items-center justify-between flex-wrap gap-3">
              <div class="flex items-center">
                <div class="w-12 h-12 bg-neutral-gray rounded-full flex items-center justify-center mr-4">
                  <i class="ri-user-line text-on-surface-variant"></i>
                </div>
                <div>
                  <h4 class="font-medium text-on-surface">${request.to.username}</h4>
                  <p class="text-sm text-on-surface-variant">${request.to.city || ''}, ${request.to.state || ''}</p>
                  <p class="text-xs text-outline">Sent: ${new Date(request.createdAt).toLocaleDateString()}</p>
                </div>
              </div>
              <div class="flex items-center">
                <span class="px-3 py-1 rounded-full text-xs font-medium ${statusPill(request.status)}">${request.status}</span>
                ${request.status === 'pending' ? `
                  <button onclick="cancelRequest('${request._id}')" class="ml-3 px-3 py-1 bg-error text-white text-xs rounded hover:bg-error/90">
                    Cancel
                  </button>
                ` : request.status === 'accepted' ? `
                  <button onclick="revokeAccess('${request._id}')" class="ml-3 px-3 py-1 bg-secondary text-white text-xs rounded hover:opacity-90">
                    Revoke Access
                  </button>
                ` : ''}
              </div>
            </div>
          </div>
        `).join('');
        container.innerHTML = headerHtml + requestsHtml;
      }

      function displayReceivedRequests(requests) {
        const container = document.getElementById('receivedRequestsContainer');
        if (requests.length === 0) {
          container.innerHTML = '<div class="text-center py-8"><i class="ri-inbox-line text-3xl text-outline mb-4"></i><p class="text-on-surface-variant">No requests received yet</p></div>';
          return;
        }
        const requestsHtml = requests.map(request => `
          <div class="border border-outline-variant rounded-lg p-6 mb-4">
            <div class="flex items-center justify-between flex-wrap gap-3">
              <div class="flex items-center">
                <div class="w-12 h-12 bg-neutral-gray rounded-full flex items-center justify-center mr-4">
                  <i class="ri-user-line text-on-surface-variant"></i>
                </div>
                <div>
                  <h4 class="font-medium text-on-surface">${request.from.username}</h4>
                  <p class="text-sm text-on-surface-variant">${request.from.city || ''}</p>
                  <p class="text-xs text-outline">Received: ${new Date(request.createdAt).toLocaleDateString()}</p>
                </div>
              </div>
              <div class="flex items-center">
                <span class="px-3 py-1 rounded-full text-xs font-medium ${statusPill(request.status)}">${request.status}</span>
                ${request.status === 'pending' ? `
                  <button onclick="respondToRequest('${request._id}', 'accept')" class="ml-3 px-3 py-1 bg-halal-green text-white text-xs rounded hover:bg-halal-green/90">
                    Accept
                  </button>
                  <button onclick="respondToRequest('${request._id}', 'reject')" class="ml-2 px-3 py-1 bg-error text-white text-xs rounded hover:bg-error/90">
                    Reject
                  </button>
                ` : request.status === 'accepted' ? `
                  <button onclick="revokeAccess('${request._id}')" class="ml-3 px-3 py-1 bg-secondary text-white text-xs rounded hover:opacity-90">
                    Revoke Access
                  </button>
                ` : ''}
              </div>
            </div>
          </div>
        `).join('');
        container.innerHTML = requestsHtml;
      }

      // Global functions for request actions
      window.cancelRequest = function(requestId) {
        if (confirm('Are you sure you want to cancel this request?')) {
          fetch(`/api/requests/${requestId}/cancel`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
              if (data.success) {
                showNotification('Request Cancelled', 'Request has been cancelled successfully', 'success');
                loadSentRequests();
              } else {
                showNotification('Error', data.error || 'Failed to cancel request', 'error');
              }
            })
            .catch(error => {
              console.error('Error cancelling request:', error);
              showNotification('Error', 'Failed to cancel request', 'error');
            });
        }
      };

      window.respondToRequest = function(requestId, action) {
        const actionText = action === 'accept' ? 'accept' : 'reject';
        if (confirm(`Are you sure you want to ${actionText} this request?`)) {
          fetch(`/api/requests/${requestId}/respond`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action })
            })
            .then(response => response.json())
            .then(data => {
              if (data.success) {
                showNotification('Request Updated', `Request has been ${action} successfully`, 'success');
                loadReceivedRequests();
              } else {
                showNotification('Error', data.error || 'Failed to update request', 'error');
              }
            })
            .catch(error => {
              console.error('Error responding to request:', error);
              showNotification('Error', 'Failed to update request', 'error');
            });
        }
      };

      window.revokeAccess = function(requestId) {
        if (confirm('Are you sure you want to revoke access? You will both become strangers and lose access to each other\'s full profiles.')) {
          fetch(`/api/requests/${requestId}/revoke`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
              if (data.success) {
                showNotification('Access Revoked', data.message, 'success');
                loadSentRequests();
                loadReceivedRequests();
              } else {
                showNotification('Error', data.error || 'Failed to revoke access', 'error');
              }
            })
            .catch(error => {
              console.error('Error revoking access:', error);
              showNotification('Error', 'Failed to revoke access', 'error');
            });
        }
      };

      // ---------- Notifications ----------
      function showNotification(title, message, type = 'info') {
        const notification = document.createElement('div');
        const styles = {
          success: 'bg-halal-green text-white',
          info: 'bg-primary text-white',
          warning: 'bg-secondary-container text-on-secondary-container',
          error: 'bg-error text-white'
        };
        const icons = {
          success: 'ri-checkbox-circle-line',
          info: 'ri-information-line',
          warning: 'ri-alert-line',
          error: 'ri-error-warning-line'
        };
        notification.className = `fixed bottom-4 right-4 ${styles[type] || styles.info} rounded-xl p-4 shadow-[0px_8px_24px_rgba(0,0,0,0.2)] flex items-center gap-3 z-50 transition-all duration-300`;
        notification.innerHTML = `
          <i class="${icons[type] || icons.info} text-xl"></i>
          <div>
            <p class="font-medium">${title}</p>
            <p class="text-sm opacity-90">${message}</p>
          </div>`;
        document.body.appendChild(notification);
        setTimeout(() => {
          notification.style.transform = 'translateY(100%)';
          notification.style.opacity = '0';
          setTimeout(() => notification.remove(), 300);
        }, 3000);
      }

      // ---------- Email verification ----------
      const emailField = document.getElementById('email');
      const verifyEmailBtn = document.getElementById('verify-email-btn');
      const addEmailBtn = document.getElementById('add-email-btn');
      const verificationSection = document.getElementById('verification-section');
      const verificationCodeInput = document.getElementById('verification-code');
      const verifyCodeBtn = document.getElementById('verify-code-btn');
      const emailStatus = document.getElementById('email-status');
      const emailVerificationStatus = document.getElementById('email-verification-status');

      let isEmailVerified = <%= accountInfo.isEmailVerified ? 'true' : 'false' %>;
      let currentEmail = '<%= accountInfo.email || "" %>';

      // Show add email button when valid email is entered (if no email exists)
      if (emailField && addEmailBtn) {
        emailField.addEventListener('input', function() {
          const email = this.value.trim();
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!currentEmail && emailRegex.test(email)) {
            addEmailBtn.classList.remove('hidden');
          } else {
            addEmailBtn.classList.add('hidden');
            verificationSection.classList.add('hidden');
            hideEmailStatus();
          }
        });
      }

      if (verifyEmailBtn) {
        verifyEmailBtn.addEventListener('click', async function() {
          const email = emailField.value.trim() || currentEmail;
          const username = '<%= accountInfo.username %>';
          if (!email) {
            showEmailStatus('No email address found', 'error');
            return;
          }
          await sendVerificationCode(email, username, this);
        });
      }

      if (addEmailBtn) {
        addEmailBtn.addEventListener('click', async function() {
          const email = emailField.value.trim();
          const username = '<%= accountInfo.username %>';
          if (!email) {
            showEmailStatus('Please enter an email address first', 'error');
            return;
          }
          await sendVerificationCode(email, username, this);
        });
      }

      async function sendVerificationCode(email, username, button) {
        button.disabled = true;
        const originalText = button.innerHTML;
        button.innerHTML = '<i class="ri-loader-4-line animate-spin mr-2"></i>Sending...';
        try {
          const response = await fetch('/api/send-verification-code', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, username })
          });
          const data = await response.json();
          if (data.success) {
            verificationSection.classList.remove('hidden');
            showEmailStatus(data.message, 'success');
            verificationCodeInput.focus();
            emailVerificationStatus.innerHTML = `
              <div class="flex items-center gap-2 text-secondary text-sm">
                <i class="ri-time-line"></i>
                <span>Verification code sent - check your email</span>
              </div>`;
          } else {
            showEmailStatus(data.error, 'error');
          }
        } catch (error) {
          showEmailStatus('Failed to send verification code', 'error');
        } finally {
          button.disabled = false;
          button.innerHTML = originalText;
        }
      }

      if (verifyCodeBtn) {
        verifyCodeBtn.addEventListener('click', async function() {
          const code = verificationCodeInput.value.trim();
          if (code.length !== 4) {
            showEmailStatus('Please enter a 4-digit code', 'error');
            return;
          }
          this.disabled = true;
          this.innerHTML = '<i class="ri-loader-4-line animate-spin mr-2"></i>Verifying...';
          try {
            const response = await fetch('/api/verify-email-code', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ code })
            });
            const data = await response.json();
            if (data.success) {
              isEmailVerified = true;
              hideEmailStatus();
              showEmailStatus(data.message + ' ✓', 'success');
              verificationSection.classList.add('hidden');
              const emailToVerify = emailField.value.trim();
              fetch('/api/save-email-verification', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ email: emailToVerify })
                })
                .then(response => response.json())
                .then(saveData => {
                  if (saveData.success) {
                    console.log('Email verification saved to database successfully');
                    showNotification('Email Verified', 'Your email has been verified and saved!', 'success');
                  } else {
                    console.error('Failed to save email verification:', saveData.error);
                    showNotification('Warning', 'Email verified but failed to save. Please refresh and try again.', 'warning');
                  }
                })
                .catch(error => {
                  console.error('Error saving email verification:', error);
                  showNotification('Warning', 'Email verified but failed to save. Please refresh and try again.', 'warning');
                });
              emailVerificationStatus.innerHTML = `
                <div class="flex items-center gap-2 text-halal-green text-sm">
                  <i class="ri-checkbox-circle-fill"></i>
                  <span>Email verified</span>
                </div>`;
              if (verifyEmailBtn) verifyEmailBtn.classList.add('hidden');
              if (addEmailBtn) addEmailBtn.classList.add('hidden');
              currentEmail = emailToVerify;
              showNotification('Email Verified', 'Your email has been verified successfully! Remember to save your changes.', 'success');
            } else {
              showEmailStatus(data.error, 'error');
              verificationCodeInput.value = '';
            }
          } catch (error) {
            showEmailStatus('Failed to verify code', 'error');
          } finally {
            this.disabled = false;
            this.innerHTML = 'Verify';
          }
        });
      }

      function showEmailStatus(message, type) {
        emailStatus.textContent = message;
        emailStatus.className = `text-sm mt-2 ${type === 'error' ? 'text-error' : 'text-halal-green'}`;
        emailStatus.classList.remove('hidden');
      }

      function hideEmailStatus() {
        emailStatus.classList.add('hidden');
      }

      // ---------- Character counters ----------
      const fieldsWithMinLength = {
        'aboutMe': 20,
        'islamIsImportantToMeInfo': 30,
        'describeNature': 5,
        'lookingForASpouseThatIs': 5
      };
      Object.entries(fieldsWithMinLength).forEach(([fieldId, minLength]) => {
        const textarea = document.getElementById(fieldId);
        if (textarea) {
          const counter = document.createElement('div');
          counter.className = 'char-counter text-sm mt-1';
          counter.style.color = '#6b7280';
          textarea.parentNode.appendChild(counter);
          function updateCounter() {
            const length = textarea.value.trim().length;
            if (length < minLength) {
              counter.style.color = '#ef4444';
              counter.innerHTML = `<i class="ri-error-warning-line mr-1"></i>${length}/${minLength} characters minimum`;
            } else {
              counter.style.color = '#10b981';
              counter.innerHTML = `<i class="ri-check-line mr-1"></i>${length}/${minLength} characters minimum`;
            }
          }
          textarea.addEventListener('input', updateCounter);
          updateCounter();
        }
      });

      // ---------- Country → City (dynamic select) ----------
      const cityData = {
        'United Kingdom': ['London','Birmingham','Manchester','Glasgow','Liverpool','Leeds','Sheffield','Edinburgh','Bristol','Leicester','Bradford','Cardiff','Nottingham','Newcastle','Other'],
        'Pakistan': ['Karachi','Lahore','Islamabad','Rawalpindi','Faisalabad','Multan','Peshawar','Quetta','Sialkot','Gujranwala','Hyderabad','Abbottabad','Bahawalpur','Sargodha','Sukkur','Larkana','Mardan','Gujrat','Sahiwal','Mirpur','Sheikhupura','Jhang','Rahim Yar Khan','Kasur','Muzaffargarh','Nawabshah','Chiniot','Kamoke','Hafizabad','Sadiqabad','Burewala','Jacobabad','Shikarpur','Kohat','Jhelum','Khanewal','Gojra','Mandi Bahauddin','Daska','Dera Ghazi Khan','Dera Ismail Khan','Mingora','Bannu','Khuzdar','Other'],
        'Bangladesh': ['Dhaka','Chittagong','Sylhet','Khulna','Rajshahi','Comilla','Gazipur','Narayanganj','Other'],
        'India': ['Mumbai','Delhi','Bangalore','Hyderabad','Chennai','Kolkata','Ahmedabad','Pune','Lucknow','Jaipur','Other'],
        'United States': ['New York','Los Angeles','Chicago','Houston','Dallas','San Francisco','Miami','Atlanta','Washington DC','Boston','Other'],
        'Canada': ['Toronto','Vancouver','Montreal','Calgary','Ottawa','Edmonton','Mississauga','Brampton','Other'],
        'United Arab Emirates': ['Dubai','Abu Dhabi','Sharjah','Ajman','Al Ain','Ras Al Khaimah','Other'],
        'Saudi Arabia': ['Riyadh','Jeddah','Mecca','Medina','Dammam','Dhahran','Other'],
        'Australia': ['Sydney','Melbourne','Brisbane','Perth','Adelaide','Gold Coast','Other'],
        'Germany': ['Berlin','Munich','Frankfurt','Hamburg','Cologne','Dusseldorf','Other'],
        'France': ['Paris','Lyon','Marseille','Toulouse','Nice','Strasbourg','Other'],
        'Malaysia': ['Kuala Lumpur','George Town','Johor Bahru','Ipoh','Shah Alam','Other'],
        'Singapore': ['Singapore','Other'],
        'Other': ['Other']
      };

      const countryNameMap = { uk:'United Kingdom', pakistan:'Pakistan', bangladesh:'Bangladesh', india:'India', usa:'United States', canada:'Canada', uae:'United Arab Emirates', saudi_arabia:'Saudi Arabia', australia:'Australia', germany:'Germany', france:'France', malaysia:'Malaysia', singapore:'Singapore', other:'Other' };
      function normalizeCountry(v) {
        if (!v) return '';
        return countryNameMap[String(v).toLowerCase()] || v;
      }
      function populateCityOptions(countryValue) {
        const citySelect = document.getElementById('city');
        if (!citySelect) return;
        const currentCity = '<%= accountInfo.city || "" %>';
        const countryName = normalizeCountry(countryValue);
        citySelect.innerHTML = '<option value="">Select city</option>';
        if (countryName && cityData[countryName]) {
          cityData[countryName].forEach(c => {
            const opt = document.createElement('option');
            opt.value = c;
            opt.textContent = c;
            citySelect.appendChild(opt);
          });
          if (currentCity) {
            const ciOpt = Array.from(citySelect.options).find(o => o.value.toLowerCase() === String(currentCity).toLowerCase());
            if (ciOpt) {
              citySelect.value = ciOpt.value;
            } else {
              const opt = document.createElement('option');
              opt.value = currentCity;
              opt.textContent = currentCity;
              citySelect.appendChild(opt);
              citySelect.value = currentCity;
            }
          }
          citySelect.disabled = false;
        } else {
          citySelect.disabled = true;
        }
      }

      const countryField = document.getElementById('country');
      if (countryField) {
        populateCityOptions(countryField.value);
        countryField.addEventListener('change', function() {
          populateCityOptions(this.value);
        });
      }

      // ---------- Work "Other" toggle ----------
      const workField = document.getElementById('work');
      const otherWorkWrap = document.getElementById('otherWorkSection');
      if (workField && otherWorkWrap) {
        workField.addEventListener('change', function() {
          if (this.value === 'Other') {
            otherWorkWrap.classList.remove('hidden');
          } else {
            otherWorkWrap.classList.add('hidden');
            const ow = document.getElementById('otherWork');
            if (ow) ow.value = '';
          }
        });
      }

      // ---------- Profile completion dialog ----------
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('from') === 'onboarding') {
        window.history.replaceState({}, document.title, window.location.pathname);
        showCompletionDialog();
      }

      async function showCompletionDialog() {
        try {
          const response = await fetch('/api/profile-completion');
          const data = await response.json();
          if (data.success) {
            const { percentage } = data.completion;
            document.getElementById('completionPercentage').textContent = percentage;
            document.getElementById('completionDialog').classList.remove('hidden');
          }
        } catch (error) {
          console.error('Error fetching profile completion:', error);
        }
      }

      document.getElementById('addMoreInfoBtn').addEventListener('click', function() {
        document.getElementById('completionDialog').classList.add('hidden');
        showNotification('Great Choice!', 'You can now add more information to improve your profile.', 'success');
      });

      document.getElementById('browseProfilesBtn').addEventListener('click', function() {
        window.location.href = '/profiles';
      });

      document.getElementById('completionDialog').addEventListener('click', function(e) {
        if (e.target === this) {
          this.classList.add('hidden');
        }
      });

      // ---------- Initialize ----------
      loadUserData();
    });
  </script>
</body>

</html>
