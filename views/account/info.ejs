<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#00113a">
  <title>shadiamour - Edit User</title>
  <link rel="stylesheet" href="/css/output.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css">
  <style>
    :where([class^="ri-"])::before {
      content: "\f3c2";
    }

    /* Floating label inputs */
    .input-floating {
      position: relative;
    }
    .input-floating>input,
    .input-floating>select,
    .input-floating>textarea {
      width: 100%;
      padding: 1.5rem 1rem 0.5rem;
      border: 1px solid #c5c6d2;
      border-radius: 0.5rem;
      background-color: transparent;
      color: #1a1b20;
      font-size: 16px;
      transition: border-color 0.2s;
    }
    .input-floating>input:focus,
    .input-floating>select:focus,
    .input-floating>textarea:focus {
      outline: none;
      border-color: #002366;
      box-shadow: 0 0 0 1px #002366;
    }
    .input-floating>label {
      position: absolute;
      top: 1rem;
      left: 1rem;
      color: #757682;
      transition: all 0.2s;
      pointer-events: none;
      font-size: 16px;
      line-height: 1.5;
    }
    .input-floating>input:focus+label,
    .input-floating>input:not(:placeholder-shown)+label,
    .input-floating>textarea:focus+label,
    .input-floating>textarea:not(:placeholder-shown)+label {
      top: 0.25rem;
      font-size: 12px;
      color: #002366;
    }
    .input-floating>input:disabled,
    .input-floating>select:disabled,
    .input-floating>textarea:disabled {
      background-color: #f4f3f9;
      color: #757682;
      border-color: #e3e2e8;
    }
    .input-floating>input:disabled+label,
    .input-floating>select:disabled+label,
    .input-floating>textarea:disabled+label {
      color: #757682;
    }

    /* Select fields: static label ABOVE the field (never overlaps the chosen value) */
    .input-floating>select {
      padding: 0.75rem 1rem;
      background-color: #ffffff;
    }
    .input-floating>select+label {
      position: static;
      display: block;
      margin-bottom: 0.5rem;
      top: auto;
      left: auto;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: #002366;
      pointer-events: auto;
      line-height: 1.25;
    }
    .input-floating>select:disabled {
      background-color: #f4f3f9;
      color: #757682;
      border-color: #e3e2e8;
      cursor: not-allowed;
    }

    /* Tabs */
    .tab-content {
      display: none;
    }
    .tab-content.active {
      display: block;
    }
    .request-section {
      display: none;
    }
    .request-section.active {
      display: block;
    }

    /* Sidebar nav */
    .nav-item.active {
      background-color: #002366;
      color: #ffffff;
      font-weight: 700;
    }
    .nav-item.active span.material-symbols-outlined {
      color: #ffffff;
    }

    .char-counter {
      font-size: 0.875rem;
      margin-top: 0.25rem;
      display: flex;
      align-items: center;
    }
    .char-counter i {
      font-size: 0.75rem;
    }
  </style>
  <%- include('../partials/clarity') %>
  <%- include('../partials/thirdparty') %>
  <%- include('../partials/analytics') %>
</head>

<body class="bg-background text-on-background font-body-md antialiased flex flex-col min-h-screen">
  <!-- Profile Completion Dialog -->
  <div id="completionDialog" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
    <div class="bg-surface-white rounded-2xl p-8 max-w-md mx-4 shadow-[0px_8px_24px_rgba(0,0,0,0.2)]">
      <div class="text-center mb-6">
        <div class="w-16 h-16 bg-primary-container rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-on-primary">manage_accounts</span>
        </div>
        <h3 class="text-headline-md font-headline-md text-on-surface mb-2">Profile Setup</h3>
        <p class="text-body-md font-body-md text-on-surface-variant">Your profile is <span id="completionPercentage" class="font-semibold text-primary">12</span>% complete </p>
      </div>

      <div class="bg-secondary-container/15 border border-secondary-container/40 rounded-lg p-4 mb-6">
        <div class="flex items-start gap-3">
          <span class="material-symbols-outlined text-secondary">lightbulb</span>
          <div>
            <p class="text-secondary font-medium mb-1">Boost Your Success Rate!</p>
            <p class="text-secondary text-sm">Adding more information about yourself can increase your success rate of getting proposals by up to 4 times.</p>
          </div>
        </div>
      </div>

      <div class="space-y-3">
        <button id="addMoreInfoBtn" data-track="true" data-event-name="profile_completion_add_info" data-category="engagement" data-label="Add More Profile Information" class="w-full px-6 py-3 bg-primary-container text-on-primary rounded-lg hover:bg-trust-blue transition-all duration-300 flex items-center justify-center gap-2">
          <span class="material-symbols-outlined">add_circle</span>
          Yes, add more information!
        </button>
        <button id="browseProfilesBtn" data-track="true" data-event-name="profile_completion_browse" data-category="engagement" data-label="Browse Profiles from Completion Dialog" class="w-full px-6 py-3 border-2 border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary transition-all duration-300 rounded-lg flex items-center justify-center gap-2">
          <span class="material-symbols-outlined">group</span>
          No, browse profiles
        </button>
      </div>
    </div>
  </div>
  <%- include('../partials/header') %>

  <main class="flex-grow pt-[92px] pb-section-padding">
    <div class="max-w-container-max mx-auto px-margin-x py-section-padding">
      <div class="mb-10 text-center md:text-left">
        <h1 class="text-headline-lg font-headline-lg text-primary mb-2">My Account</h1>
        <p class="text-body-lg font-body-lg text-on-surface-variant">Manage your profile and requests</p>
      </div>

      <div class="flex flex-col md:flex-row gap-gutter">
        <!-- Sidebar Navigation -->
        <aside class="md:w-1/4 w-full flex flex-col gap-2">
          <button type="button" class="nav-item active flex items-center gap-3 p-4 rounded-lg text-left transition-colors font-body-md text-body-md text-on-surface-variant hover:bg-primary-fixed hover:text-primary" data-tab="basic-info">
            <span class="material-symbols-outlined">person</span>
            Basic Info
          </button>
          <button type="button" class="nav-item flex items-center gap-3 p-4 rounded-lg text-left transition-colors font-body-md text-body-md text-on-surface-variant hover:bg-primary-fixed hover:text-primary" data-tab="contact-location">
            <span class="material-symbols-outlined">location_on</span>
            Contact &amp; Location
          </button>
          <button type="button" class="nav-item flex items-center gap-3 p-4 rounded-lg text-left transition-colors font-body-md text-body-md text-on-surface-variant hover:bg-primary-fixed hover:text-primary" data-tab="physical">
            <span class="material-symbols-outlined">accessibility_new</span>
            Physical Appearance
          </button>
          <button type="button" class="nav-item flex items-center gap-3 p-4 rounded-lg text-left transition-colors font-body-md text-body-md text-on-surface-variant hover:bg-primary-fixed hover:text-primary" data-tab="religion">
            <span class="material-symbols-outlined">mosque</span>
            Religion &amp; Faith
          </button>
          <button type="button" class="nav-item flex items-center gap-3 p-4 rounded-lg text-left transition-colors font-body-md text-body-md text-on-surface-variant hover:bg-primary-fixed hover:text-primary" data-tab="family">
            <span class="material-symbols-outlined">family_restroom</span>
            Family &amp; Background
          </button>
          <button type="button" class="nav-item flex items-center gap-3 p-4 rounded-lg text-left transition-colors font-body-md text-body-md text-on-surface-variant hover:bg-primary-fixed hover:text-primary" data-tab="preferences">
            <span class="material-symbols-outlined">favorite</span>
            Partner Preferences
          </button>

          <div class="border-t border-outline-variant my-2"></div>

          <button type="button" class="nav-item flex items-center gap-3 p-4 rounded-lg text-left transition-colors font-body-md text-body-md text-on-surface-variant hover:bg-primary-fixed hover:text-primary" data-section="request-sent">
            <span class="material-symbols-outlined">send</span>
            Your Requests
          </button>
          <button type="button" class="nav-item flex items-center gap-3 p-4 rounded-lg text-left transition-colors font-body-md text-body-md text-on-surface-variant hover:bg-primary-fixed hover:text-primary" data-section="request-received">
            <span class="material-symbols-outlined">inbox</span>
            Received Requests
          </button>
        </aside>

        <!-- Form Content Area -->
        <section class="md:w-3/4 w-full bg-surface-white rounded-xl border border-outline-variant p-6 md:p-10" style="box-shadow: 0px 4px 20px rgba(0, 35, 102, 0.05);">
          <form id="profileForm">
            <!-- Basic Info Tab -->
            <div class="tab-content active" id="basic-info">
              <h2 class="text-headline-md font-headline-md text-primary mb-6 border-b border-surface-variant pb-2">Basic Information</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-element-gap mb-6">
                <div class="input-floating">
                  <input type="text" id="username" name="username" disabled placeholder=" " value="<%= accountInfo.username %>">
                  <label for="username">Username</label>
                </div>
                <div class="input-floating">
                  <input type="email" id="email" name="email" disabled readonly placeholder=" " class="cursor-not-allowed">
                  <label for="email">Email Address</label>
                </div>
              </div>

              <!-- Email verification -->
              <div class="mb-6">
                <div id="email-verification-status" class="mt-2">
                  <% if (accountInfo.email) { %>
                  <% if (accountInfo.isEmailVerified) { %>
                  <div class="flex items-center gap-2 text-halal-green text-sm">
                    <i class="ri-checkbox-circle-fill"></i>
                    <span>Email verified</span>
                  </div>
                  <% } else { %>
                  <div class="flex items-center gap-2 text-error text-sm mb-2">
                    <i class="ri-error-warning-fill"></i>
                    <span>Email unverified</span>
                  </div>
                  <button type="button" id="verify-email-btn" class="px-4 py-2 bg-secondary-container text-on-secondary-container text-sm rounded-lg hover:opacity-90 transition-all duration-300 font-medium">
                    Verify Email
                  </button>
                  <% } %>
                  <% } else { %>
                  <button type="button" id="add-email-btn" class="hidden px-4 py-2 bg-secondary-container text-on-secondary-container text-sm rounded-lg hover:opacity-90 transition-all duration-300 font-medium">
                    Send Email Verification Code
                  </button>
                  <% } %>
                </div>

                <div id="verification-section" class="hidden mt-3">
                  <label for="verification-code" class="block text-sm font-medium text-on-surface-variant mb-2">
                    Enter 4-digit verification code
                  </label>
                  <div class="flex gap-2">
                    <input type="text" id="verification-code" maxlength="4" pattern="[0-9]{4}" class="flex-1 px-3 py-2 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary-container focus:border-primary-container text-on-surface text-center text-lg font-mono" placeholder="0000">
                    <button type="button" id="verify-code-btn" class="px-4 py-2 bg-halal-green text-white text-sm rounded-lg hover:bg-halal-green/90 transition-all duration-300">
                      Verify
                    </button>
                  </div>
                  <p class="text-xs text-on-surface-variant mt-1">Check your email for the verification code</p>
                </div>

                <div id="email-status" class="hidden text-sm mt-2"></div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-element-gap mb-6">
                <div class="input-floating">
                  <input type="text" id="name" name="name" placeholder=" ">
                  <label for="name">Full Name</label>
                </div>
                <div class="input-floating">
                  <select id="age" name="age">
                    <option value="">Select age</option>
                    <% const ageVal = accountInfo.age != null ? String(accountInfo.age) : ''; %>
                    <% if (ageVal && (Number(ageVal) < 18 || Number(ageVal) > 70)) { %>
                    <option value="<%= ageVal %>" selected><%= ageVal %> years old</option>
                    <% } %>
                    <% for(let i = 18; i <= 70; i++) { %>
                    <option value="<%= i %>" <%= (ageVal === String(i)) ? 'selected' : '' %>><%= i %> years old</option>
                    <% } %>
                  </select>
                  <label for="age">Age</label>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-element-gap mb-6">
                <div class="input-floating">
                  <select id="gender" name="gender" disabled>
                    <option value="">Select Gender</option>
                    <option value="male" <%= (accountInfo.gender === 'male') ? 'selected' : '' %>>Male</option>
                    <option value="female" <%= (accountInfo.gender === 'female') ? 'selected' : '' %>>Female</option>
                  </select>
                  <label for="gender">Gender</label>
                </div>
                <div class="input-floating">
                  <select id="maritalStatus" name="maritalStatus">
                    <% 
                      const standardStatuses = ['nevermarried', 'divorced', 'widowed', 'annulled'];
                      const currentStatus = accountInfo.maritalStatus || '';
                      const isNonStandard = currentStatus && !standardStatuses.includes(currentStatus.toLowerCase());
                    %>
                    <% if (isNonStandard) { %>
                    <option value="<%= currentStatus %>" selected><%= currentStatus.charAt(0).toUpperCase() + currentStatus.slice(1) %></option>
                    <% } %>
                    <option value="nevermarried" <%= (currentStatus.toLowerCase() === 'nevermarried') ? 'selected' : '' %>>Never Married</option>
                    <option value="divorced" <%= (currentStatus.toLowerCase() === 'divorced') ? 'selected' : '' %>>Divorced</option>
                    <option value="widowed" <%= (currentStatus.toLowerCase() === 'widowed') ? 'selected' : '' %>>Widowed</option>
                    <option value="annulled" <%= (currentStatus.toLowerCase() === 'annulled') ? 'selected' : '' %>>Annulled</option>
                  </select>
                  <label for="maritalStatus">Marital Status</label>
                </div>
              </div>

              <div class="mb-6 input-floating">
                <select id="work" name="work">
                  <option value="">Select occupation</option>
                  <% const workOptions = ['Doctor / Medical Professional','Engineer','Teacher / Lecturer','IT Professional / Software','Accountant / Finance','Lawyer / Legal','Business Owner','Civil Servant / Government','Healthcare Worker','Student','Self Employed','Homemaker','Currently Unemployed','Other']; %>
                  <% const currentWork = (accountInfo.work || '').trim(); %>
                  <% const isStandardWork = currentWork ? workOptions.includes(currentWork) : false; %>
                  <% workOptions.forEach(opt => { %>
                  <option value="<%= opt %>" <%= (currentWork === opt || (opt === 'Other' && currentWork && !isStandardWork)) ? 'selected' : '' %>><%= opt %></option>
                  <% }) %>
                </select>
                <label for="work">Profession/Work</label>
              </div>
              <div id="otherWorkSection" class="mb-6 input-floating <%= (currentWork && !isStandardWork) ? '' : 'hidden' %>">
                <input type="text" id="otherWork" name="otherWork" placeholder=" " minlength="2" value="<%= (currentWork && !isStandardWork) ? currentWork : '' %>">
                <label for="otherWork">Specify occupation</label>
              </div>

              <div class="mb-6 input-floating">
                <textarea id="aboutMe" name="aboutMe" rows="4" placeholder=" " minlength="20"></textarea>
                <label for="aboutMe">About Me</label>
              </div>

              <div class="mb-6 input-floating">
                <input type="text" id="hobbies" name="hobbies" placeholder=" ">
                <label for="hobbies">Hobbies (comma separated)</label>
              </div>
            </div>

            <!-- Contact & Location Tab -->
            <div class="tab-content" id="contact-location">
              <h2 class="text-headline-md font-headline-md text-primary mb-6 border-b border-surface-variant pb-2">Contact &amp; Location Information</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-element-gap mb-6">
                <div class="input-floating">
                  <input type="tel" id="contact" name="contact" placeholder=" ">
                  <label for="contact">Contact Number</label>
                </div>
                <div class="input-floating">
                  <input type="text" id="waliMyContactDetails" name="waliMyContactDetails" placeholder=" ">
                  <label for="waliMyContactDetails">Wali Contact Details</label>
                </div>
              </div>

              <div class="mb-6 input-floating">
                <input type="text" id="adress" name="adress" placeholder=" ">
                <label for="adress">Address</label>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-element-gap mb-6">
                <div class="input-floating">
                  <select id="city" name="city">
                    <option value="">Select city</option>
                    <% if (accountInfo.city) { %>
                    <option value="<%= accountInfo.city %>" selected><%= accountInfo.city %></option>
                    <% } %>
                  </select>
                  <label for="city">City</label>
                </div>
                <div class="input-floating">
                  <input type="text" id="state" name="state" placeholder=" ">
                  <label for="state">State/Province</label>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-element-gap mb-6">
                <div class="input-floating">
                  <select id="country" name="country" <%= accountInfo.country ? 'disabled' : '' %>>
                    <option value="">Select country</option>
                    <% const countryList = ['United Kingdom','Pakistan','Bangladesh','India','United States','Canada','United Arab Emirates','Saudi Arabia','Australia','Germany','France','Malaysia','Singapore','Other']; %>
                    <% const countryNameMap = { uk:'United Kingdom', pakistan:'Pakistan', bangladesh:'Bangladesh', india:'India', usa:'United States', canada:'Canada', uae:'United Arab Emirates', saudi_arabia:'Saudi Arabia', australia:'Australia', germany:'Germany', france:'France', malaysia:'Malaysia', singapore:'Singapore', other:'Other' }; %>
                    <% const currentCountry = accountInfo.country ? (countryNameMap[String(accountInfo.country).toLowerCase()] || accountInfo.country) : ''; %>
                    <% countryList.forEach(c => { %>
                    <option value="<%= c %>" <%= (currentCountry === c) ? 'selected' : '' %>><%= c %></option>
                    <% }) %>
                    <% if (currentCountry && !countryList.includes(currentCountry)) { %>
                    <option value="<%= currentCountry %>" selected><%= currentCountry %></option>
                    <% } %>
                  </select>
                  <label for="country">Country</label>
                </div>
                <div class="input-floating">
                  <input type="text" id="nationality" name="nationality" placeholder=" ">
                  <label for="nationality">Nationality</label>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-element-gap mb-6">
                <div class="input-floating">
                  <input type="text" id="birthPlace" name="birthPlace" placeholder=" ">
                  <label for="birthPlace">Birth Place</label>
                </div>
                <div class="input-floating">
                  <input type="text" id="willingToRelocate" name="willingToRelocate" placeholder=" " value="<%= accountInfo.willingToRelocate || '' %>">
                  <label for="willingToRelocate">Willing to Relocate</label>
                </div>
              </div>

              <div class="mb-6 input-floating">
                <input type="text" id="languagesSpoken" name="languagesSpoken" placeholder=" ">
                <label for="languagesSpoken">Languages Spoken (comma separated)</label>
              </div>
            </div>

            <!-- Physical Appearance Tab -->
            <div class="tab-content" id="physical">
              <h2 class="text-headline-md font-headline-md text-primary mb-6 border-b border-surface-variant pb-2">Physical Appearance</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-element-gap mb-6">
                <div class="input-floating">
                  <select id="height" name="height">
                    <option value="">Select height</option>
                    <% const heightCm = [140,142,145,147,150,152,155,157,160,163,165,168,170,173,175,178,180,183,185,188,191,193,196,198,201]; %>
                    <% const heightLabel = {"140":"4'7\" (140 cm)","142":"4'8\" (142 cm)","145":"4'9\" (145 cm)","147":"4'10\" (147 cm)","150":"4'11\" (150 cm)","152":"5'0\" (152 cm)","155":"5'1\" (155 cm)","157":"5'2\" (157 cm)","160":"5'3\" (160 cm)","163":"5'4\" (163 cm)","165":"5'5\" (165 cm)","168":"5'6\" (168 cm)","170":"5'7\" (170 cm)","173":"5'8\" (173 cm)","175":"5'9\" (175 cm)","178":"5'10\" (178 cm)","180":"5'11\" (180 cm)","183":"6'0\" (183 cm)","185":"6'1\" (185 cm)","188":"6'2\" (188 cm)","191":"6'3\" (191 cm)","193":"6'4\" (193 cm)","196":"6'5\" (196 cm)","198":"6'6\" (198 cm)","201":"6'7\" (201 cm)"}; %>
                    <% const curHeight = accountInfo.height != null ? String(accountInfo.height) : ''; %>
                    <% if (curHeight && !heightCm.includes(Number(curHeight))) { %>
                    <option value="<%= curHeight %>" selected><%= curHeight %> cm</option>
                    <% } %>
                    <% heightCm.forEach(h => { %>
                    <option value="<%= h %>" <%= (curHeight === String(h)) ? 'selected' : '' %>><%= heightLabel[String(h)] %></option>
                    <% }) %>
                  </select>
                  <label for="height">Height</label>
                </div>
                <div class="input-floating">
                  <select id="build" name="build">
                    <option value="slim" <%= (accountInfo.build === 'slim') ? 'selected' : '' %>>Slim</option>
                    <option value="average" <%= (accountInfo.build === 'average') ? 'selected' : '' %>>Average</option>
                    <option value="athletic" <%= (accountInfo.build === 'athletic') ? 'selected' : '' %>>Athletic</option>
                    <option value="heavy" <%= (accountInfo.build === 'heavy') ? 'selected' : '' %>>Heavy</option>
                    <option value="N/A" <%= (!accountInfo.build || accountInfo.build === 'N/A') ? 'selected' : '' %>>N/A</option>
                  </select>
                  <label for="build">Build</label>
                </div>
                <% if (accountInfo.gender === 'female') { %>
                <div id="hijabContainer" class="input-floating">
                  <select id="wearHijab" name="wearHijab">
                    <option value="yes" <%= (accountInfo.wearHijab === 'yes') ? 'selected' : '' %>>Yes</option>
                    <option value="no" <%= (accountInfo.wearHijab === 'no') ? 'selected' : '' %>>No</option>
                  </select>
                  <label for="wearHijab">Do you wear hijab?</label>
                </div>
                <% } else { %>
                <div id="beardContainer" class="input-floating">
                  <select id="beard" name="beard">
                    <option value="no" <%= (accountInfo.beard === 'no') ? 'selected' : '' %>>No</option>
                    <option value="short" <%= (accountInfo.beard === 'short') ? 'selected' : '' %>>Short</option>
                    <option value="medium" <%= (accountInfo.beard === 'medium') ? 'selected' : '' %>>Medium</option>
                    <option value="long" <%= (accountInfo.beard === 'long') ? 'selected' : '' %>>Long</option>
                    <option value="N/A" <%= (accountInfo.beard === 'N/A') ? 'selected' : '' %>>N/A</option>
                  </select>
                  <label for="beard">Do you have a beard?</label>
                </div>
                <% } %>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-element-gap mb-6">
                <div class="input-floating">
                  <select id="eyeColor" name="eyeColor">
                    <option value="black" <%= (accountInfo.eyeColor === 'black') ? 'selected' : '' %>>Black</option>
                    <option value="brown" <%= (accountInfo.eyeColor === 'brown') ? 'selected' : '' %>>Brown</option>
                    <option value="grey" <%= (accountInfo.eyeColor === 'grey') ? 'selected' : '' %>>Grey</option>
