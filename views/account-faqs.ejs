<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account FAQs | shadiAmour Help Centre</title>

  <!-- SEO Meta Tags -->
  <meta name="description" content="Find answers to common questions about creating, managing, and securing your shadiAmour account." />
  <meta name="keywords" content="shadiamour FAQ, account help, matrimony questions, profile management, how to send requests, Muslim marriage platform help" />
  <link rel="canonical" href="https://shadiamour.com/account-faqs" />

  <!-- Open Graph / Social Media -->
  <meta property="og:title" content="Account FAQs | shadiAmour Help Centre" />
  <meta property="og:description" content="Find answers to common questions about creating, managing, and securing your shadiAmour account." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://shadiamour.com/account-faqs" />

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#00113a">

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/output.css" />
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"></noscript>

  <style>
    .faq-item {
      cursor: pointer;
      transition: background-color 0.3s ease;
    }
    .faq-item:hover {
      background-color: #f4f3f9;
    }
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out, padding 0.3s ease;
    }
    .faq-item.active .faq-answer {
      max-height: 1000px;
      padding-top: 1rem;
    }
    .faq-item.active .faq-icon {
      transform: rotate(180deg);
    }
    .faq-icon {
      transition: transform 0.3s ease;
    }
    .category-tab {
      background-color: #ffffff;
      color: #444650;
      border: 1px solid #c5c6d2;
      transition: all 0.2s ease;
    }
    .category-tab:hover {
      border-color: #002366;
      color: #002366;
    }
    .category-tab.active {
      background-color: #00113a;
      color: #ffffff;
      border-color: #00113a;
    }
  </style>
  <%- include('partials/clarity') %>
  <%- include('partials/thirdparty') %>
  <%- include('partials/analytics') %>
</head>

<body class="bg-background text-on-background font-body-md antialiased flex flex-col min-h-screen">
  <%- include('partials/header') %>

  <main class="flex-grow pt-[92px]">
    <!-- Hero -->
    <section class="py-section-padding px-margin-x max-w-container-max mx-auto text-center flex flex-col items-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-secondary-container/20 border border-secondary-container/40 rounded-full text-secondary font-label-md text-sm font-medium mb-6">
        <i class="ri-questionnaire-line"></i>
        <span>Help Centre</span>
      </div>
      <h1 class="text-display-lg-mobile md:text-display-lg font-display-lg-mobile md:font-display-lg text-primary mb-6 leading-tight">
        Account FAQs
      </h1>
      <p class="text-body-lg font-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Find answers to common questions about creating, managing, and securing your shadiAmour account.
      </p>
    </section>

    <section class="px-margin-x max-w-container-max mx-auto pb-section-padding">
      <div class="max-w-4xl mx-auto">
        <!-- Quick Help Box -->
        <div class="bg-primary rounded-xl border border-primary-container shadow-[0px_4px_20px_rgba(0,35,102,0.15)] p-6 text-on-primary mb-8">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
              <h2 class="text-headline-md font-headline-md text-on-primary mb-1">Can't find what you're looking for?</h2>
              <p class="text-on-primary/80">Our support team is here to help you</p>
            </div>
            <a href="mailto:contact@shadiamour.com" class="inline-flex items-center px-5 py-2.5 bg-on-primary text-primary rounded-full font-medium hover:bg-secondary-container transition-colors">
              <i class="ri-mail-line mr-2"></i>
              Contact Support
            </a>
          </div>
        </div>

        <!-- Category Tabs -->
        <div class="flex flex-wrap gap-2 mb-6">
          <button onclick="showCategory('all')" class="category-tab active px-4 py-2 rounded-full text-sm font-medium">
            All Questions
          </button>
          <button onclick="showCategory('getting-started')" class="category-tab px-4 py-2 rounded-full text-sm font-medium">
            <i class="ri-rocket-line mr-1"></i>
            Getting Started
          </button>
          <button onclick="showCategory('profile')" class="category-tab px-4 py-2 rounded-full text-sm font-medium">
            <i class="ri-user-settings-line mr-1"></i>
            Profile &amp; Privacy
          </button>
          <button onclick="showCategory('membership')" class="category-tab px-4 py-2 rounded-full text-sm font-medium">
            <i class="ri-vip-crown-line mr-1"></i>
            Membership &amp; Billing
          </button>
          <button onclick="showCategory('safety')" class="category-tab px-4 py-2 rounded-full text-sm font-medium">
            <i class="ri-shield-check-line mr-1"></i>
            Safety &amp; Support
          </button>
        </div>

      <!-- Main Content -->
      <div class="bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] overflow-hidden">
        
        <!-- GETTING STARTED SECTION -->
        <div class="faq-section-header p-6 border-b border-outline-variant/30 bg-surface-container-low">
          <h2 class="text-headline-md font-headline-md text-primary flex items-center">
            <i class="ri-rocket-line text-premium-gold mr-2"></i>
            Getting Started
          </h2>
        </div>

        <div class="divide-y divide-outline-variant/30" data-category="getting-started">
          <!-- FAQ Item 1 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-body-lg font-body-lg font-medium text-on-surface pr-4">How do I create an account?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Click "Sign Up," enter your details, and complete your profile. It takes about 2 minutes. Your profile is then manually reviewed by our team before it goes live.</p>
            </div>
          </div>

          <!-- FAQ Item 2 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-body-lg font-body-lg font-medium text-on-surface pr-4">How long does profile verification take?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Most profiles are reviewed within 24-48 hours. You'll receive an email once your profile is approved.</p>
            </div>
          </div>
        </div>

        <!-- PROFILE & PRIVACY SECTION -->
        <div class="faq-section-header p-6 border-b border-t border-outline-variant/30 bg-surface-container-low">
          <h2 class="text-headline-md font-headline-md text-primary flex items-center">
            <i class="ri-user-settings-line text-premium-gold mr-2"></i>
            Profile &amp; Privacy
          </h2>
        </div>

        <div class="divide-y divide-outline-variant/30" data-category="profile">
          <!-- FAQ Item: edit profile -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-body-lg font-body-lg font-medium text-on-surface pr-4">Can I edit my profile after it's approved?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Yes, you can update your profile at any time from your account settings. Significant changes may be re-reviewed by our team.</p>
            </div>
          </div>

          <!-- FAQ Item: parent/guardian -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-body-lg font-body-lg font-medium text-on-surface pr-4">Can my parent or guardian manage my profile?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Yes. shadiAmour supports family involvement — a parent, guardian, or sibling can create or help manage a profile with the individual's knowledge and consent.</p>
            </div>
          </div>

          <!-- FAQ Item: control visibility -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-body-lg font-body-lg font-medium text-on-surface pr-4">How do I control who sees my profile?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Your privacy settings let you control profile visibility and what information (like photos or contact details) is shared, and with whom.</p>
            </div>
          </div>

          <!-- FAQ Item: delete account -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-body-lg font-body-lg font-medium text-on-surface pr-4">How do I delete my account?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Go to Account Settings &gt; Delete Account, or email <a href="mailto:support@shadiamour.com" class="text-primary hover:underline">support@shadiamour.com</a> and we'll process your request in line with our Privacy Policy.</p>
            </div>
          </div>

          <!-- FAQ Item: forgot password -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-body-lg font-body-lg font-medium text-on-surface pr-4">I forgot my password — what do I do?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Click "Forgot Password" on the <a href="/login" class="text-primary hover:underline">login page</a> and follow the instructions sent to your registered email.</p>
            </div>
          </div>
        </div>

        <!-- MEMBERSHIP & BILLING SECTION -->
        <div class="faq-section-header p-6 border-b border-t border-outline-variant/30 bg-surface-container-low">
          <h2 class="text-headline-md font-headline-md text-primary flex items-center">
            <i class="ri-vip-crown-line text-premium-gold mr-2"></i>
            Membership &amp; Billing
          </h2>
        </div>

        <div class="divide-y divide-outline-variant/30" data-category="membership">
          <!-- FAQ Item: upgrade -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-body-lg font-body-lg font-medium text-on-surface pr-4">How do I upgrade my plan?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Go to Account Settings &gt; Membership, and select the plan that's right for you. You can also compare all plans on our <a href="/pricing" class="text-primary hover:underline">Pricing</a> page.</p>
            </div>
          </div>

          <!-- FAQ Item: cancel/downgrade -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-body-lg font-body-lg font-medium text-on-surface pr-4">How do I cancel or downgrade my plan?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>You can downgrade or cancel from Account Settings &gt; Membership at any time. See our <a href="/refund-policy" class="text-primary hover:underline">Refund Policy</a> for eligibility on refunds.</p>
            </div>
          </div>
        </div>

        <!-- SAFETY & SUPPORT SECTION -->
        <div class="faq-section-header p-6 border-b border-t border-outline-variant/30 bg-surface-container-low">
          <h2 class="text-headline-md font-headline-md text-primary flex items-center">
            <i class="ri-shield-check-line text-premium-gold mr-2"></i>
            Safety &amp; Support
          </h2>
        </div>

        <div class="divide-y divide-outline-variant/30" data-category="safety">
          <!-- FAQ Item: report -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-body-lg font-body-lg font-medium text-on-surface pr-4">How do I report a suspicious or fake profile?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Use the "Report" button on any profile, or email <a href="mailto:issues@shadiamour.com" class="text-primary hover:underline">issues@shadiamour.com</a> with details.</p>
            </div>
          </div>

          <!-- FAQ Item: who to contact -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-body-lg font-body-lg font-medium text-on-surface pr-4">Who do I contact for help?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p class="mb-2">General support: <a href="mailto:support@shadiamour.com" class="text-primary hover:underline">support@shadiamour.com</a></p>
              <p class="mb-2">Bug reports: <a href="mailto:issues@shadiamour.com" class="text-primary hover:underline">issues@shadiamour.com</a></p>
              <p>Or call us: <a href="tel:+447454516156" class="text-primary hover:underline">+44 7454 516156</a></p>
            </div>
          </div>
        </div>

      </div>

      <!-- Still Have Questions -->
      <div class="mt-8 bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] p-8 text-center">
        <i class="ri-question-answer-line text-4xl text-premium-gold mb-4"></i>
        <h2 class="text-headline-md font-headline-md text-primary mb-2">Still Have Questions?</h2>
        <p class="text-on-surface-variant mb-6">Our support team is ready to help you with any queries</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="mailto:support@shadiamour.com" class="inline-flex items-center px-6 py-3 bg-primary text-on-primary rounded-full font-medium hover:bg-primary-container transition-colors">
            <i class="ri-mail-line mr-2"></i>
            Email Support
          </a>
          <a href="/gdpr-faqs" class="inline-flex items-center px-6 py-3 bg-neutral-gray border border-outline-variant text-on-surface-variant rounded-full font-medium hover:border-primary hover:text-primary transition-colors">
            <i class="ri-shield-check-line mr-2"></i>
            GDPR FAQs
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="mt-8 text-center">
        <p class="text-on-surface-variant mb-4">Related Pages</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/pricing" class="inline-flex items-center px-4 py-2 bg-neutral-gray border border-outline-variant rounded-full text-on-surface-variant hover:border-primary hover:text-primary transition-colors">
            <i class="ri-price-tag-3-line mr-2"></i>
            Pricing
          </a>
          <a href="/refund-policy" class="inline-flex items-center px-4 py-2 bg-neutral-gray border border-outline-variant rounded-full text-on-surface-variant hover:border-primary hover:text-primary transition-colors">
            <i class="ri-refund-2-line mr-2"></i>
            Refund Policy
          </a>
          <a href="/code-of-conduct" class="inline-flex items-center px-4 py-2 bg-neutral-gray border border-outline-variant rounded-full text-on-surface-variant hover:border-primary hover:text-primary transition-colors">
            <i class="ri-file-list-3-line mr-2"></i>
            Code of Conduct
          </a>
        </div>
      </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script>
    function toggleFaq(element) {
      // Close all other FAQs
      document.querySelectorAll('.faq-item').forEach(item => {
        if (item !== element && item.classList.contains('active')) {
          item.classList.remove('active');
        }
      });
      // Toggle current FAQ
      element.classList.toggle('active');
    }

    function showCategory(category) {
      // Update active tab
      document.querySelectorAll('.category-tab').forEach(tab => {
        tab.classList.remove('active');
      });
      event.target.classList.add('active');

      // Show/hide FAQ sections
      if (category === 'all') {
        document.querySelectorAll('[data-category]').forEach(section => {
          section.style.display = 'block';
        });
        document.querySelectorAll('.faq-section-header').forEach(header => {
          header.style.display = 'block';
        });
      } else {
        document.querySelectorAll('[data-category]').forEach(section => {
          if (section.dataset.category === category) {
            section.style.display = 'block';
            // Show the header before this section
            section.previousElementSibling.style.display = 'block';
          } else {
            section.style.display = 'none';
            section.previousElementSibling.style.display = 'none';
          }
        });
      }
    }
  </script>
</body>

</html>
