  <style>
    .policy-body h2 {
      font-family: 'Manrope', sans-serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: #00113a;
      margin: 2.5rem 0 1rem;
      line-height: 1.3;
    }
    .policy-body h3 {
      font-family: 'Manrope', sans-serif;
      font-size: 1.25rem;
      font-weight: 600;
      color: #00113a;
      margin: 1.5rem 0 0.75rem;
      line-height: 1.3;
    }
    .policy-body p { color: #444650; line-height: 1.7; margin-bottom: 1rem; }
    .policy-body ul, .policy-body ol { margin: 1rem 0; padding-left: 1.5rem; color: #444650; }
    .policy-body ul { list-style-type: disc; }
    .policy-body ol { list-style-type: decimal; }
    .policy-body li { margin-bottom: 0.5rem; line-height: 1.6; }
    .policy-body strong { color: #1a1b20; }
    .policy-body a { color: #002366; text-decoration: underline; transition: color 0.3s ease; }
    .policy-body a:hover { color: #003399; }
    .policy-body blockquote { border-left: 4px solid #C5A059; padding: 1rem 1.5rem; margin: 1.5rem 0; background: #f4f3f9; border-radius: 0.5rem; color: #444650; font-style: italic; }
  </style>
