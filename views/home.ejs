      window.validateReservationPhone = function(inputEl) {
        const container = inputEl.closest('form, div');
        const countryCode = container.querySelector('.reservation-country-code').value;
        const phoneDigits = inputEl.value.replace(/\D/g, '');
        const errorEl = container.querySelector('.reservation-phone-error');
        const successEl = container.querySelector('.reservation-phone-success');
        const rule = phoneRules[countryCode];

        if (!rule) {
          if (errorEl) errorEl.classList.add('hidden');
          if (successEl) successEl.classList.add('hidden');
          inputEl.classList.remove('border-red-500', 'border-green-500');
          return true;
        }
        if (phoneDigits.length === 0) {
          if (errorEl) errorEl.classList.add('hidden');
          if (successEl) successEl.classList.add('hidden');
          inputEl.classList.remove('border-red-500', 'border-green-500');
          return false;
        }
        if (phoneDigits.length < rule.min) {
          if (errorEl) { errorEl.textContent = rule.name + ' phone needs ' + rule.min + ' digits (have ' + phoneDigits.length + '). e.g. ' + rule.example; errorEl.classList.remove('hidden'); }
          if (successEl) successEl.classList.add('hidden');
          inputEl.classList.add('border-red-500');
          inputEl.classList.remove('border-green-500');
          return false;
        }
        if (phoneDigits.length > rule.max) {
          if (errorEl) { errorEl.textContent = rule.name + ' phone max ' + rule.max + ' digits (have ' + phoneDigits.length + ')'; errorEl.classList.remove('hidden'); }
          if (successEl) successEl.classList.add('hidden');
          inputEl.classList.add('border-red-500');
          inputEl.classList.remove('border-green-500');
          return false;
        }
        if (errorEl) errorEl.classList.add('hidden');
        if (successEl) successEl.classList.remove('hidden');
        inputEl.classList.remove('border-red-500');
        inputEl.classList.add('border-green-500');
        return true;
      };

      document.addEventListener('change', function(e) {
        if (e.target.classList.contains('reservation-country-code')) {
          const container = e.target.closest('form, div');
          const phoneInput = container.querySelector('.reservation-phone');
          const rule = phoneRules[e.target.value];
          if (phoneInput && rule) {
            phoneInput.placeholder = rule.example;
          }
          if (phoneInput && phoneInput.value) {
            window.validateReservationPhone(phoneInput);
          }
        }
      });
    })();
  </script>

  <!-- Simple micro-interaction for navbar transparency shift on scroll -->
  <script>
    window.addEventListener('scroll', function() {
      const nav = document.querySelector('header');
      if (nav && window.scrollY > 50) {
        nav.classList.add('bg-white/95', 'backdrop-blur-md');
      } else if (nav) {
        nav.classList.remove('bg-white/95', 'backdrop-blur-md');
      }
    });
  </script>
</body>

</html>
