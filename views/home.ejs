  <script id="newsletter-handler">
    document.addEventListener('DOMContentLoaded', function() {
      const newsletterForm = document.getElementById('newsletterForm');
      const submitButton = document.getElementById('newsletter-submit');
      const successMessage = document.getElementById('newsletter-success');

      if (newsletterForm) {
        newsletterForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          const formData = new FormData(this);
          const data = Object.fromEntries(formData.entries());
          const originalText = submitButton.innerHTML;
          submitButton.innerHTML = 'Subscribing...';
          submitButton.disabled = true;
          try {
            const response = await fetch('/api/newsletter/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) {
              newsletterForm.style.display = 'none';
              successMessage.classList.remove('hidden');
              successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
              alert(result.error || 'Failed to subscribe. Please try again.');
            }
          } catch (error) {
            console.error('Newsletter subscription error:', error);
            alert('Failed to subscribe. Please check your connection and try again.');
          } finally {
            submitButton.innerHTML = originalText;
            submitButton.disabled = false;
          }
        });
      }
    });
  </script>

  <script id="home-reservation-handler">
    (function () {
      const form = document.getElementById('homeSectionReservationForm');
      const success = document.getElementById('homeSectionReservationSuccess');
      if (!form) return;

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const phoneInput = form.querySelector('.reservation-phone');
        if (phoneInput && !window.validateReservationPhone(phoneInput)) {
          alert('Please enter a valid phone number.');
          return;
        }
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        data.source = 'home_section';
        data.pageUrl = window.location.href;

        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = 'Booking...';
        submitBtn.disabled = true;

        try {
          const response = await fetch('/api/reservations/book', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await response.json();
          if (result.success) {
            form.classList.add('hidden');
            success.classList.remove('hidden');
          } else {
            alert(result.error || 'Something went wrong. Please try again.');
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
          }
        } catch (err) {
          console.error('Home section reservation error:', err);
          alert('Network error. Please try again.');
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
        }
      });
    })();
  </script>

  <script id="floating-reservation-handler">
    (function () {
      const toggle = document.getElementById('reservationToggle');
      const card = document.getElementById('reservationFormCard');
      const close = document.getElementById('reservationClose');
      const arrow = document.getElementById('reservationArrow');
      const form = document.getElementById('floatingReservationForm');
      const success = document.getElementById('floatingReservationSuccess');
      let isOpen = false;

      function openCard() {
        isOpen = true;
        card.classList.remove('hidden');
        arrow.style.transform = 'rotate(180deg)';
      }
      function closeCard() {
        isOpen = false;
        card.classList.add('hidden');
        arrow.style.transform = 'rotate(0deg)';
      }
      if (toggle) toggle.addEventListener('click', function () { if (isOpen) { closeCard(); } else { openCard(); } });
      if (close) close.addEventListener('click', function (e) { e.stopPropagation(); closeCard(); });

      if (form) {
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          const phoneInput = form.querySelector('.reservation-phone');
          if (phoneInput && !window.validateReservationPhone(phoneInput)) {
            alert('Please enter a valid phone number.');
            return;
          }
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());
          data.source = 'floating_button';
          data.pageUrl = window.location.href;

          const submitBtn = form.querySelector('button[type="submit"]');
          const originalText = submitBtn.innerHTML;
          submitBtn.innerHTML = 'Booking...';
          submitBtn.disabled = true;

          try {
            const response = await fetch('/api/reservations/book', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) {
              form.classList.add('hidden');
              success.classList.remove('hidden');
              setTimeout(function () { closeCard(); }, 3000);
            } else {
              alert(result.error || 'Something went wrong. Please try again.');
              submitBtn.innerHTML = originalText;
              submitBtn.disabled = false;
            }
          } catch (err) {
            console.error('Floating reservation error:', err);
            alert('Network error. Please try again.');
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
          }
        });
      }
    })();
  </script>

