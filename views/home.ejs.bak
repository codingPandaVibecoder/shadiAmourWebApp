<body class="bg-gray-50 font-['Roboto']">
  <%- include('partials/header') %>

  <main class="pt-24 min-h-screen">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-800 mb-4 font-['Playfair_Display']">
          Shadi Amour | Halal Muslim Matchmaking for Young Singles in the UK
        </h1>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Join Shadi Amour — the modern halal Muslim matchmaking platform where young Muslims find love and marriage with purpose across London, Birmingham, and Manchester.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <a href="/profiles?gender=male" data-track="true" data-event-name="browse_men_click" data-category="engagement" data-label="Browse Muslim Men" class="bg-white rounded-2xl material-shadow hover:material-shadow-hover transition-all duration-300 cursor-pointer group overflow-hidden">
          <div class="p-8 text-center">
            <div class="mb-6 relative">
              <img src="https://res.cloudinary.com/dhuc2plh0/image/upload/c_fill,w_700,h_450,q_auto,f_auto/v1759650466/covermain_tfda9t.jpg" srcset="https://res.cloudinary.com/dhuc2plh0/image/upload/c_fill,w_400,h_260,q_auto,f_auto/v1759650466/covermain_tfda9t.jpg 400w, https://res.cloudinary.com/dhuc2plh0/image/upload/c_fill,w_700,h_450,q_auto,f_auto/v1759650466/covermain_tfda9t.jpg 700w" sizes="(max-width: 768px) 100vw, 50vw" alt="Muslim men for marriage in UK - halal matchmaking service London Leicester" class="w-full h-64 object-cover object-top rounded-xl group-hover:scale-105 transition-transform duration-500" width="700" height="450" fetchpriority="high">
            </div>
            <h3 class="text-3xl font-bold text-gray-800 mb-4 font-['Playfair_Display'] group-hover:text-primary transition-colors duration-300">Find Muslim Men for Marriage UK</h3>
            <p class="text-gray-600 mb-6">Discover your ideal Muslim husband through our verified halal Muslim matchmaking service. Connect with single Muslim men seeking serious marriage across London, Birmingham, Manchester, and Leicester. Our Muslim marriage app features Pakistani, Bangladeshi, and British Muslim singles ready for halal dating and modern Nikkah partnerships.</p>
            <div class="flex items-center justify-center">
              <div class="w-6 h-6 flex items-center justify-center text-primary group-hover:translate-x-2 transition-transform duration-300">
                <i class="ri-arrow-right-line ri-lg"></i>
              </div>
            </div>
          </div>
        </a>

        <a href="/profiles?gender=female" data-track="true" data-event-name="browse_women_click" data-category="engagement" data-label="Browse Muslim Women" class="bg-white rounded-2xl material-shadow hover:material-shadow-hover transition-all duration-300 cursor-pointer group overflow-hidden">
          <div class="p-8 text-center">
            <div class="mb-6 relative">
              <picture>
                <source type="image/webp" srcset="/images/homepagewoman.webp">
                <img src="/images/homepagewoman.jpg" alt="Muslim women for marriage UK - Islamic matrimonial service Birmingham London" class="w-full h-64 object-cover object-top rounded-xl group-hover:scale-105 transition-transform duration-500" width="700" height="450" fetchpriority="high">
              </picture>
            </div>
            <h3 class="text-3xl font-bold text-gray-800 mb-4 font-['Playfair_Display'] group-hover:text-primary transition-colors duration-300">Muslim Women for Marriage</h3>
            <p class="text-gray-600 mb-6">Browse authentic profiles of Muslim women seeking halal love marriage in the UK. Our online Muslim matchmaking platform connects you with single Muslim women ready for Islamic matrimony, Muslim engagement, and serious Muslim relationships. Find your Muslim soulmate among verified profiles in London and beyond.</p>

            <div class="flex items-center justify-center">
              <div class="w-6 h-6 flex items-center justify-center text-primary group-hover:translate-x-2 transition-transform duration-300">
                <i class="ri-arrow-right-line ri-lg"></i>
              </div>
            </div>
          </div>
        </a>
      </div>

    </div>

    <!-- Trust Bar Section -->
    <div class="bg-white py-8 mt-16 border-y border-gray-100">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
              <i class="ri-shield-check-line text-2xl text-primary"></i>
            </div>
            <div>
              <p class="font-semibold text-gray-800">Verified Profiles</p>
              <p class="text-sm text-gray-500">Every user is moderated</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
              <i class="ri-heart-3-line text-2xl text-primary"></i>
            </div>
            <div>
              <p class="font-semibold text-gray-800">Halal Only</p>
              <p class="text-sm text-gray-500">Marriage-focused platform</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
              <i class="ri-lock-line text-2xl text-primary"></i>
            </div>
            <div>
              <p class="font-semibold text-gray-800">Privacy First</p>
              <p class="text-sm text-gray-500">Your data stays protected</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
              <i class="ri-map-pin-line text-2xl text-primary"></i>
            </div>
            <div>
              <p class="font-semibold text-gray-800">UK Focused</p>
              <p class="text-sm text-gray-500">London • Leicester • Birmingham</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- How It Works Section -->
    <div class="py-20 bg-gray-50">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-800 mb-4 font-['Playfair_Display']">How It Works</h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">Find your Muslim spouse in four simple steps</p>
        </div>

        <div class="grid md:grid-cols-4 gap-8">
          <!-- Step 1 -->
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 mx-auto bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center text-white text-3xl font-bold group-hover:scale-110 transition-transform duration-300">
                1
              </div>
              <div class="hidden md:block absolute top-1/2 left-full w-full h-0.5 bg-gradient-to-r from-primary/50 to-transparent -translate-y-1/2"></div>
            </div>
            <h3 class="text-xl font-bold text-gray-800 mb-2">Create Your Free Profile</h3>
            <p class="text-gray-600">Takes 2 minutes — no payment required</p>
          </div>

          <!-- Step 2 -->
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 mx-auto bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center text-white text-3xl font-bold group-hover:scale-110 transition-transform duration-300">
                2
              </div>
              <div class="hidden md:block absolute top-1/2 left-full w-full h-0.5 bg-gradient-to-r from-primary/50 to-transparent -translate-y-1/2"></div>
            </div>
            <h3 class="text-xl font-bold text-gray-800 mb-2">Browse Verified UK Muslim Profiles</h3>
            <p class="text-gray-600">Filter by city, age, background and more</p>
          </div>

          <!-- Step 3 -->
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 mx-auto bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center text-white text-3xl font-bold group-hover:scale-110 transition-transform duration-300">
                3
              </div>
              <div class="hidden md:block absolute top-1/2 left-full w-full h-0.5 bg-gradient-to-r from-primary/50 to-transparent -translate-y-1/2"></div>
            </div>
            <h3 class="text-xl font-bold text-gray-800 mb-2">Send Connection Requests</h3>
            <p class="text-gray-600">You are in full control of who you connect with</p>
          </div>

          <!-- Step 4 -->
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 mx-auto bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center text-white text-3xl font-bold group-hover:scale-110 transition-transform duration-300">
                4
              </div>
            </div>
            <h3 class="text-xl font-bold text-gray-800 mb-2">Connect Through Halal Chat</h3>
            <p class="text-gray-600">Respectful, private, and purpose-built for marriage</p>
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center justify-center gap-4 mt-12">
          <a href="/register" data-track="true" data-event-name="cta_register_click" data-category="cta" data-label="Create Your Free Profile" class="gradient-bg text-white font-bold py-4 px-8 rounded-button hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300 ripple text-lg">
            <i class="ri-user-add-line mr-2"></i>Create Your Free Profile
          </a>
          <a href="/profiles" data-track="true" data-event-name="cta_browse_profiles" data-category="cta" data-label="Browse Profiles" class="bg-white text-primary font-bold py-4 px-8 rounded-button border-2 border-primary hover:bg-primary hover:text-white transition-all duration-300 text-lg">
