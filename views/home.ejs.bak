                  <input type="tel" name="phone" required
                    class="reservation-phone flex-1 px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
                    placeholder="7XXX XXXXXX"
                    oninput="window.validateReservationPhone && window.validateReservationPhone(this)">
                </div>
