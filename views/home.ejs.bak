<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= globalSeoSettings && globalSeoSettings.homepageMetaTitle ? globalSeoSettings.homepageMetaTitle : "Muslim Marriage UK | Best Muslim Matchmaking Service London Leicester | shadiamour" %></title>

  <!-- SEO Meta Tags -->
  <meta name="description" content="<%= globalSeoSettings && globalSeoSettings.homepageMetaDescription ? globalSeoSettings.homepageMetaDescription : "UK's most trusted Muslim marriage site. Verified profiles for halal rishta in London, Leicester & Birmingham. Free to join. Browse 1,000+ Muslim singles." %>">  
  <meta name="keywords" content="Find your perfect Muslim spouse through shadiAmour - the UK's leading halal marriage site. Verified Muslim profiles for marriage in London, Leicester & Birmingham. Trusted Islamic matrimonial service with Muslim rishta connections.">
  <meta name="author" content="shadiamour">
  <link rel="canonical" href="https://shadiamour.com">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#E91E63">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://shadiamour.com/">
  <meta property="og:title" content="<%= globalSeoSettings && globalSeoSettings.homepageMetaTitle ? globalSeoSettings.homepageMetaTitle : 'Muslim Marriage UK | Best Muslim Matchmaking Service London Leicester' %>">
  <meta property="og:description" content="<%= globalSeoSettings && globalSeoSettings.homepageMetaDescription ? globalSeoSettings.homepageMetaDescription : 'Join the UKs most trusted halal marriage site. Find verified Muslim profiles for marriage in London, Leicester & Birmingham. Islamic matrimonial service with proven results.' %>">
  <meta property="og:image" content="https://shadiamour.com/images/homepageman.jpg">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="https://shadiamour.com/">
  <meta property="twitter:title" content="<%= globalSeoSettings && globalSeoSettings.homepageMetaTitle ? globalSeoSettings.homepageMetaTitle : 'Muslim Marriage UK | Best Muslim Matchmaking Service London Leicester' %>">
  <meta property="twitter:description" content="<%= globalSeoSettings && globalSeoSettings.homepageMetaDescription ? globalSeoSettings.homepageMetaDescription : 'Discover your perfect Muslim spouse through the UKs leading Islamic matrimonial service. Verified profiles, halal connections.' %>">
  <meta property="twitter:image" content="https://shadiamour.com/images/homepageman.jpg">

  <!-- Preload hero images for LCP -->
  <link rel="preload" as="image" href="https://res.cloudinary.com/dhuc2plh0/image/upload/c_fill,w_700,h_450,q_auto,f_auto/v1759650466/covermain_tfda9t.jpg" fetchpriority="high">
  <link rel="preload" as="image" href="/images/homepagewoman.webp" type="image/webp" fetchpriority="high">

  <!-- Preconnect to Cloudinary CDN -->
  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>
  <link rel="dns-prefetch" href="//cdnjs.cloudflare.com">
  <link rel="dns-prefetch" href="//t.contentsquare.net">

  <link rel="stylesheet" href="/css/output.css">
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"></noscript>
  <style>
    :where([class^="ri-"])::before {
      content: "\f3c2";
    }

    .material-shadow {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .material-shadow-hover {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

    .material-shadow-elevated {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }

    .ripple {
      position: relative;
      overflow: hidden;
    }

    .ripple::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }

    .ripple:active::before {
      width: 300px;
      height: 300px;
    }

    .gradient-bg {
      background: linear-gradient(135deg, #E91E63 0%, #673AB7 100%);
    }

    /* Review card hover effects */
    .group:hover .w-12 {
      transform: scale(1.1);
      transition: transform 0.3s ease;
    }

    /* Staggered animation for reviews */
    .reviews-grid {
      animation: fadeInUp 0.8s ease-out;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Review quote styling */
    .review-quote::before {
      content: '"';
      font-size: 2rem;
      color: #E91E63;
      opacity: 0.3;
      font-family: 'Playfair Display', serif;
    }

    /* Section Distinguishability - Reviews */
    .reviews-section {
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
      position: relative;
    }



    /* Review Cards Hover Effect */
    .reviews-section .group:hover {
      transform: translateY(-8px);
    }

    .reviews-section .group:hover .w-12 {
      transform: scale(1.15) rotate(5deg);
      transition: transform 0.4s ease;
    }

    /* Share Experience Card Animation */
    .reviews-section a[target="_blank"]:hover {
      animation: pulse-glow 0.6s ease-in-out;
    }

    @keyframes pulse-glow {

      0%,
      100% {
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
      }

      50% {
        box-shadow: 0 0 40px rgba(59, 130, 246, 0.6);
      }
    }

    /* Section Distinguishability - Newsletter */
    .newsletter-section {
      background: linear-gradient(135deg, #fef7ff 0%, #f3e8ff 50%, #fef7ff 100%);
      border-top: 3px solid #E91E63;
      border-bottom: 3px solid #673AB7;
    }
  </style>
  <!-- Structured Data for SEO -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "shadiamour",
      "alternateName": "shadiAmour",
      "description": "UK's leading Muslim marriage and Islamic matrimonial service connecting Muslim singles in London, Leicester and Birmingham",
      "url": "https://shadiamour.com",
      "logo": "https://shadiamour.com/images/logo.png",
      "sameAs": [
        "https://google.com/maps/place/D'Amour+Muslim/"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "areaServed": ["GB", "London", "Leicester", "Birmingham"],
        "availableLanguage": ["English", "Urdu", "Arabic"]
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Kingdom"
      },
      "serviceType": [
        "Muslim Marriage Service",
        "Islamic Matrimonial",
        "Halal Matchmaking",
        "Muslim Rishta Service"
      ]
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "shadiamour - Muslim Marriage UK",
      "url": "https://shadiamour.com",
      "description": "Best Muslim marriage site in UK for halal matchmaking in London, Leicester & Birmingham",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://shadiamour.com/profiles?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Muslim Marriage and Matchmaking Service",
      "description": "Professional Islamic matrimonial service connecting verified Muslim singles across the UK",
      "provider": {
        "@type": "Organization",
        "name": "shadiamour"
      },
      "areaServed": [
        "London",
        "Leicester",
        "Birmingham",
        "United Kingdom"
      ],
      "serviceType": "Matrimonial Service",
      "audience": {
        "@type": "Audience",
        "audienceType": "Muslim Singles"
      }
    }
  </script>

  <!-- AggregateRating + Review Schema -->
  <script type="application/ld+json">
