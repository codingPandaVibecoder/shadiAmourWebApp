  <script>
    (function () {
      const toggle = document.getElementById('reservationToggle');
      const card = document.getElementById('reservationFormCard');
      const close = document.getElementById('reservationClose');
      const arrow = document.getElementById('reservationArrow');
      const form = document.getElementById('floatingReservationForm');
      const success = document.getElementById('floatingReservationSuccess');
      let isOpen = false;

      function openCard() {
        isOpen = true;
        card.classList.remove('hidden');
        arrow.style.transform = 'rotate(180deg)';
      }

      function closeCard() {
        isOpen = false;
        card.classList.add('hidden');
        arrow.style.transform = 'rotate(0deg)';
      }

      toggle.addEventListener('click', function () {
        if (isOpen) { closeCard(); } else { openCard(); }
      });

      close.addEventListener('click', function (e) {
        e.stopPropagation();
        closeCard();
      });

      if (form) {
        form.addEventListener('submit', async function (e) {
          e.preventDefault();

          // Validate phone before submission
          const phoneInput = form.querySelector('.reservation-phone');
          if (phoneInput && !window.validateReservationPhone(phoneInput)) {
            alert('Please enter a valid phone number.');
            return;
          }

          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());
          data.source = 'floating_button';
          data.pageUrl = window.location.href;

          const submitBtn = form.querySelector('button[type="submit"]');
          const originalText = submitBtn.innerHTML;
          submitBtn.innerHTML = '<i class="ri-loader-4-line animate-spin mr-1"></i>Booking...';
          submitBtn.disabled = true;

          try {
            const response = await fetch('/api/reservations/book', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) {
              form.classList.add('hidden');
              success.classList.remove('hidden');
              setTimeout(function () { closeCard(); }, 3000);
            } else {
              alert(result.error || 'Something went wrong. Please try again.');
              submitBtn.innerHTML = originalText;
              submitBtn.disabled = false;
            }
          } catch (err) {
            console.error('Floating reservation error:', err);
            alert('Network error. Please try again.');
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
          }
        });
      }
    })();
  </script>

