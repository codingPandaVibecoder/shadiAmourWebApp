    <!-- Muslim Marriage Across UK Cities Section -->
    <!-- Recently Added by Our Team Section -->
    <% if (typeof staffAddedProfiles !== 'undefined' && staffAddedProfiles.length > 0) { %>
    <div class="py-20 bg-gray-50">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-gray-800 mb-4 font-['Playfair_Display']">Recently Added by Our Team</h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">Hand-picked profiles added and verified by our matchmaking team</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <% staffAddedProfiles.slice(0, 4).forEach(function(profile) { %>
            <a href="/profiles/<%= profile.profileSlug || profile._id %>" data-track="true" data-event-name="staff_profile_card_click" data-category="engagement" data-label="<%= profile.name || profile.username %>" class="bg-white rounded-2xl overflow-hidden material-shadow hover:material-shadow-hover transition-all duration-300 block group">
              <div class="aspect-[4/5] relative overflow-hidden bg-gray-100">
                <% if (profile.profilePic && profile.profilePic.url) { %>
                  <img src="<%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_300,h_400,q_auto,f_auto/') %>" srcset="<%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_200,h_267,q_auto,f_auto/') %> 200w, <%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_300,h_400,q_auto,f_auto/') %> 300w, <%= profile.profilePic.url.replace('/upload/', '/upload/c_fill,w_400,h_533,q_auto,f_auto/') %> 400w" sizes="(max-width: 640px) 50vw, (max-width: 1024px) 25vw, 300px" alt="<%= profile.name || profile.username %><%= profile.age ? ', ' + profile.age + ' year old' : '' %><%= profile.work ? ' ' + profile.work : '' %> - Muslim marriage profile<%= profile.city ? ' in ' + profile.city : '' %>" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" width="300" height="400">
                <% } else { %>
                  <div class="w-full h-full bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center">
                    <i class="ri-user-3-line text-6xl text-primary/40"></i>
                  </div>
                <% } %>
                <div class="absolute top-2 right-2 bg-green-500 text-white px-2 py-1 rounded-full text-xs font-medium flex items-center gap-1">
                  <i class="ri-shield-check-line"></i> Staff Verified
                </div>
              </div>
              <div class="p-4 text-center">
                <h4 class="font-semibold text-gray-800 mb-1"><%= profile.name || profile.username %><% if (profile.age) { %>, <%= profile.age %><% } %></h4>
                <p class="text-sm text-gray-500"><i class="ri-map-pin-line"></i> <%= profile.city || 'UK' %></p>
                <% if (profile.work) { %>
                <p class="text-xs text-gray-400 mt-1"><%= profile.work %></p>
                <% } %>
              </div>
            </a>
          <% }); %>
        </div>

        <div class="text-center mt-10">
          <a href="/profiles/addedBy/staff" data-track="true" data-event-name="staff_profiles_view_more" data-category="engagement" data-label="View More Staff-Added Profiles" class="inline-flex items-center gap-2 gradient-bg text-white font-semibold py-3 px-8 rounded-button hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-300">
            View More Staff-Added Profiles <i class="ri-arrow-right-line"></i>
          </a>
        </div>
      </div>
    </div>
    <% } %>

