<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | shadiamour</title>
  <meta name="description" content="<%= metaDescription %>">
  <meta name="keywords" content="<%= keywords %>">
  <meta name="author" content="shadiamour">
  <link rel="canonical" href="https://shadiamour.com<%= canonicalPath %>">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#00113a">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://shadiamour.com<%= canonicalPath %>">
  <meta property="og:title" content="<%= pageTitle %> | shadiamour">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:image" content="https://shadiamour.com/images/homepageman.jpg">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="https://shadiamour.com<%= canonicalPath %>">
  <meta property="twitter:title" content="<%= pageTitle %> | shadiamour">
  <meta property="twitter:description" content="<%= metaDescription %>">
  <meta property="twitter:image" content="https://shadiamour.com/images/homepageman.jpg">

  <link rel="stylesheet" href="/css/output.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css">
  <style>
    :where([class^="ri-"])::before {
      content: "\f3c2";
    }

    /* Article body content — remap the legacy content classes onto the new theme */
    .seo-body p {
      font-size: 16px;
      line-height: 28px;
      color: #444650;
      margin-bottom: 1rem;
    }
    .seo-body .text-lg {
      font-size: 18px;
      line-height: 28px;
    }
    .seo-body .text-gray-700,
    .seo-body .text-gray-600 {
      color: #444650;
    }
    .seo-body .text-gray-800 {
      color: #1a1b20;
    }
    .seo-body .text-primary {
      color: #C5A059;
    }
    .seo-body h2 {
      font-family: 'Manrope', sans-serif;
      font-size: 24px;
      line-height: 32px;
      font-weight: 700;
      color: #00113a;
      margin: 2rem 0 1rem;
    }
    .seo-body h2.text-gray-800 {
      color: #00113a;
    }
    .seo-body h2.font-\[\'Playfair_Display\'\] {
      font-family: 'Manrope', sans-serif;
    }
    .seo-body ul {
      list-style: none;
      padding-left: 0;
    }
    .seo-body li {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }
    .seo-body .bg-primary\/5 {
      background-color: rgba(0, 35, 102, 0.06);
    }
    .seo-body .border-primary\/10 {
      border-color: rgba(0, 35, 102, 0.12);
    }
  </style>

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "<%= h1 %>",
    "description": "<%= metaDescription %>",
    "provider": {
      "@type": "Organization",
      "name": "shadiamour",
      "url": "https://shadiamour.com"
    },
    "url": "https://shadiamour.com<%= canonicalPath %>",
    "serviceType": "Muslim Marriage and Matchmaking",
    "areaServed": ["United Kingdom", "Pakistan", "Global"]
  }
  </script>
  <% if (typeof pageFaqSchema !== 'undefined' && pageFaqSchema && pageFaqSchema.length > 0) { %>
  <script type="application/ld+json"><%- JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": pageFaqSchema.map(function(faq){ return { "@type": "Question", "name": faq.q, "acceptedAnswer": { "@type": "Answer", "text": faq.a } }; }) }) %></script>
  <% } else { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is this service halal?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. shadiamour is a marriage-focused platform. We do not allow casual dating or socialising. All interactions are guided by the intention of Nikah."
        }
      },
      {
        "@type": "Question",
        "name": "Is it free to join?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, creating a profile and browsing matches is completely free. No payment is required to get started."
        }
      },
      {
        "@type": "Question",
        "name": "Are profiles verified?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Every profile is reviewed and approved by our moderation team before becoming visible on the platform."
        }
      }
    ]
  }
  </script>
  <% } %>
  <%- include('partials/clarity') %>
  <%- include('partials/thirdparty') %>
  <%- include('partials/analytics') %>
</head>

<body class="bg-background text-on-background font-body-md antialiased flex flex-col min-h-screen">
  <%- include('partials/header') %>

  <main class="flex-grow pt-[92px]">
    <!-- Hero Section -->
    <section class="bg-neutral-gray py-section-padding px-margin-x text-center">
      <div class="max-w-container-max mx-auto">
        <h1 class="text-display-lg-mobile md:text-display-lg font-display-lg-mobile md:font-display-lg text-primary mb-element-gap"><%= h1 %></h1>
        <p class="text-body-lg font-body-lg text-on-surface-variant max-w-2xl mx-auto"><%= heroSubtitle %></p>
      </div>
    </section>

    <!-- Article Body -->
    <section class="max-w-container-max mx-auto px-margin-x py-section-padding">
      <div class="bg-surface-white rounded-xl border border-outline-variant p-6 md:p-10" style="box-shadow: 0px 4px 20px rgba(0, 35, 102, 0.05);">
        <div class="seo-body max-w-none">
          <%- bodyContent %>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="bg-neutral-gray py-section-padding px-margin-x">
      <div class="max-w-container-max mx-auto">
        <h2 class="text-headline-lg font-headline-lg text-primary text-center mb-12">Frequently Asked Questions</h2>
        <div class="max-w-3xl mx-auto space-y-4">
          <% if (typeof pageFaqs !== 'undefined' && pageFaqs && pageFaqs.length > 0) { %>
            <% pageFaqs.forEach(function(faq, idx) { %>
            <div class="faq-card bg-surface-white rounded-xl border border-outline-variant shadow-sm">
              <button type="button" class="faq-toggle w-full flex items-center justify-between gap-4 p-5 text-left">
                <span class="text-headline-md font-headline-md text-primary"><%= faq.q %></span>
                <span class="faq-chevron material-symbols-outlined text-primary-container transition-transform duration-200 <%= idx === 0 ? 'rotate-180' : '' %>">expand_more</span>
              </button>
              <div class="faq-answer <%= idx === 0 ? '' : 'hidden' %> px-5 pb-5">
                <p class="text-body-md font-body-md text-on-surface-variant"><%= faq.a %></p>
              </div>
            </div>
            <% }); %>
          <% } else { %>
          <div class="faq-card bg-surface-white rounded-xl border border-outline-variant shadow-sm">
            <button type="button" class="faq-toggle w-full flex items-center justify-between gap-4 p-5 text-left">
              <span class="text-headline-md font-headline-md text-primary">Is this service halal?</span>
              <span class="faq-chevron material-symbols-outlined text-primary-container transition-transform duration-200 rotate-180">expand_more</span>
            </button>
            <div class="faq-answer px-5 pb-5">
              <p class="text-body-md font-body-md text-on-surface-variant">Yes. shadiamour is a marriage-focused platform. We do not allow casual dating or socialising. All interactions are guided by the intention of Nikah.</p>
            </div>
          </div>
          <div class="faq-card bg-surface-white rounded-xl border border-outline-variant shadow-sm">
            <button type="button" class="faq-toggle w-full flex items-center justify-between gap-4 p-5 text-left">
              <span class="text-headline-md font-headline-md text-primary">Is it free to join?</span>
              <span class="faq-chevron material-symbols-outlined text-primary-container transition-transform duration-200">expand_more</span>
            </button>
            <div class="faq-answer hidden px-5 pb-5">
              <p class="text-body-md font-body-md text-on-surface-variant">Yes, creating a profile and browsing matches is completely free. No payment is required to get started.</p>
            </div>
          </div>
          <div class="faq-card bg-surface-white rounded-xl border border-outline-variant shadow-sm">
            <button type="button" class="faq-toggle w-full flex items-center justify-between gap-4 p-5 text-left">
              <span class="text-headline-md font-headline-md text-primary">Are profiles verified?</span>
              <span class="faq-chevron material-symbols-outlined text-primary-container transition-transform duration-200">expand_more</span>
            </button>
            <div class="faq-answer hidden px-5 pb-5">
              <p class="text-body-md font-body-md text-on-surface-variant">Yes. Every profile is reviewed and approved by our moderation team before becoming visible on the platform.</p>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Internal Links -->
    <section class="py-section-padding px-margin-x">
      <div class="max-w-container-max mx-auto text-center">
        <h2 class="text-headline-lg font-headline-lg text-primary mb-8">Explore More</h2>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-surface border border-outline-variant rounded-full text-label-md font-label-md text-on-surface-variant hover:border-primary hover:text-primary transition-all">Homepage</a>
          <% relatedLinks.forEach(function(link) { %>
            <a href="<%= link.url %>" class="inline-flex items-center gap-2 px-5 py-2.5 bg-surface border border-outline-variant rounded-full text-label-md font-label-md text-on-surface-variant hover:border-primary hover:text-primary transition-all"><%= link.label %></a>
          <% }); %>
          <a href="/blog" class="inline-flex items-center gap-2 px-5 py-2.5 bg-surface border border-outline-variant rounded-full text-label-md font-label-md text-on-surface-variant hover:border-primary hover:text-primary transition-all">Marriage Guides &amp; Blog</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-margin-x pb-section-padding">
      <div class="max-w-container-max mx-auto bg-primary-container rounded-2xl p-8 md:p-12 text-center relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-premium-gold/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-surface-white/5 rounded-full blur-3xl"></div>
        <h2 class="text-headline-lg font-headline-lg text-on-primary relative z-10 mb-4"><%= ctaHeading %></h2>
        <p class="text-body-lg font-body-lg text-on-primary/90 relative z-10 mb-8 max-w-2xl mx-auto"><%= ctaSubtext %></p>
        <div class="flex flex-wrap items-center justify-center gap-4 relative z-10">
          <a href="/register" class="inline-flex items-center gap-2 bg-premium-gold text-on-primary font-label-md text-label-md py-4 px-8 rounded-lg hover:bg-premium-gold/90 transition-all">
            <span class="material-symbols-outlined">person_add</span> Create Your Free Profile
          </a>
          <a href="/profiles" class="inline-flex items-center gap-2 border border-on-primary/30 text-on-primary font-label-md text-label-md py-4 px-8 rounded-lg hover:bg-on-primary/10 transition-all">
            <span class="material-symbols-outlined">search</span> Browse Profiles
          </a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.faq-toggle').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var card = this.closest('.faq-card');
          if (!card) return;
          var answer = card.querySelector('.faq-answer');
          var chevron = this.querySelector('.faq-chevron');
          if (!answer || !chevron) return;
          if (answer.classList.contains('hidden')) {
            answer.classList.remove('hidden');
            chevron.classList.add('rotate-180');
          } else {
            answer.classList.add('hidden');
            chevron.classList.remove('rotate-180');
          }
        });
      });
    });
  </script>
</body>

</html>
