<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Team — D'amour Muslim Admin</title>
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#E91E63">
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Playfair+Display:wght@400;600;700&family=Roboto:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css">
  <style>
    :where([class^="ri-"])::before { content: "\f3c2"; }
    .material-shadow { box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .gradient-bg { background: linear-gradient(135deg, #E91E63 0%, #673AB7 100%); }

    #toast {
      position: fixed; bottom: 1.5rem; right: 1.5rem;
      padding: 0.875rem 1.25rem; border-radius: 0.75rem;
      font-size: 0.875rem; font-weight: 500; color: #fff; z-index: 9999;
      transform: translateY(120%); opacity: 0;
      transition: transform 0.3s ease, opacity 0.3s ease; max-width: 320px;
    }
    #toast.show { transform: translateY(0); opacity: 1; }

    .drop-zone {
      border: 2px dashed #d1d5db;
      transition: border-color 0.2s, background-color 0.2s;
    }
    .drop-zone.dragover { border-color: #E91E63; background-color: #fdf2f8; }

    .member-row { transition: background 0.15s; }
    .member-row:hover { background: #fafafa; }

    .photo-preview {
      width: 80px; height: 80px; border-radius: 50%;
      object-fit: cover; border: 2px solid #e5e7eb;
    }
    .photo-placeholder {
      width: 80px; height: 80px; border-radius: 50%;
      background: #f3f4f6; display: flex; align-items: center; justify-content: center;
      border: 2px solid #e5e7eb;
    }
  </style>
</head>

<body class="bg-gray-50 font-['Roboto']">
  <%- include('../partials/header') %>

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <!-- Page Header -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-1 font-['Playfair_Display']">Team Members</h1>
          <p class="text-gray-500 text-sm">Add and manage team members shown on the <a href="/our-team" target="_blank" class="text-primary hover:underline">/our-team</a> public page.</p>
        </div>
        <a href="/admin/dashboard" class="inline-flex items-center gap-2 px-4 py-2 text-gray-600 hover:text-gray-800 transition-colors text-sm">
          <i class="ri-arrow-left-line"></i> Back to Dashboard
        </a>
      </div>

      <div class="grid lg:grid-cols-5 gap-6">

        <!-- Add Member Form -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-xl material-shadow p-6 sticky top-24">
            <h2 class="text-lg font-semibold text-gray-900 mb-5 flex items-center gap-2">
              <i class="ri-user-add-line text-primary"></i> Add Team Member
            </h2>
            <form id="addMemberForm" enctype="multipart/form-data">

              <!-- Photo Upload -->
              <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 mb-2">Photo <span class="text-gray-400 font-normal">(optional)</span></label>
                <div
                  id="photoDropZone"
                  class="drop-zone rounded-xl p-5 text-center cursor-pointer"
                  onclick="document.getElementById('memberPhoto').click()"
                >
                  <input type="file" id="memberPhoto" name="photo" accept="image/*" class="hidden">
                  <div id="photoDropContent">
                    <div class="photo-placeholder mx-auto mb-2">
                      <i class="ri-user-line text-2xl text-gray-400"></i>
                    </div>
                    <p class="text-sm text-gray-500">Click to upload photo</p>
                    <p class="text-xs text-gray-400">JPG, PNG, WebP · Square recommended</p>
                  </div>
                  <div id="photoPreviewWrapper" class="hidden flex justify-center">
                    <img id="photoPreview" src="" alt="" class="photo-preview mx-auto">
                  </div>
                </div>
              </div>

              <!-- Name -->
              <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Full Name <span class="text-red-500">*</span></label>
                <input type="text" name="name" id="nameInput" maxlength="100" required placeholder="e.g. Aisha Rahman" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none">
              </div>

              <!-- Designation -->
              <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Designation / Role <span class="text-red-500">*</span></label>
                <input type="text" name="designation" id="designationInput" maxlength="150" required placeholder="e.g. Co-Founder &amp; Head of Operations" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none">
              </div>

              <!-- Bio -->
              <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Short Bio <span class="text-gray-400 font-normal">(optional)</span></label>
                <textarea name="bio" id="bioInput" maxlength="500" rows="3" placeholder="A brief description about this team member…" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none resize-none"></textarea>
                <p class="text-xs text-gray-400 mt-1"><span id="bioCount">0</span>/500</p>
              </div>

              <!-- Order -->
              <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 mb-1">Display Order</label>
                <input type="number" name="order" value="0" min="0" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none">
                <p class="text-xs text-gray-400 mt-1">Lower number = shown first</p>
              </div>

              <button type="submit" id="addBtn" class="w-full flex items-center justify-center gap-2 px-5 py-3 gradient-bg text-white rounded-xl font-semibold text-sm hover:opacity-90 transition-opacity disabled:opacity-50">
                <i class="ri-user-add-line"></i>
                <span id="addBtnText">Add Team Member</span>
              </button>
            </form>
          </div>
        </div>

        <!-- Members List -->
        <div class="lg:col-span-3">
          <div class="bg-white rounded-xl material-shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
              <h2 class="text-lg font-semibold text-gray-900">
                All Members
                <span class="ml-2 px-2 py-0.5 bg-gray-100 text-gray-600 text-xs rounded-full font-normal" id="memberCount"><%= members.length %></span>
              </h2>
              <a href="/our-team" target="_blank" class="text-sm text-primary hover:underline flex items-center gap-1">
                <i class="ri-external-link-line"></i> View Public Page
              </a>
            </div>

            <% if (members && members.length > 0) { %>
            <div id="memberList" class="divide-y divide-gray-100">
              <% members.forEach(member => { %>
              <div class="member-row flex gap-4 p-4 items-start" data-id="<%= member._id %>">
                <!-- Photo -->
                <div class="flex-shrink-0">
                  <% if (member.photo && member.photo.url) { %>
                  <img src="<%= member.photo.url %>" alt="<%= member.name %>" class="photo-preview">
                  <% } else { %>
                  <div class="photo-placeholder">
                    <i class="ri-user-line text-xl text-gray-400"></i>
                  </div>
                  <% } %>
                </div>

                <!-- Info -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5">
                    <h3 class="text-sm font-semibold text-gray-900"><%= member.name %></h3>
                    <span class="px-2 py-0.5 text-xs rounded-full font-medium <%= member.isPublished ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600' %>">
                      <%= member.isPublished ? 'Published' : 'Hidden' %>
                    </span>
                  </div>
                  <p class="text-xs font-medium text-primary mb-1"><%= member.designation %></p>
                  <% if (member.bio) { %>
                  <p class="text-xs text-gray-500 line-clamp-2"><%= member.bio %></p>
                  <% } %>
                  <p class="text-xs text-gray-400 mt-1">Order: <%= member.order %> · Added <%= new Date(member.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
                  <div class="flex items-center gap-2 mt-3">
                    <button
                      class="toggle-member-btn px-3 py-1 text-xs rounded-lg font-medium border transition-all duration-200 <%= member.isPublished ? 'border-gray-200 text-gray-600 hover:bg-gray-50' : 'border-green-200 text-green-600 hover:bg-green-50' %>"
                      data-id="<%= member._id %>"
                    >
                      <%= member.isPublished ? 'Hide' : 'Show' %>
                    </button>
                    <button
                      class="delete-member-btn px-3 py-1 text-xs rounded-lg font-medium border border-red-200 text-red-600 hover:bg-red-50 transition-all duration-200"
                      data-id="<%= member._id %>"
                    >
                      <i class="ri-delete-bin-line mr-1"></i>Delete
                    </button>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
            <% } else { %>
            <div id="memberList" class="py-16 text-center">
              <i class="ri-team-line text-5xl text-gray-200 mb-3 block"></i>
              <h3 class="text-lg font-semibold text-gray-500">No team members yet</h3>
              <p class="text-gray-400 text-sm">Add your first team member using the form on the left.</p>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>

  <div id="toast"></div>

  <script>
    const addForm = document.getElementById('addMemberForm');
    const photoInput = document.getElementById('memberPhoto');
    const photoDropZone = document.getElementById('photoDropZone');
    const photoDropContent = document.getElementById('photoDropContent');
    const photoPreviewWrapper = document.getElementById('photoPreviewWrapper');
    const photoPreview = document.getElementById('photoPreview');
    const bioInput = document.getElementById('bioInput');
    const bioCount = document.getElementById('bioCount');
    const addBtn = document.getElementById('addBtn');
    const addBtnText = document.getElementById('addBtnText');
    const memberCount = document.getElementById('memberCount');
    const memberList = document.getElementById('memberList');

    // Bio counter
    bioInput.addEventListener('input', () => { bioCount.textContent = bioInput.value.length; });

    // Photo preview
    photoInput.addEventListener('change', () => {
      const file = photoInput.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = e => {
          photoPreview.src = e.target.result;
          photoDropContent.classList.add('hidden');
          photoPreviewWrapper.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      }
    });

    // Drag & drop for photo
    photoDropZone.addEventListener('dragover', e => { e.preventDefault(); photoDropZone.classList.add('dragover'); });
    photoDropZone.addEventListener('dragleave', () => photoDropZone.classList.remove('dragover'));
    photoDropZone.addEventListener('drop', e => {
      e.preventDefault();
      photoDropZone.classList.remove('dragover');
      const file = e.dataTransfer.files[0];
      if (file && file.type.startsWith('image/')) {
        const dt = new DataTransfer(); dt.items.add(file); photoInput.files = dt.files;
        const reader = new FileReader();
        reader.onload = ev => {
          photoPreview.src = ev.target.result;
          photoDropContent.classList.add('hidden');
          photoPreviewWrapper.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      }
    });

    // Toast helper
    function showToast(msg, type) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.background = type === 'success' ? '#10b981' : type === 'error' ? '#ef4444' : '#3b82f6';
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3500);
    }

    // Add member form submit
    addForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      addBtn.disabled = true;
      addBtnText.textContent = 'Adding…';
      try {
        const fd = new FormData(addForm);
        const res = await fetch('/admin/team', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.success) {
          showToast('Team member added!', 'success');
          addForm.reset();
          bioCount.textContent = '0';
          photoDropContent.classList.remove('hidden');
          photoPreviewWrapper.classList.add('hidden');
          photoPreview.src = '';
          prependMember(data.member);
          memberCount.textContent = parseInt(memberCount.textContent || 0) + 1;
        } else {
          showToast(data.error || 'Failed to add member', 'error');
        }
      } catch(err) {
        showToast('Network error', 'error');
      } finally {
        addBtn.disabled = false;
        addBtnText.textContent = 'Add Team Member';
      }
    });

    function prependMember(member) {
      const photoHtml = (member.photo && member.photo.url)
        ? `<img src="${member.photo.url}" alt="${member.name}" class="photo-preview">`
        : `<div class="photo-placeholder"><i class="ri-user-line text-xl text-gray-400"></i></div>`;
      const bioHtml = member.bio ? `<p class="text-xs text-gray-500 line-clamp-2">${member.bio}</p>` : '';
      const date = new Date(member.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      const html = `
        <div class="member-row flex gap-4 p-4 items-start" data-id="${member._id}">
          <div class="flex-shrink-0">${photoHtml}</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-0.5">
              <h3 class="text-sm font-semibold text-gray-900">${member.name}</h3>
              <span class="px-2 py-0.5 text-xs rounded-full font-medium bg-green-100 text-green-700">Published</span>
            </div>
            <p class="text-xs font-medium text-primary mb-1">${member.designation}</p>
            ${bioHtml}
            <p class="text-xs text-gray-400 mt-1">Order: ${member.order} · Added ${date}</p>
            <div class="flex items-center gap-2 mt-3">
              <button class="toggle-member-btn px-3 py-1 text-xs rounded-lg font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 transition-all duration-200" data-id="${member._id}">Hide</button>
              <button class="delete-member-btn px-3 py-1 text-xs rounded-lg font-medium border border-red-200 text-red-600 hover:bg-red-50 transition-all duration-200" data-id="${member._id}"><i class="ri-delete-bin-line mr-1"></i>Delete</button>
            </div>
          </div>
        </div>`;
      const empty = memberList.querySelector('.py-16');
      if (empty) memberList.innerHTML = '';
      memberList.insertAdjacentHTML('afterbegin', html);
      attachMemberHandlers();
    }

    function attachMemberHandlers() {
      document.querySelectorAll('.toggle-member-btn').forEach(btn => {
        btn.onclick = async function() {
          const id = this.getAttribute('data-id');
          const res = await fetch(`/admin/team/${id}/toggle`, { method: 'PATCH' });
          const data = await res.json();
          if (data.success) {
            const item = this.closest('.member-row');
            const badge = item.querySelector('.bg-green-100, .bg-gray-100');
            const isNow = data.member.isPublished;
            if (badge) {
              badge.className = `px-2 py-0.5 text-xs rounded-full font-medium ${isNow ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'}`;
              badge.textContent = isNow ? 'Published' : 'Hidden';
            }
            this.textContent = isNow ? 'Hide' : 'Show';
            showToast(isNow ? 'Member is now visible' : 'Member is now hidden', 'success');
          } else {
            showToast('Failed to toggle', 'error');
          }
        };
      });

      document.querySelectorAll('.delete-member-btn').forEach(btn => {
        btn.onclick = async function() {
          if (!confirm('Delete this team member? This cannot be undone.')) return;
          const id = this.getAttribute('data-id');
          const res = await fetch(`/admin/team/${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            this.closest('.member-row').remove();
            const count = parseInt(memberCount.textContent || 1) - 1;
            memberCount.textContent = count;
            if (count === 0) {
              memberList.innerHTML = '<div class="py-16 text-center"><i class="ri-team-line text-5xl text-gray-200 mb-3 block"></i><h3 class="text-lg font-semibold text-gray-500">No team members yet</h3></div>';
            }
            showToast('Team member deleted', 'success');
          } else {
            showToast('Failed to delete', 'error');
          }
        };
      });
    }

    attachMemberHandlers();
  </script>
</body>
</html>
