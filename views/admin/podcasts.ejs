<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Podcasts — D'amour Muslim Admin</title>
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#E91E63">
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Playfair+Display:wght@400;600;700&family=Roboto:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css">
  <style>
    :where([class^="ri-"])::before { content: "\f3c2"; }
    .material-shadow { box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .material-shadow-hover { box-shadow: 0 4px 16px rgba(0,0,0,0.15); }
    .gradient-bg { background: linear-gradient(135deg, #E91E63 0%, #673AB7 100%); }

    /* Toast */
    #toast {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      padding: 0.875rem 1.25rem;
      border-radius: 0.75rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: #fff;
      z-index: 9999;
      transform: translateY(120%);
      opacity: 0;
      transition: transform 0.3s ease, opacity 0.3s ease;
      max-width: 320px;
    }
    #toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    /* Preview card */
    .preview-thumb {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      background: #000;
      border-radius: 0.5rem;
      overflow: hidden;
    }
    .preview-thumb img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .preview-thumb .play-badge {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.35);
    }

    /* Podcast item row */
    .podcast-row {
      transition: background 0.15s;
    }
    .podcast-row:hover { background: #fafafa; }
  </style>
</head>

<body class="bg-gray-50 font-['Roboto']">
  <%- include('../partials/header') %>

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <!-- Page Header -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-1 font-['Playfair_Display']">Manage Podcasts</h1>
          <p class="text-gray-500 text-sm">Add YouTube podcast episodes. Paste any YouTube URL or video ID.</p>
        </div>
        <a href="/admin/dashboard" class="inline-flex items-center gap-2 px-4 py-2 text-gray-600 hover:text-gray-800 transition-colors text-sm">
          <i class="ri-arrow-left-line"></i> Back to Dashboard
        </a>
      </div>

      <div class="grid lg:grid-cols-5 gap-6">

        <!-- ===== ADD PODCAST FORM (2 cols) ===== -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-xl material-shadow p-6 sticky top-24">
            <h2 class="text-lg font-semibold text-gray-800 mb-5 font-['Playfair_Display']">Add New Episode</h2>

            <form id="add-podcast-form" class="space-y-4" autocomplete="off">

              <!-- YouTube URL / ID field -->
              <div>
                <label for="youtube-input" class="block text-sm font-medium text-gray-700 mb-1">YouTube URL or Video ID <span class="text-red-500">*</span></label>
                <div class="flex gap-2">
                  <input
                    type="text"
                    id="youtube-input"
                    placeholder="https://youtube.com/watch?v=... or dQw4w9WgXcQ"
                    class="flex-1 px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-400 focus:border-pink-400 outline-none"
                    required
                  />
                  <button
                    type="button"
                    id="fetch-preview-btn"
                    class="px-4 py-2 bg-gray-800 text-white text-sm rounded-lg hover:bg-gray-700 transition-colors whitespace-nowrap"
                  >
                    Preview
                  </button>
                </div>
                <p class="text-xs text-gray-400 mt-1">Supported: full URL, short URL (youtu.be), or 11-char video ID</p>
              </div>

              <!-- Preview area (hidden until fetched) -->
              <div id="preview-area" class="hidden">
                <div class="preview-thumb mb-3">
                  <img id="preview-img" src="" alt="YouTube thumbnail" />
                  <div class="play-badge">
                    <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                  </div>
                </div>
                <a id="preview-link" href="#" target="_blank" rel="noopener noreferrer" class="text-xs text-pink-500 hover:underline flex items-center gap-1 mb-3">
                  <i class="ri-external-link-line"></i> View on YouTube
                </a>
              </div>

              <!-- Title -->
              <div>
                <label for="podcast-title" class="block text-sm font-medium text-gray-700 mb-1">Episode Title <span class="text-red-500">*</span></label>
                <input
                  type="text"
                  id="podcast-title"
                  maxlength="200"
                  placeholder="e.g. How to Find a Muslim Spouse in the UK"
                  class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-400 focus:border-pink-400 outline-none"
                  required
                />
              </div>

              <!-- Description (optional) -->
              <div>
                <label for="podcast-desc" class="block text-sm font-medium text-gray-700 mb-1">Short Description <span class="text-gray-400 font-normal">(optional)</span></label>
                <textarea
                  id="podcast-desc"
                  rows="2"
                  maxlength="500"
                  placeholder="Brief description shown on the podcasts page"
                  class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-400 focus:border-pink-400 outline-none resize-none"
                ></textarea>
              </div>

              <!-- Publish toggle -->
              <div class="flex items-center gap-3">
                <input type="checkbox" id="podcast-published" checked class="w-4 h-4 accent-pink-500 cursor-pointer">
                <label for="podcast-published" class="text-sm text-gray-700 cursor-pointer">Publish immediately (visible on /podcasts)</label>
              </div>

              <!-- Hidden video ID -->
              <input type="hidden" id="podcast-video-id" />

              <button
                type="submit"
                id="add-podcast-btn"
                class="w-full py-2.5 bg-primary text-white font-medium rounded-lg hover:bg-pink-600 transition-colors text-sm disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <span id="add-btn-text">Add Podcast</span>
              </button>
            </form>
          </div>
        </div>

        <!-- ===== PODCAST LIST (3 cols) ===== -->
        <div class="lg:col-span-3">
          <div class="bg-white rounded-xl material-shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
              <h2 class="text-lg font-semibold text-gray-800 font-['Playfair_Display']">
                All Episodes <span id="total-count" class="text-sm font-normal text-gray-400 ml-2">(<%= podcasts.length %> total)</span>
              </h2>
              <a href="/podcasts" target="_blank" rel="noopener noreferrer" class="text-xs text-pink-500 hover:underline flex items-center gap-1">
                <i class="ri-external-link-line"></i> View public page
              </a>
            </div>

            <% if (podcasts.length === 0) { %>
            <div class="px-6 py-16 text-center text-gray-400">
              <i class="ri-video-line text-4xl mb-3 block"></i>
              <p class="font-medium">No podcasts added yet</p>
              <p class="text-sm mt-1">Use the form to add your first episode.</p>
            </div>
            <% } else { %>
            <ul id="podcast-list" class="divide-y divide-gray-100">
              <% podcasts.forEach(function(podcast) { %>
              <li class="podcast-row flex items-center gap-4 px-5 py-4" data-id="<%= podcast._id %>">
                <!-- Thumbnail mini -->
                <a href="https://www.youtube.com/watch?v=<%= podcast.youtubeId %>" target="_blank" rel="noopener noreferrer" class="flex-shrink-0 w-24 rounded-lg overflow-hidden bg-black" style="aspect-ratio:16/9">
                  <img
                    src="https://img.youtube.com/vi/<%= podcast.youtubeId %>/mqdefault.jpg"
                    alt="<%= podcast.title %>"
                    class="w-full h-full object-cover"
                    loading="lazy"
                    onerror="this.src='https://img.youtube.com/vi/<%= podcast.youtubeId %>/default.jpg'"
                  />
                </a>
                <!-- Info -->
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-800 truncate"><%= podcast.title %></p>
                  <p class="text-xs text-gray-400 mt-0.5 font-mono"><%= podcast.youtubeId %></p>
                  <% if (podcast.description) { %>
                  <p class="text-xs text-gray-500 mt-1 line-clamp-1"><%= podcast.description %></p>
                  <% } %>
                </div>
                <!-- Status + actions -->
                <div class="flex-shrink-0 flex items-center gap-3">
                  <span class="text-xs px-2 py-0.5 rounded-full font-medium <%= podcast.isPublished ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
                    <%= podcast.isPublished ? 'Published' : 'Draft' %>
                  </span>
                  <button
                    class="toggle-publish-btn text-xs px-2 py-1 rounded border border-gray-200 text-gray-500 hover:border-pink-300 hover:text-pink-500 transition-colors"
                    data-id="<%= podcast._id %>"
                    data-published="<%= podcast.isPublished %>"
                    title="<%= podcast.isPublished ? 'Unpublish' : 'Publish' %>"
                  >
                    <i class="ri-<%= podcast.isPublished ? 'eye-off' : 'eye' %>-line"></i>
                  </button>
                  <button
                    class="delete-podcast-btn text-xs px-2 py-1 rounded border border-gray-200 text-red-400 hover:border-red-400 hover:bg-red-50 transition-colors"
                    data-id="<%= podcast._id %>"
                    title="Delete"
                  >
                    <i class="ri-delete-bin-line"></i>
                  </button>
                </div>
              </li>
              <% }); %>
            </ul>
            <% } %>
          </div>
        </div>

      </div><!-- /grid -->
    </div>
  </main>

  <!-- Toast notification -->
  <div id="toast"></div>

  <script>
    (function () {
      // ---- Utility ----
      function extractYouTubeId(input) {
        input = input.trim();
        // Full URL patterns
        const patterns = [
          /(?:v=|\/embed\/|\/shorts\/|youtu\.be\/)([A-Za-z0-9_-]{11})/,
          /^([A-Za-z0-9_-]{11})$/
        ];
        for (const re of patterns) {
          const m = input.match(re);
          if (m) return m[1];
        }
        return null;
      }

      function showToast(msg, type) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.style.background = type === 'error' ? '#ef4444' : type === 'warning' ? '#f59e0b' : '#10b981';
        t.classList.add('show');
        setTimeout(function () { t.classList.remove('show'); }, 3500);
      }

      // ---- Preview Button ----
      const fetchBtn = document.getElementById('fetch-preview-btn');
      const youtubeInput = document.getElementById('youtube-input');
      const previewArea = document.getElementById('preview-area');
      const previewImg = document.getElementById('preview-img');
      const previewLink = document.getElementById('preview-link');
      const videoIdField = document.getElementById('podcast-video-id');

      fetchBtn.addEventListener('click', function () {
        const vid = extractYouTubeId(youtubeInput.value);
        if (!vid) {
          showToast('Could not extract a valid YouTube Video ID from that input.', 'error');
          return;
        }
        videoIdField.value = vid;
        // Use maxresdefault; fallback to hqdefault on error
        previewImg.src = 'https://img.youtube.com/vi/' + vid + '/maxresdefault.jpg';
        previewImg.onerror = function () {
          this.src = 'https://img.youtube.com/vi/' + vid + '/hqdefault.jpg';
          this.onerror = null;
        };
        previewLink.href = 'https://www.youtube.com/watch?v=' + vid;
        previewArea.classList.remove('hidden');
        showToast('Preview loaded — fill in the title and save.', 'success');
      });

      // Auto-extract when user pastes/types
      youtubeInput.addEventListener('input', function () {
        const vid = extractYouTubeId(this.value);
        if (vid) videoIdField.value = vid;
        else videoIdField.value = '';
      });

      // ---- Add Podcast Form ----
      const form = document.getElementById('add-podcast-form');
      const addBtn = document.getElementById('add-podcast-btn');
      const addBtnText = document.getElementById('add-btn-text');

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const vid = videoIdField.value.trim() || extractYouTubeId(youtubeInput.value);
        const title = document.getElementById('podcast-title').value.trim();
        const desc = document.getElementById('podcast-desc').value.trim();
        const published = document.getElementById('podcast-published').checked;

        if (!vid) {
          showToast('Please enter a valid YouTube URL or video ID and click Preview.', 'error');
          return;
        }
        if (!title) {
          showToast('Please enter an episode title.', 'error');
          return;
        }

        addBtn.disabled = true;
        addBtnText.textContent = 'Adding...';

        try {
          const res = await fetch('/admin/podcasts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ youtubeId: vid, title: title, description: desc, isPublished: published })
          });
          const data = await res.json();
          if (!res.ok) {
            showToast(data.error || 'Failed to add podcast.', 'error');
            return;
          }
          showToast('Episode added successfully!', 'success');
          // Add to list without reload
          prependToList(data.podcast);
          // Reset form
          form.reset();
          previewArea.classList.add('hidden');
          videoIdField.value = '';
          updateCount(1);
        } catch (err) {
          showToast('Network error — please try again.', 'error');
        } finally {
          addBtn.disabled = false;
          addBtnText.textContent = 'Add Podcast';
        }
      });

      function updateCount(delta) {
        const el = document.getElementById('total-count');
        if (!el) return;
        const m = el.textContent.match(/\d+/);
        const current = m ? parseInt(m[0], 10) : 0;
        el.textContent = '(' + (current + delta) + ' total)';
      }

      function prependToList(podcast) {
        let list = document.getElementById('podcast-list');
        if (!list) {
          // No list yet — rebuild the container
          const container = document.querySelector('.lg\\:col-span-3 .bg-white');
          const emptyEl = container.querySelector('.text-center.py-16');
          if (emptyEl) emptyEl.remove();
          list = document.createElement('ul');
          list.id = 'podcast-list';
          list.className = 'divide-y divide-gray-100';
          container.appendChild(list);
        }
        const li = document.createElement('li');
        li.className = 'podcast-row flex items-center gap-4 px-5 py-4';
        li.setAttribute('data-id', podcast._id);
        li.innerHTML = buildRowHTML(podcast);
        list.prepend(li);
        attachRowHandlers(li);
      }

      function buildRowHTML(p) {
        return '<a href="https://www.youtube.com/watch?v=' + p.youtubeId + '" target="_blank" rel="noopener noreferrer" class="flex-shrink-0 w-24 rounded-lg overflow-hidden bg-black" style="aspect-ratio:16/9">'
          + '<img src="https://img.youtube.com/vi/' + p.youtubeId + '/mqdefault.jpg" alt="' + escHtml(p.title) + '" class="w-full h-full object-cover" loading="lazy" /></a>'
          + '<div class="flex-1 min-w-0">'
          + '<p class="text-sm font-medium text-gray-800 truncate">' + escHtml(p.title) + '</p>'
          + '<p class="text-xs text-gray-400 mt-0.5 font-mono">' + p.youtubeId + '</p>'
          + (p.description ? '<p class="text-xs text-gray-500 mt-1 line-clamp-1">' + escHtml(p.description) + '</p>' : '')
          + '</div>'
          + '<div class="flex-shrink-0 flex items-center gap-3">'
          + '<span class="text-xs px-2 py-0.5 rounded-full font-medium ' + (p.isPublished ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500') + '">' + (p.isPublished ? 'Published' : 'Draft') + '</span>'
          + '<button class="toggle-publish-btn text-xs px-2 py-1 rounded border border-gray-200 text-gray-500 hover:border-pink-300 hover:text-pink-500 transition-colors" data-id="' + p._id + '" data-published="' + p.isPublished + '" title="' + (p.isPublished ? 'Unpublish' : 'Publish') + '"><i class="ri-' + (p.isPublished ? 'eye-off' : 'eye') + '-line"></i></button>'
          + '<button class="delete-podcast-btn text-xs px-2 py-1 rounded border border-gray-200 text-red-400 hover:border-red-400 hover:bg-red-50 transition-colors" data-id="' + p._id + '" title="Delete"><i class="ri-delete-bin-line"></i></button>'
          + '</div>';
      }

      function escHtml(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      // ---- Delete & Toggle handlers ----
      function attachRowHandlers(container) {
        container.querySelectorAll('.delete-podcast-btn').forEach(function (btn) {
          btn.addEventListener('click', handleDelete);
        });
        container.querySelectorAll('.toggle-publish-btn').forEach(function (btn) {
          btn.addEventListener('click', handleToggle);
        });
      }

      // Attach to server-rendered rows
      document.querySelectorAll('.delete-podcast-btn').forEach(function (btn) {
        btn.addEventListener('click', handleDelete);
      });
      document.querySelectorAll('.toggle-publish-btn').forEach(function (btn) {
        btn.addEventListener('click', handleToggle);
      });

      async function handleDelete() {
        const id = this.getAttribute('data-id');
        if (!confirm('Delete this episode? This cannot be undone.')) return;
        try {
          const res = await fetch('/admin/podcasts/' + id, { method: 'DELETE' });
          const data = await res.json();
          if (!res.ok) { showToast(data.error || 'Delete failed.', 'error'); return; }
          const row = document.querySelector('[data-id="' + id + '"]');
          if (row) row.remove();
          updateCount(-1);
          showToast('Episode deleted.', 'success');
        } catch (err) {
          showToast('Network error.', 'error');
        }
      }

      async function handleToggle() {
        const id = this.getAttribute('data-id');
        const currentlyPublished = this.getAttribute('data-published') === 'true';
        try {
          const res = await fetch('/admin/podcasts/' + id + '/toggle', { method: 'PATCH' });
          const data = await res.json();
          if (!res.ok) { showToast(data.error || 'Toggle failed.', 'error'); return; }
          const nowPublished = data.podcast.isPublished;
          // Update badge
          const row = this.closest('[data-id]');
          const badge = row.querySelector('.rounded-full.font-medium');
          if (badge) {
            badge.textContent = nowPublished ? 'Published' : 'Draft';
            badge.className = 'text-xs px-2 py-0.5 rounded-full font-medium ' + (nowPublished ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500');
          }
          this.setAttribute('data-published', nowPublished);
          this.title = nowPublished ? 'Unpublish' : 'Publish';
          this.innerHTML = '<i class="ri-' + (nowPublished ? 'eye-off' : 'eye') + '-line"></i>';
          showToast(nowPublished ? 'Episode published.' : 'Episode unpublished.', 'success');
        } catch (err) {
          showToast('Network error.', 'error');
        }
      }
    })();
  </script>
</body>
</html>
