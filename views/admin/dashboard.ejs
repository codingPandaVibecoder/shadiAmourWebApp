<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#E91E63">
  <title>D'amour Muslim - Admin Dashboard</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Playfair+Display:wght@400;600;700&family=Roboto:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css">
  <style>
    :where([class^="ri-"])::before {
      content: "\f3c2";
    }

    .material-shadow {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .material-shadow-hover {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

    .material-shadow-elevated {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }

    .ripple {
      position: relative;
      overflow: hidden;
    }

    .ripple::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }

    .ripple:active::before {
      width: 300px;
      height: 300px;
    }

    .gradient-bg {
      background: linear-gradient(135deg, #E91E63 0%, #673AB7 100%);
    }

    .stats-filter-card.active {
      border: 2px solid #E91E63;
      box-shadow: 0 4px 16px rgba(233, 30, 99, 0.15);
    }

    .stats-filter-card:hover {
      transform: translateY(-1px);
    }

    /* Table row styling */
    .user-row {
      transition: background-color 0.2s ease;
    }

    .user-row:hover {
      background-color: #f9fafb;
    }

    /* Modal styles */
    .modal-backdrop {
      backdrop-filter: blur(4px);
    }

    .modal-enter {
      animation: modalEnter 0.3s ease-out forwards;
    }

    .modal-exit {
      animation: modalExit 0.2s ease-in forwards;
    }

    @keyframes modalEnter {
      from {
        opacity: 0;
        transform: scale(0.95) translateY(-10px);
      }

      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    @keyframes modalExit {
      from {
        opacity: 1;
        transform: scale(1) translateY(0);
      }

      to {
        opacity: 0;
        transform: scale(0.95) translateY(-10px);
      }
    }

    /* Input focus styling */
    #deleteConfirmationInput:focus {
      outline: none;
      ring: 2px;
      ring-color: rgb(239 68 68);
      border-color: rgb(239 68 68);
    }

    /* Responsive table */
    @media (max-width: 768px) {
      .user-table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
      }
    }

    /* Profile card styles for grid view */
    .profile-card {
      transition: all 0.3s ease;
    }

    .profile-card:hover {
      transform: translateY(-2px);
    }

    /* Slide-out sidebar */
    .sidebar-overlay {
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .sidebar-overlay.active {
      opacity: 1;
      visibility: visible;
    }
    .sidebar-panel {
      transform: translateX(-100%);
      transition: transform 0.3s ease;
    }
    .sidebar-panel.active {
      transform: translateX(0);
    }
  </style>
</head>

<body class="bg-gray-50 font-['Roboto']">
  <!-- Slide-out Sidebar Menu -->
  <div id="sidebarOverlay" class="sidebar-overlay fixed inset-0 bg-black bg-opacity-50 z-[60]"></div>
  <aside id="sidebarPanel" class="sidebar-panel fixed top-0 left-0 h-full w-72 bg-white z-[70] material-shadow-elevated flex flex-col">
    <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-900">Menu</h2>
      <button id="closeSidebarBtn" class="p-1.5 text-gray-500 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition-colors">
        <i class="ri-close-line text-xl"></i>
      </button>
    </div>
    <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
      <a href="/admin/requests" class="flex items-center gap-3 px-4 py-2.5 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors">
        <i class="ri-mail-send-line text-lg text-gray-500"></i>
        <span class="text-sm font-medium">Requests</span>
      </a>
      <a href="/admin/chats" class="flex items-center gap-3 px-4 py-2.5 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors">
        <i class="ri-chat-3-line text-lg text-gray-500"></i>
        <span class="text-sm font-medium">Chats</span>
      </a>
      <% if (isAdmin) { %>
      <a href="/admin/newsletter" class="flex items-center gap-3 px-4 py-2.5 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors">
        <i class="ri-mail-line text-lg text-gray-500"></i>
        <span class="text-sm font-medium">Newsletter</span>
      </a>
      <a href="/admin/blogs" class="flex items-center gap-3 px-4 py-2.5 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors">
        <i class="ri-article-line text-lg text-gray-500"></i>
        <span class="text-sm font-medium">Manage Blogs</span>
      </a>
      <a href="/admin/podcasts" class="flex items-center gap-3 px-4 py-2.5 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors">
        <i class="ri-mic-line text-lg text-gray-500"></i>
        <span class="text-sm font-medium">Manage Podcasts</span>
      </a>
      <a href="/admin/export" class="flex items-center gap-3 px-4 py-2.5 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors">
        <i class="ri-download-2-line text-lg text-gray-500"></i>
        <span class="text-sm font-medium">Export Data</span>
      </a>
      <div class="border-t border-gray-200 my-2"></div>
      <a href="/admin/deletedaccounts" class="flex items-center gap-3 px-4 py-2.5 text-red-600 hover:bg-red-50 rounded-lg transition-colors">
        <i class="ri-delete-bin-line text-lg"></i>
        <span class="text-sm font-medium">Deleted Accounts Record</span>
      </a>
      <% } %>
    </nav>
  </aside>

  <!-- Top Navigation Bar with Search -->
 <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
    <div class="max-w-full mx-auto px-4 py-3">
      <div class="flex items-center justify-between gap-4">
        <!-- Menu Button + Search Bar with Radio Buttons -->
        <div class="flex items-center gap-2 flex-1 max-w-2xl">
          <button id="openSidebarBtn" class="p-2 text-gray-600 hover:bg-gray-100 rounded-lg transition-colors duration-200 flex-shrink-0">
            <i class="ri-menu-line text-xl"></i>
          </button>
          <div class="flex items-center gap-3 flex-1">
            <div class="relative flex-1">
              <input type="text" id="searchInput" placeholder="Search by name..." class="block w-full pl-4 pr-10 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-gray-900 placeholder-gray-400 bg-white text-sm">
              <button id="searchBtn" class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer text-gray-400 hover:text-primary transition-colors">
                <i class="ri-search-line text-lg"></i>
              </button>
            </div>
            <div class="hidden md:flex items-center gap-3 text-sm">
              <label class="flex items-center gap-1 cursor-pointer">
                <input type="radio" name="searchBy" value="name" checked class="accent-pink-500">
                <span class="text-gray-700">Name</span>
              </label>
              <label class="flex items-center gap-1 cursor-pointer">
                <input type="radio" name="searchBy" value="username" class="accent-pink-500">
                <span class="text-gray-700">Username</span>
              </label>
              <label class="flex items-center gap-1 cursor-pointer">
                <input type="radio" name="searchBy" value="phone" class="accent-pink-500">
                <span class="text-gray-700">Phone</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Right side: Add User + View Toggle -->
        <div class="flex items-center gap-3">
          <% if (isAdmin) { %>
          <button id="addUserBtn" class="hidden md:inline-flex px-4 py-2 bg-primary text-white hover:bg-pink-600 transition-all duration-300 rounded-lg text-sm font-medium">
            Add User
          </button>
          <% } %>
          <!-- View Toggle Buttons -->
          <div class="flex border border-gray-300 rounded-lg overflow-hidden">
            <button id="gridViewBtn" class="p-2 bg-white hover:bg-gray-50 text-gray-600 transition-all duration-200" title="Grid View">
              <i class="ri-layout-grid-line text-lg"></i>
            </button>
            <button id="tableViewBtn" class="p-2 bg-gray-100 text-primary border-l border-gray-300 transition-all duration-200" title="Table View">
              <i class="ri-list-check text-lg"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="py-6 min-h-screen">
    <div class="max-w-full mx-auto px-4">
      <!-- Stats Cards Row -->
      <div class="flex flex-wrap gap-4 mb-6">
        <!-- Pending Approval (NEW - Priority) -->
        <div class="bg-white rounded-xl px-6 py-4 material-shadow cursor-pointer hover:material-shadow-hover transition-all duration-300 stats-filter-card flex items-center gap-4 min-w-[160px]" data-filter="pending">
          <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
            <i class="ri-time-line text-lg text-red-600"></i>
          </div>
          <div>
            <p class="text-2xl font-bold text-red-600"><%= stats.pendingCount || 0 %></p>
            <p class="text-xs text-gray-500">Pending Approval</p>
          </div>
        </div>

        <!-- Approved Profiles (NEW) -->
        <div class="bg-white rounded-xl px-6 py-4 material-shadow cursor-pointer hover:material-shadow-hover transition-all duration-300 stats-filter-card flex items-center gap-4 min-w-[160px]" data-filter="approved">
          <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
            <i class="ri-checkbox-circle-line text-lg text-green-600"></i>
          </div>
          <div>
            <p class="text-2xl font-bold text-green-600"><%= stats.approvedCount || 0 %></p>
            <p class="text-xs text-gray-500">Approved</p>
          </div>
        </div>

        <!-- Total Users -->
        <div class="bg-white rounded-xl px-6 py-4 material-shadow cursor-pointer hover:material-shadow-hover transition-all duration-300 stats-filter-card flex items-center gap-4 min-w-[160px]" data-filter="all">
          <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
            <i class="ri-group-line text-lg text-blue-600"></i>
          </div>
          <div>
            <p class="text-2xl font-bold text-gray-900"><%= stats.totalUsers %></p>
            <p class="text-xs text-gray-500">Total Users</p>
          </div>
        </div>

        <!-- By Admin -->
        <div class="bg-white rounded-xl px-6 py-4 material-shadow cursor-pointer hover:material-shadow-hover transition-all duration-300 stats-filter-card flex items-center gap-4 min-w-[160px]" data-filter="admin">
          <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
            <i class="ri-admin-line text-lg text-purple-600"></i>
          </div>
          <div>
            <p class="text-2xl font-bold text-gray-900"><%= stats.registrationSources.byAdmin %></p>
            <p class="text-xs text-gray-500">By Admin</p>
          </div>
        </div>

        <!-- Self Registered -->
        <div class="bg-white rounded-xl px-6 py-4 material-shadow cursor-pointer hover:material-shadow-hover transition-all duration-300 stats-filter-card flex items-center gap-4 min-w-[160px]" data-filter="register">
          <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center">
            <i class="ri-user-add-line text-lg text-orange-600"></i>
          </div>
          <div>
            <p class="text-2xl font-bold text-gray-900"><%= stats.registrationSources.bySelf %></p>
            <p class="text-xs text-gray-500">Self Registered</p>
          </div>
        </div>

        <!-- Featured Profiles -->
        <div class="bg-white rounded-xl px-6 py-4 material-shadow cursor-pointer hover:material-shadow-hover transition-all duration-300 stats-filter-card flex items-center gap-4 min-w-[160px]" data-filter="featured">
          <div class="w-10 h-10 bg-yellow-100 rounded-full flex items-center justify-center">
            <i class="ri-star-fill text-lg text-yellow-500"></i>
          </div>
          <div>
            <p class="text-2xl font-bold text-gray-900"><%= stats.featuredCount %></p>
            <p class="text-xs text-gray-500">Featured Profiles</p>
          </div>
        </div>

        <!-- Employee/Referrer Dropdown -->
        <div class="bg-white rounded-xl px-4 py-3 material-shadow relative flex items-center gap-3 min-w-[200px]">
          <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
            <i class="ri-team-line text-lg text-green-600"></i>
          </div>
          <button id="employeeDropdownBtn" class="flex-1 px-3 py-2 text-left bg-gray-50 border border-gray-200 rounded-lg hover:bg-gray-100 transition-colors duration-200 flex items-center justify-between text-sm">
            <span>Select Employee/Referrer</span>
            <i class="ri-arrow-down-s-line text-gray-500"></i>
          </button>

          <!-- Dropdown Menu -->
          <div id="employeeDropdownMenu" class="absolute top-full left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-lg z-20 hidden max-h-48 overflow-y-auto">
            <% if (uniqueEmployees && uniqueEmployees.length > 0) { %>
            <button class="employee-filter-btn w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-50 border-b border-gray-100" data-filter="all">
              <div class="flex items-center justify-between">
                <span>All Registrations</span>
                <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded-full"><%= stats.totalUsers %></span>
              </div>
            </button>

            <% uniqueEmployees.forEach(employeeName => { %>
            <button class="employee-filter-btn w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-50 border-b border-gray-100 last:border-b-0" data-filter="employee-<%= employeeName %>">
              <div class="flex items-center justify-between">
                <span class="capitalize"><%= employeeName %></span>
                <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded-full">
                  <%= stats.employeeStats[employeeName] || 0 %>
                </span>
              </div>
            </button>
            <% }) %>
            <% } else { %>
            <div class="px-4 py-3 text-sm text-gray-500 text-center">
              No employee referrals found
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- User Management Section -->
      <div class="bg-white rounded-xl material-shadow overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">User Management</h2>
        </div>

        <!-- Filter Indicator (inserted dynamically) -->
        <div id="filter-indicator-container" class="px-6 py-2 hidden">
          <div id="filter-indicator" class="inline-flex items-center gap-2 bg-primary text-white px-4 py-2 rounded-full text-sm"></div>
        </div>

        <!-- Table View -->
        <div id="tableView" class="overflow-x-auto">
          <table class="w-full user-table">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Location</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Username</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Age</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Registered By</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if (users && users.length > 0) { %>
              <% users.forEach(user => { %>
              <tr class="user-row" 
                  data-waliMyContactDetails="<%= user.waliMyContactDetails || '' %>" 
                  data-username="<%= user.username %>" 
                  data-name="<%= user.name || user.username %>" 
                  data-contact="<%= user.contact || '' %>" 
                  data-registration-source="<%= user.registrationSource || 'unknown' %>" 
                  data-featured="<%= user.isFeatured || false %>" 
                  data-passcode="<%= user.passcodeUsed || '' %>"
                  data-approval-status="<%= user.approvalStatus || 'pending' %>">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center gap-2">
                    <div class="text-sm font-medium text-gray-900"><%= user.name || user.username %></div>
                    <% 
                      let approvalBadgeClass = 'bg-yellow-100 text-yellow-700';
                      let approvalText = 'Pending';
                      if (user.approvalStatus === 'approved' || user.isApproved) {
                        approvalBadgeClass = 'bg-green-100 text-green-700';
                        approvalText = 'Approved';
                      } else if (user.approvalStatus === 'rejected') {
                        approvalBadgeClass = 'bg-red-100 text-red-700';
                        approvalText = 'Rejected';
                      }
                    %>
                    <span class="px-2 py-0.5 <%= approvalBadgeClass %> text-xs rounded-full font-medium"><%= approvalText %></span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-600">
                    <% if (user.city && user.country) { %>
                    <%= user.city %>, <%= user.country %>
                    <% } else if (user.city) { %>
                    <%= user.city %>
                    <% } else if (user.country) { %>
                    <%= user.country %>
                    <% } else { %>
                    <span class="text-gray-400">Location not specified</span>
                    <% } %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-600"><%= user.username %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-600"><%= user.age || '-' %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-600"><%= user.email || '-' %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% 
                    let sourceText = 'Unknown';
                    if (user.registrationSource === 'admin') {
                      sourceText = 'by Admin';
                    } else if (user.registrationSource === 'register') {
                      sourceText = 'Self';
                    } else if (user.registrationSource === 'google') {
                      sourceText = 'Google';
                    }
                  %>
                  <div class="text-sm text-gray-600"><%= sourceText %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center gap-2 flex-wrap">
                    <% if (isAdmin) { %>
                      <% if (user.approvalStatus !== 'approved' && !user.isApproved) { %>
                      <button class="approve-btn px-3 py-1.5 bg-green-500 text-white hover:bg-green-600 transition-all duration-300 rounded text-xs font-medium" data-user-id="<%= user._id %>">
                        Approve
                      </button>
                      <% } %>
                    <!-- <button class="delete-btn px-3 py-1.5 bg-red-500 text-white hover:bg-red-600 transition-all duration-300 rounded text-xs font-medium" data-user-id="<%= user._id %>">
                      Delete
                    </button> -->
                    <button class="view-btn px-3 py-1.5 bg-primary text-white hover:bg-pink-600 transition-all duration-300 rounded text-xs font-medium" data-user-id="<%= user._id %>" data-user-slug="<%= user.profileSlug %>">
                      View
                    </button>
                    <% } else if (isModerator) { %>
                    <button class="view-btn px-3 py-1.5 bg-primary text-white hover:bg-pink-600 transition-all duration-300 rounded text-xs font-medium" data-user-id="<%= user._id %>" data-user-slug="<%= user.profileSlug %>">
                      View Profile
                    </button>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% }) %>
              <% } else { %>
              <tr>
                <td colspan="7" class="px-6 py-12 text-center">
                  <div class="flex flex-col items-center">
                    <i class="ri-user-search-line text-5xl text-gray-300 mb-3"></i>
                    <h3 class="text-lg font-semibold text-gray-600 mb-1">No Users Found</h3>
                    <p class="text-gray-500 mb-4">There are currently no users registered in the system.</p>
                    <% if (isAdmin) { %>
                    <button id="addFirstUserBtn" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg hover:bg-pink-600 transition-all duration-300 text-sm">
                      <i class="ri-user-add-line"></i>
                      <span>Add First User</span>
                    </button>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Grid View (Hidden by default) -->
        <div id="gridView" class="p-6 hidden">
          <div id="profileGrid" class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
            <% if (users && users.length > 0) { %>
            <% users.forEach(user => { %>
            <div class="profile-card bg-white rounded-xl md:rounded-2xl overflow-hidden border border-gray-200 hover:shadow-lg" 
                 data-waliMyContactDetails="<%= user.waliMyContactDetails || '' %>" 
                 data-username="<%= user.username %>" 
                 data-name="<%= user.name || user.username %>" 
                 data-contact="<%= user.contact || '' %>" 
                 data-registration-source="<%= user.registrationSource || 'unknown' %>" 
                 data-featured="<%= user.isFeatured || false %>" 
                 data-passcode="<%= user.passcodeUsed || '' %>"
                 data-approval-status="<%= user.approvalStatus || 'pending' %>">
              <div class="aspect-[4/3] overflow-hidden bg-gray-100 relative">
                <% if (user.profilePic && user.profilePic.url) { %>
                <img src="<%= user.profilePic.url %>" class="w-full h-full object-cover" alt="<%= user.name || user.username %>'s Profile">
                <% } else { %>
                <div class="w-full h-full flex items-center justify-center">
                  <% if (user.gender === 'male') { %>
                  <img src="/images/boyavatar.png" class="w-20 h-20 rounded-full object-cover" alt="<%= user.name || user.username %>'s Profile">
                  <% } else { %>
                  <img src="/images/girlavatar.png" class="w-20 h-20 rounded-full object-cover" alt="<%= user.name || user.username %>'s Profile">
                  <% } %>
                </div>
                <% } %>
                <!-- Approval Status Badge on Image -->
                <% 
                  let cardApprovalBadgeClass = 'bg-yellow-500';
                  let cardApprovalText = 'Pending';
                  if (user.approvalStatus === 'approved' || user.isApproved) {
                    cardApprovalBadgeClass = 'bg-green-500';
                    cardApprovalText = 'Approved';
                  } else if (user.approvalStatus === 'rejected') {
                    cardApprovalBadgeClass = 'bg-red-500';
                    cardApprovalText = 'Rejected';
                  }
                %>
                <span class="absolute top-2 left-2 px-2 py-0.5 <%= cardApprovalBadgeClass %> text-white text-xs rounded-full font-medium"><%= cardApprovalText %></span>
              </div>
              <div class="p-4">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-base font-semibold text-gray-900 truncate"><%= user.name || user.username %></h3>
                  <% 
                    let cardSourceText = 'Unknown';
                    let cardSourceClass = 'bg-gray-100 text-gray-600';
                    if (user.registrationSource === 'admin') {
                      cardSourceText = 'by Admin';
                      cardSourceClass = 'bg-purple-100 text-purple-600';
                    } else if (user.registrationSource === 'register') {
                      cardSourceText = 'Self';
                      cardSourceClass = 'bg-orange-100 text-orange-600';
                    } else if (user.registrationSource === 'google') {
                      cardSourceText = 'Google';
                      cardSourceClass = 'bg-blue-100 text-blue-600';
                    }
                  %>
                  <span class="px-2 py-0.5 <%= cardSourceClass %> text-xs rounded-full whitespace-nowrap"><%= cardSourceText %></span>
                </div>
                <div class="text-sm text-gray-500 mb-3">
                  <p class="truncate">@<%= user.username %></p>
                  <% if (user.age) { %><p>Age: <%= user.age %></p><% } %>
                </div>
                <div class="flex flex-col gap-2">
                  <% if (isAdmin) { %>
                    <% if (user.approvalStatus !== 'approved' && !user.isApproved) { %>
                    <div class="flex gap-2">
                      <button class="approve-btn flex-1 px-2 py-1.5 bg-green-500 text-white hover:bg-green-600 transition-all duration-300 rounded text-xs" data-user-id="<%= user._id %>">Approve</button>
                    </div>
                    <% } %>
                  <div class="flex gap-2">
                    <button class="delete-btn flex-1 px-2 py-1.5 bg-red-500 text-white hover:bg-red-600 transition-all duration-300 rounded text-xs" data-user-id="<%= user._id %>">Delete</button>
                    <button class="view-btn flex-1 px-2 py-1.5 bg-primary text-white hover:bg-pink-600 transition-all duration-300 rounded text-xs" data-user-id="<%= user._id %>" data-user-slug="<%= user.profileSlug %>">View</button>
                  </div>
                  <% } else if (isModerator) { %>
                  <button class="view-btn w-full px-2 py-1.5 bg-primary text-white hover:bg-pink-600 transition-all duration-300 rounded text-xs" data-user-id="<%= user._id %>" data-user-slug="<%= user.profileSlug %>">View</button>
                  <% } %>
                </div>
              </div>
            </div>
            <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Pagination -->
        <% if (hasMore) { %>
        <div id="loadMoreContainer" class="flex justify-center py-6">
          <button id="loadMoreBtn" class="flex items-center gap-2 px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition-all duration-300 text-sm font-medium">
            <span>Load More</span>
            <i class="ri-arrow-down-s-line text-lg"></i>
          </button>
        </div>
        <% } else { %>
        <div id="loadMoreContainer" class="flex justify-center py-6 hidden">
          <button id="loadMoreBtn" class="flex items-center gap-2 px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition-all duration-300 text-sm font-medium">
            <span>Load More</span>
            <i class="ri-arrow-down-s-line text-lg"></i>
          </button>
        </div>
        <% } %>
      </div>
    </div>
  </main>

  <!-- Delete Modal -->
  <div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-2xl p-8 max-w-md mx-4 material-shadow-elevated">
      <!-- Modal Header -->
      <div class="text-center mb-6">
        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="ri-error-warning-line text-3xl text-red-500"></i>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-2">Delete User Profile</h3>
        <p class="text-gray-600">This action cannot be undone. All user data will be permanently deleted.</p>
      </div>

      <!-- User Info Display -->
      <div class="bg-gray-50 rounded-lg p-4 mb-6">
        <div class="flex items-center">
          <div class="w-12 h-12 bg-gray-300 rounded-full flex items-center justify-center mr-3">
            <i class="ri-user-line text-xl text-gray-600"></i>
          </div>
          <div>
            <p class="font-semibold text-gray-900" id="deleteModalUserName">User Name</p>
            <p class="text-sm text-gray-500" id="deleteModalUserUsername">@username</p>
          </div>
        </div>
      </div>

      <!-- Confirmation Text -->
      <div class="mb-6">
        <p class="text-sm font-medium text-gray-700 mb-3">Type "delete" below to confirm deletion of this user:</p>
        <input type="text" id="deleteConfirmationInput" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 text-gray-900 placeholder-gray-400" placeholder="Type 'delete' to confirm" autocomplete="off">
        <div id="deleteInputError" class="hidden text-sm text-red-600 mt-2">
          <i class="ri-error-warning-line mr-1"></i>
          Please type "delete" exactly as shown
        </div>
      </div>

      <!-- Modal Buttons -->
      <div class="flex gap-3">
        <button id="cancelDeleteBtn" class="flex-1 px-6 py-3 border-2 border-gray-300 text-gray-700 hover:bg-gray-50 transition-all duration-300 rounded-lg font-medium">
          Cancel
        </button>
        <button id="confirmDeleteBtn" class="flex-1 px-6 py-3 bg-red-500 text-white hover:bg-red-600 transition-all duration-300 rounded-lg font-medium disabled:bg-gray-300 disabled:cursor-not-allowed" disabled>
          <span id="deleteButtonText">Delete This User</span>
          <i id="deleteLoadingIcon" class="ri-loader-4-line animate-spin ml-2 hidden"></i>
        </button>
      </div>
    </div>
  </div>

  <script id="admin-interactions">
    document.addEventListener('DOMContentLoaded', function() {
      // Element declarations
      const searchInput = document.getElementById('searchInput');
      const searchBtn = document.getElementById('searchBtn');
      const statsFilterCards = document.querySelectorAll('.stats-filter-card');
      const deleteModal = document.getElementById('deleteModal');
      const deleteModalUserName = document.getElementById('deleteModalUserName');
      const deleteModalUserUsername = document.getElementById('deleteModalUserUsername');
      const deleteConfirmationInput = document.getElementById('deleteConfirmationInput');
      const deleteInputError = document.getElementById('deleteInputError');
      const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
      const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
      const deleteButtonText = document.getElementById('deleteButtonText');
      const deleteLoadingIcon = document.getElementById('deleteLoadingIcon');
      const gridViewBtn = document.getElementById('gridViewBtn');
      const tableViewBtn = document.getElementById('tableViewBtn');
      const tableView = document.getElementById('tableView');
      const gridView = document.getElementById('gridView');
      const loadMoreBtn = document.getElementById('loadMoreBtn');
      const loadMoreContainer = document.getElementById('loadMoreContainer');

      let currentDeleteUserId = null;
      let currentDeleteElement = null;

      // Pagination state
      let currentPage = 1;
      let currentFilter = 'all';
      let currentSearchBy = '';
      let currentSearchTerm = '';
      let isLoading = false;

      // Helper: get selected search radio
      function getSearchBy() {
        const radio = document.querySelector('input[name="searchBy"]:checked');
        return radio ? radio.value : 'name';
      }

      // Update placeholder based on selected radio
      document.querySelectorAll('input[name="searchBy"]').forEach(radio => {
        radio.addEventListener('change', function() {
          const map = { name: 'Search by name...', username: 'Search by username...', phone: 'Search by phone...' };
          searchInput.placeholder = map[this.value] || 'Search...';
        });
      });

      // Helper: build a table row HTML from user data
      const isAdmin = <%= isAdmin %>;
      const isModerator = <%= isModerator %>;

      function buildTableRowHTML(user) {
        let approvalBadgeClass = 'bg-yellow-100 text-yellow-700';
        let approvalText = 'Pending';
        if (user.approvalStatus === 'approved' || user.isApproved) {
          approvalBadgeClass = 'bg-green-100 text-green-700';
          approvalText = 'Approved';
        } else if (user.approvalStatus === 'rejected') {
          approvalBadgeClass = 'bg-red-100 text-red-700';
          approvalText = 'Rejected';
        }

        let location = '<span class="text-gray-400">Location not specified</span>';
        if (user.city && user.country) location = user.city + ', ' + user.country;
        else if (user.city) location = user.city;
        else if (user.country) location = user.country;

        let sourceText = 'Unknown';
        if (user.registrationSource === 'admin') sourceText = 'by Admin';
        else if (user.registrationSource === 'register') sourceText = 'Self';
        else if (user.registrationSource === 'google') sourceText = 'Google';

        let actionsHTML = '';
        if (isAdmin) {
          if (user.approvalStatus !== 'approved' && !user.isApproved) {
            actionsHTML += '<button class="approve-btn px-3 py-1.5 bg-green-500 text-white hover:bg-green-600 transition-all duration-300 rounded text-xs font-medium" data-user-id="' + user._id + '">Approve</button>';
          }
          actionsHTML += '<button class="view-btn px-3 py-1.5 bg-primary text-white hover:bg-pink-600 transition-all duration-300 rounded text-xs font-medium" data-user-id="' + user._id + '">View</button>';
        } else if (isModerator) {
          actionsHTML += '<button class="view-btn px-3 py-1.5 bg-primary text-white hover:bg-pink-600 transition-all duration-300 rounded text-xs font-medium" data-user-id="' + user._id + '">View Profile</button>';
        }

        return '<tr class="user-row" data-username="' + (user.username || '') + '" data-name="' + (user.name || user.username || '') + '" data-contact="' + (user.contact || '') + '" data-registration-source="' + (user.registrationSource || 'unknown') + '" data-featured="' + (user.isFeatured || false) + '" data-passcode="' + (user.passcodeUsed || '') + '" data-approval-status="' + (user.approvalStatus || 'pending') + '">'
          + '<td class="px-6 py-4 whitespace-nowrap"><div class="flex items-center gap-2"><div class="text-sm font-medium text-gray-900">' + (user.name || user.username || '') + '</div><span class="px-2 py-0.5 ' + approvalBadgeClass + ' text-xs rounded-full font-medium">' + approvalText + '</span></div></td>'
          + '<td class="px-6 py-4 whitespace-nowrap"><div class="text-sm text-gray-600">' + location + '</div></td>'
          + '<td class="px-6 py-4 whitespace-nowrap"><div class="text-sm text-gray-600">' + (user.username || '') + '</div></td>'
          + '<td class="px-6 py-4 whitespace-nowrap"><div class="text-sm text-gray-600">' + (user.age || '-') + '</div></td>'
          + '<td class="px-6 py-4 whitespace-nowrap"><div class="text-sm text-gray-600">' + (user.email || '-') + '</div></td>'
          + '<td class="px-6 py-4 whitespace-nowrap"><div class="text-sm text-gray-600">' + sourceText + '</div></td>'
          + '<td class="px-6 py-4 whitespace-nowrap"><div class="flex items-center gap-2 flex-wrap">' + actionsHTML + '</div></td>'
          + '</tr>';
      }

      function buildCardHTML(user) {
        let cardApprovalBadgeClass = 'bg-yellow-500';
        let cardApprovalText = 'Pending';
        if (user.approvalStatus === 'approved' || user.isApproved) {
          cardApprovalBadgeClass = 'bg-green-500';
          cardApprovalText = 'Approved';
        } else if (user.approvalStatus === 'rejected') {
          cardApprovalBadgeClass = 'bg-red-500';
          cardApprovalText = 'Rejected';
        }

        let imgHTML = '';
        if (user.profilePic && user.profilePic.url) {
          imgHTML = '<img src="' + user.profilePic.url + '" class="w-full h-full object-cover" alt="Profile">';
        } else {
          const avatarSrc = user.gender === 'male' ? '/images/boyavatar.png' : '/images/girlavatar.png';
          imgHTML = '<div class="w-full h-full flex items-center justify-center"><img src="' + avatarSrc + '" class="w-20 h-20 rounded-full object-cover" alt="Profile"></div>';
        }

        let cardSourceText = 'Unknown';
        let cardSourceClass = 'bg-gray-100 text-gray-600';
        if (user.registrationSource === 'admin') { cardSourceText = 'by Admin'; cardSourceClass = 'bg-purple-100 text-purple-600'; }
        else if (user.registrationSource === 'register') { cardSourceText = 'Self'; cardSourceClass = 'bg-orange-100 text-orange-600'; }
        else if (user.registrationSource === 'google') { cardSourceText = 'Google'; cardSourceClass = 'bg-blue-100 text-blue-600'; }

        let buttonsHTML = '';
        if (isAdmin) {
          if (user.approvalStatus !== 'approved' && !user.isApproved) {
            buttonsHTML += '<div class="flex gap-2"><button class="approve-btn flex-1 px-2 py-1.5 bg-green-500 text-white hover:bg-green-600 transition-all duration-300 rounded text-xs" data-user-id="' + user._id + '">Approve</button></div>';
          }
          buttonsHTML += '<div class="flex gap-2"><button class="delete-btn flex-1 px-2 py-1.5 bg-red-500 text-white hover:bg-red-600 transition-all duration-300 rounded text-xs" data-user-id="' + user._id + '">Delete</button><button class="view-btn flex-1 px-2 py-1.5 bg-primary text-white hover:bg-pink-600 transition-all duration-300 rounded text-xs" data-user-id="' + user._id + '">View</button></div>';
        } else if (isModerator) {
          buttonsHTML += '<button class="view-btn w-full px-2 py-1.5 bg-primary text-white hover:bg-pink-600 transition-all duration-300 rounded text-xs" data-user-id="' + user._id + '">View</button>';
        }

        return '<div class="profile-card bg-white rounded-xl md:rounded-2xl overflow-hidden border border-gray-200 hover:shadow-lg" data-username="' + (user.username || '') + '" data-name="' + (user.name || user.username || '') + '" data-contact="' + (user.contact || '') + '" data-registration-source="' + (user.registrationSource || 'unknown') + '" data-featured="' + (user.isFeatured || false) + '" data-passcode="' + (user.passcodeUsed || '') + '" data-approval-status="' + (user.approvalStatus || 'pending') + '">'
          + '<div class="aspect-[4/3] overflow-hidden bg-gray-100 relative">' + imgHTML
          + '<span class="absolute top-2 left-2 px-2 py-0.5 ' + cardApprovalBadgeClass + ' text-white text-xs rounded-full font-medium">' + cardApprovalText + '</span></div>'
          + '<div class="p-4"><div class="flex items-center justify-between mb-2"><h3 class="text-base font-semibold text-gray-900 truncate">' + (user.name || user.username || '') + '</h3><span class="px-2 py-0.5 ' + cardSourceClass + ' text-xs rounded-full whitespace-nowrap">' + cardSourceText + '</span></div>'
          + '<div class="text-sm text-gray-500 mb-3"><p class="truncate">@' + (user.username || '') + '</p>' + (user.age ? '<p>Age: ' + user.age + '</p>' : '') + '</div>'
          + '<div class="flex flex-col gap-2">' + buttonsHTML + '</div></div></div>';
      }

      // Attach event handlers to dynamically added buttons
      function attachButtonHandlers(container) {
        container.querySelectorAll('.view-btn').forEach(btn => {
          btn.addEventListener('click', function() {
            window.location.href = '/admin/user/' + this.getAttribute('data-user-id');
          });
        });
        container.querySelectorAll('.approve-btn').forEach(btn => {
          btn.addEventListener('click', handleApprove);
        });
        container.querySelectorAll('.delete-btn').forEach(btn => {
          btn.addEventListener('click', handleDelete);
        });
      }

      // Load more users via API
      async function loadMoreUsers() {
        if (isLoading) return;
        isLoading = true;
        loadMoreBtn.innerHTML = '<i class="ri-loader-4-line animate-spin text-lg"></i> <span>Loading...</span>';

        try {
          const params = new URLSearchParams({ page: currentPage + 1, filter: currentFilter });
          if (currentSearchTerm && currentSearchBy) {
            params.set('search', currentSearchTerm);
            params.set('searchBy', currentSearchBy);
          }
          const response = await fetch('/api/admin/users?' + params.toString());
          const data = await response.json();

          if (data.success && data.users.length > 0) {
            currentPage = data.page;
            const tableBody = document.querySelector('#tableView tbody');
            const gridContainer = document.getElementById('profileGrid');

            data.users.forEach(user => {
              // Append table row
              const tempRow = document.createElement('tbody');
              tempRow.innerHTML = buildTableRowHTML(user);
              const newRow = tempRow.querySelector('tr');
              tableBody.appendChild(newRow);
              attachButtonHandlers(newRow);

              // Append grid card
              const tempCard = document.createElement('div');
              tempCard.innerHTML = buildCardHTML(user);
              const newCard = tempCard.firstElementChild;
              gridContainer.appendChild(newCard);
              attachButtonHandlers(newCard);
            });

            if (!data.hasMore) {
              loadMoreContainer.classList.add('hidden');
            }
          } else {
            loadMoreContainer.classList.add('hidden');
          }
        } catch (error) {
          console.error('Load more error:', error);
          showNotification('Error', 'Failed to load more users.', 'error');
        } finally {
          isLoading = false;
          loadMoreBtn.innerHTML = '<span>Load More</span><i class="ri-arrow-down-s-line text-lg"></i>';
        }
      }

      // Perform a fresh search/filter (replaces all content)
      async function performSearch(filter, searchBy, searchTerm) {
        if (isLoading) return;
        isLoading = true;
        currentPage = 1;
        currentFilter = filter;
        currentSearchBy = searchBy || '';
        currentSearchTerm = searchTerm || '';

        const tableBody = document.querySelector('#tableView tbody');
        const gridContainer = document.getElementById('profileGrid');

        // Show loading state
        tableBody.innerHTML = '<tr><td colspan="7" class="px-6 py-12 text-center"><i class="ri-loader-4-line animate-spin text-3xl text-gray-400"></i><p class="text-gray-500 mt-2">Loading...</p></td></tr>';
        gridContainer.innerHTML = '<div class="col-span-full text-center py-12"><i class="ri-loader-4-line animate-spin text-3xl text-gray-400"></i><p class="text-gray-500 mt-2">Loading...</p></div>';

        try {
          const params = new URLSearchParams({ page: 1, filter: filter });
          if (searchTerm && searchBy) {
            params.set('search', searchTerm);
            params.set('searchBy', searchBy);
          }
          const response = await fetch('/api/admin/users?' + params.toString());
          const data = await response.json();

          if (data.success) {
            tableBody.innerHTML = '';
            gridContainer.innerHTML = '';

            if (data.users.length > 0) {
              data.users.forEach(user => {
                const tempRow = document.createElement('tbody');
                tempRow.innerHTML = buildTableRowHTML(user);
                const newRow = tempRow.querySelector('tr');
                tableBody.appendChild(newRow);
                attachButtonHandlers(newRow);

                const tempCard = document.createElement('div');
                tempCard.innerHTML = buildCardHTML(user);
                const newCard = tempCard.firstElementChild;
                gridContainer.appendChild(newCard);
                attachButtonHandlers(newCard);
              });

              if (data.hasMore) {
                loadMoreContainer.classList.remove('hidden');
              } else {
                loadMoreContainer.classList.add('hidden');
              }
            } else {
              tableBody.innerHTML = '<tr><td colspan="7" class="px-6 py-12 text-center"><div class="flex flex-col items-center"><i class="ri-user-search-line text-5xl text-gray-300 mb-3"></i><h3 class="text-lg font-semibold text-gray-600 mb-1">No Users Found</h3><p class="text-gray-500">No matching results.</p></div></td></tr>';
              gridContainer.innerHTML = '<div class="col-span-full text-center py-12"><i class="ri-user-search-line text-5xl text-gray-300 mb-3"></i><h3 class="text-lg font-semibold text-gray-600 mb-1">No Users Found</h3></div>';
              loadMoreContainer.classList.add('hidden');
            }

            updateFilterIndicator(filter, data.totalCount);
          }
        } catch (error) {
          console.error('Search error:', error);
          showNotification('Error', 'Failed to search users.', 'error');
        } finally {
          isLoading = false;
        }
      }

      // Load More button
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', loadMoreUsers);
      }

      // Search button click
      if (searchBtn) {
        searchBtn.addEventListener('click', function() {
          const term = searchInput.value.trim();
          if (!term) return;
          const by = getSearchBy();
          // Clear active filter cards
          statsFilterCards.forEach(c => c.classList.remove('ring-2', 'ring-primary', 'active'));
          performSearch('all', by, term);
        });
      }

      // Search on Enter key
      if (searchInput) {
        searchInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            searchBtn.click();
          }
        });
      }

      // Sidebar Menu functionality
      const openSidebarBtn = document.getElementById('openSidebarBtn');
      const closeSidebarBtn = document.getElementById('closeSidebarBtn');
      const sidebarOverlay = document.getElementById('sidebarOverlay');
      const sidebarPanel = document.getElementById('sidebarPanel');

      function openSidebar() {
        sidebarOverlay.classList.add('active');
        sidebarPanel.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      function closeSidebar() {
        sidebarOverlay.classList.remove('active');
        sidebarPanel.classList.remove('active');
        document.body.style.overflow = '';
      }

      if (openSidebarBtn) openSidebarBtn.addEventListener('click', openSidebar);
      if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', closeSidebar);
      if (sidebarOverlay) sidebarOverlay.addEventListener('click', closeSidebar);

      // View Toggle functionality
      if (gridViewBtn && tableViewBtn && tableView && gridView) {
        gridViewBtn.addEventListener('click', function() {
          tableView.classList.add('hidden');
          gridView.classList.remove('hidden');
          gridViewBtn.classList.add('bg-gray-100', 'text-primary');
          gridViewBtn.classList.remove('bg-white', 'text-gray-600');
          tableViewBtn.classList.add('bg-white', 'text-gray-600');
          tableViewBtn.classList.remove('bg-gray-100', 'text-primary');
        });

        tableViewBtn.addEventListener('click', function() {
          gridView.classList.add('hidden');
          tableView.classList.remove('hidden');
          tableViewBtn.classList.add('bg-gray-100', 'text-primary');
          tableViewBtn.classList.remove('bg-white', 'text-gray-600');
          gridViewBtn.classList.add('bg-white', 'text-gray-600');
          gridViewBtn.classList.remove('bg-gray-100', 'text-primary');
        });
      }

      // Navigation buttons
      const addUserBtn = document.getElementById('addUserBtn');
      const addFirstUserBtn = document.getElementById('addFirstUserBtn');
      [addUserBtn, addFirstUserBtn].forEach(btn => {
        if (btn) {
          btn.addEventListener('click', function() {
            window.location.href = '/admin/addUser';
          });
        }
      });

      // View buttons (initial server-rendered)
      const viewButtons = document.querySelectorAll('.view-btn');
      viewButtons.forEach(button => {
        button.addEventListener('click', function() {
          const userId = this.getAttribute('data-user-id');
          window.location.href = '/admin/user/' + userId;
        });
      });

      // Delete handler
      function handleDelete() {
          const userId = this.getAttribute('data-user-id');
          const row = this.closest('.user-row') || this.closest('.profile-card');
          const name = row.getAttribute('data-name');
          const username = row.getAttribute('data-username');

          currentDeleteUserId = userId;
          currentDeleteElement = row;

          deleteModalUserName.textContent = name;
          deleteModalUserUsername.textContent = '@' + username;

          deleteConfirmationInput.value = '';
          confirmDeleteBtn.disabled = true;
          deleteInputError.classList.add('hidden');

          deleteModal.classList.remove('hidden');

          setTimeout(() => {
            deleteConfirmationInput.focus();
          }, 100);
      }

      // Delete buttons (initial)
      const deleteButtons = document.querySelectorAll('.delete-btn');
      deleteButtons.forEach(button => {
        button.addEventListener('click', handleDelete);
      });

      // Modal input validation
      if (deleteConfirmationInput) {
        deleteConfirmationInput.addEventListener('input', function() {
          const value = this.value.trim();
          const isValid = value === 'delete';

          confirmDeleteBtn.disabled = !isValid;

          if (value && !isValid) {
            deleteInputError.classList.remove('hidden');
          } else {
            deleteInputError.classList.add('hidden');
          }
        });
      }

      // Cancel delete modal
      if (cancelDeleteBtn) {
        cancelDeleteBtn.addEventListener('click', function() {
          deleteModal.classList.add('hidden');
          currentDeleteUserId = null;
          currentDeleteElement = null;
        });
      }

      // Confirm delete
      if (confirmDeleteBtn) {
        confirmDeleteBtn.addEventListener('click', async function() {
          if (deleteConfirmationInput.value.trim() !== 'delete') {
            deleteInputError.classList.remove('hidden');
            return;
          }

          if (!currentDeleteUserId || !currentDeleteElement) return;

          this.disabled = true;
          deleteButtonText.textContent = 'Deleting...';
          deleteLoadingIcon.classList.remove('hidden');

          try {
            const response = await fetch('/api/admin/user/' + currentDeleteUserId + '/delete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
            });

            const data = await response.json();

            if (data.success) {
              deleteModal.classList.add('hidden');

              currentDeleteElement.style.transition = 'all 0.3s ease';
              currentDeleteElement.style.opacity = '0';
              currentDeleteElement.style.transform = 'scale(0.95)';

              setTimeout(() => {
                currentDeleteElement.remove();
                showNotification('User Deleted', deleteModalUserName.textContent + "'s profile has been deleted.", 'success');

                const remainingRows = document.querySelectorAll('.user-row');
                const remainingCards = document.querySelectorAll('.profile-card');
                if (remainingRows.length === 0 && remainingCards.length === 0) {
                  setTimeout(() => location.reload(), 1000);
                }
              }, 300);
            } else {
              showNotification('Delete Failed', 'Failed to delete user profile.', 'error');
            }
          } catch (error) {
            console.error('Delete error:', error);
            showNotification('Delete Failed', 'An error occurred while deleting the user.', 'error');
          } finally {
            this.disabled = false;
            deleteButtonText.textContent = 'Delete This User';
            deleteLoadingIcon.classList.add('hidden');
            currentDeleteUserId = null;
            currentDeleteElement = null;
          }
        });
      }

      // Approve handler
      async function handleApprove() {
          const userId = this.getAttribute('data-user-id');
          const row = this.closest('.user-row') || this.closest('.profile-card');
          const name = row.getAttribute('data-name');
          
          if (!confirm('Are you sure you want to approve ' + name + "'s profile?")) return;
          
          this.disabled = true;
          this.textContent = 'Approving...';
          
          try {
            const response = await fetch('/api/admin/user/' + userId + '/approve', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
            });
            
            const data = await response.json();
            
            if (data.success) {
              showNotification('Profile Approved', name + "'s profile has been approved and is now visible.", 'success');
              
              row.setAttribute('data-approval-status', 'approved');
              
              const badgeInRow = row.querySelector('td:first-child span');
              if (badgeInRow) {
                badgeInRow.className = 'px-2 py-0.5 bg-green-100 text-green-700 text-xs rounded-full font-medium';
                badgeInRow.textContent = 'Approved';
              }
              
              const badgeInCard = row.querySelector('.aspect-\\[4\\/3\\] span');
              if (badgeInCard) {
                badgeInCard.className = 'absolute top-2 left-2 px-2 py-0.5 bg-green-500 text-white text-xs rounded-full font-medium';
                badgeInCard.textContent = 'Approved';
              }
              
              this.remove();
            } else {
              showNotification('Approval Failed', data.error || 'Failed to approve profile.', 'error');
              this.disabled = false;
              this.textContent = 'Approve';
            }
          } catch (error) {
            console.error('Approve error:', error);
            showNotification('Approval Failed', 'An error occurred while approving the profile.', 'error');
            this.disabled = false;
            this.textContent = 'Approve';
          }
      }

      // Approve buttons (initial)
      const approveButtons = document.querySelectorAll('.approve-btn');
      approveButtons.forEach(button => {
        button.addEventListener('click', handleApprove);
      });

      // Close modal when clicking outside
      if (deleteModal) {
        deleteModal.addEventListener('click', function(e) {
          if (e.target === this) {
            this.classList.add('hidden');
            currentDeleteUserId = null;
            currentDeleteElement = null;
          }
        });
      }

      // Escape key to close modal
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && deleteModal && !deleteModal.classList.contains('hidden')) {
          deleteModal.classList.add('hidden');
          currentDeleteUserId = null;
          currentDeleteElement = null;
        }
      });

      // Stats filter functionality - now uses server-side filtering
      statsFilterCards.forEach(card => {
        card.addEventListener('click', function() {
          const filter = this.getAttribute('data-filter');

          statsFilterCards.forEach(c => {
            c.classList.remove('ring-2', 'ring-primary', 'active', 'border-2', 'border-primary');
          });
          this.classList.add('ring-2', 'ring-primary', 'active');

          // Clear search input
          searchInput.value = '';

          // Update URL
          const url = new URL(window.location);
          if (filter === 'all') {
            url.searchParams.delete('filter');
          } else {
            url.searchParams.set('filter', filter);
          }
          window.history.replaceState({}, '', url);

          // Perform server-side filtered search
          performSearch(filter, '', '');
        });
      });

      // Filter indicator function
      function updateFilterIndicator(filter, count) {
        const container = document.getElementById('filter-indicator-container');
        const indicator = document.getElementById('filter-indicator');

        if (filter !== 'all' || (currentSearchTerm && currentSearchBy)) {
          let filterText = '';
          let filterIcon = 'ri-filter-line';

          if (currentSearchTerm && currentSearchBy) {
            filterText = 'Search: "' + currentSearchTerm + '" by ' + currentSearchBy;
            filterIcon = 'ri-search-line';
          } else {
            switch (filter) {
              case 'pending':
                filterText = 'Pending Approval';
                filterIcon = 'ri-time-line';
                break;
              case 'approved':
                filterText = 'Approved Profiles';
                filterIcon = 'ri-checkbox-circle-line';
                break;
              case 'admin':
                filterText = 'Admin Added Users';
                filterIcon = 'ri-admin-line';
                break;
              case 'register':
                filterText = 'Self Registered Users';
                filterIcon = 'ri-user-add-line';
                break;
              case 'featured':
                filterText = 'Featured Profiles';
                filterIcon = 'ri-star-fill';
                break;
              default:
                if (filter.startsWith('employee-')) {
                  const employeeName = filter.replace('employee-', '');
                  filterText = 'Registered by ' + employeeName.charAt(0).toUpperCase() + employeeName.slice(1);
                  filterIcon = 'ri-team-line';
                } else {
                  filterText = 'Filtered Results';
                }
                break;
            }
          }

          indicator.innerHTML = '<i class="' + filterIcon + '"></i><span>Showing ' + filterText + ' (' + count + ' users)</span><button onclick="clearFilter()" class="ml-2 hover:bg-white hover:bg-opacity-20 rounded-full p-1 transition-all duration-200"><i class="ri-close-line"></i></button>';
          container.classList.remove('hidden');
        } else {
          container.classList.add('hidden');
        }
      }

      // Global function to clear filter
      window.clearFilter = function() {
        statsFilterCards.forEach(c => c.classList.remove('ring-2', 'ring-primary', 'active'));
        const allCard = document.querySelector('[data-filter="all"]');
        if (allCard) allCard.classList.add('ring-2', 'ring-primary', 'active');

        searchInput.value = '';

        const container = document.getElementById('filter-indicator-container');
        container.classList.add('hidden');

        const url = new URL(window.location);
        url.searchParams.delete('filter');
        window.history.replaceState({}, '', url);

        performSearch('all', '', '');
      };

      // Set initial active filter
      const allCard = document.querySelector('[data-filter="all"]');
      if (allCard) allCard.classList.add('ring-2', 'ring-primary', 'active');

      // Notification function
      function showNotification(title, message, type) {
        type = type || 'info';
        const notification = document.createElement('div');
        const bgColor = type === 'success' ? 'bg-green-500' : type === 'info' ? 'bg-blue-500' : 'bg-red-500';
        const icon = type === 'success' ? 'ri-checkbox-circle-line' : type === 'info' ? 'ri-information-line' : 'ri-error-warning-line';

        notification.className = 'fixed bottom-4 right-4 ' + bgColor + ' text-white rounded-xl p-4 material-shadow-elevated flex items-center gap-3 transform translate-y-0 opacity-100 transition-all duration-300 z-50';
        notification.innerHTML = '<i class="' + icon + ' text-xl"></i><div><p class="font-medium">' + title + '</p><p class="text-sm opacity-90">' + message + '</p></div>';

        document.body.appendChild(notification);

        setTimeout(() => {
          notification.style.transform = 'translateY(100%)';
          notification.style.opacity = '0';
          setTimeout(() => notification.remove(), 300);
        }, 3000);
      }

      // Employee dropdown functionality
      const employeeDropdownBtn = document.getElementById('employeeDropdownBtn');
      const employeeDropdownMenu = document.getElementById('employeeDropdownMenu');
      const employeeFilterBtns = document.querySelectorAll('.employee-filter-btn');

      if (employeeDropdownBtn && employeeDropdownMenu) {
        employeeDropdownBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          employeeDropdownMenu.classList.toggle('hidden');

          const arrow = this.querySelector('i');
          if (employeeDropdownMenu.classList.contains('hidden')) {
            arrow.className = 'ri-arrow-down-s-line text-gray-500';
          } else {
            arrow.className = 'ri-arrow-up-s-line text-gray-500';
          }
        });

        document.addEventListener('click', function(e) {
          if (!employeeDropdownBtn.contains(e.target) && !employeeDropdownMenu.contains(e.target)) {
            employeeDropdownMenu.classList.add('hidden');
            const arrow = employeeDropdownBtn.querySelector('i');
            arrow.className = 'ri-arrow-down-s-line text-gray-500';
          }
        });

        employeeFilterBtns.forEach(btn => {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            const filter = this.getAttribute('data-filter');
            const employeeName = filter === 'all' ? 'All Registrations' :
              filter.replace('employee-', '').charAt(0).toUpperCase() +
              filter.replace('employee-', '').slice(1);

            const buttonText = employeeDropdownBtn.querySelector('span');
            buttonText.textContent = employeeName;

            employeeDropdownMenu.classList.add('hidden');
            const arrow = employeeDropdownBtn.querySelector('i');
            arrow.className = 'ri-arrow-down-s-line text-gray-500';

            statsFilterCards.forEach(c => {
              c.classList.remove('ring-2', 'ring-primary', 'active', 'border-2', 'border-primary');
            });

            searchInput.value = '';

            // Update URL
            const url = new URL(window.location);
            if (filter === 'all') {
              url.searchParams.delete('filter');
            } else {
              url.searchParams.set('filter', filter);
            }
            window.history.replaceState({}, '', url);

            // Perform server-side filtered search
            performSearch(filter, '', '');
          });
        });
      }
    });
  </script>
</body>

</html>