<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Matches Management | D'amour Muslim</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css">
  <style>
    :where([class^="ri-"])::before { content: "\f3c2"; }
    .material-shadow { box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); }
    .material-shadow-hover { box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15); }
    .gradient-bg { background: linear-gradient(135deg, #E91E63 0%, #673AB7 100%); }

    .expandable-row { cursor: pointer; transition: background-color 0.15s ease; }
    .expandable-row:hover { background-color: #f9fafb; }
    .expanded-details { display: none; }
    .expanded-details.open { display: table-row; }
    .rotate-icon { transition: transform 0.2s ease; }
    .rotate-icon.open { transform: rotate(180deg); }

    .score-high { background: #dcfce7; color: #16a34a; border: 2px solid #16a34a; }
    .score-mid { background: #fef3c7; color: #d97706; border: 2px solid #d97706; }
    .score-low { background: #f1f5f9; color: #94a3b8; border: 2px solid #94a3b8; }

    .tab-btn { transition: all 0.2s ease; }
    .tab-btn.active { background: #E91E63; color: white; }
    .tab-btn:not(.active):hover { background: #fdf2f8; color: #E91E63; }

    .subscore-bar { height: 6px; border-radius: 3px; background: #e5e7eb; overflow: hidden; }
    .subscore-bar-fill { height: 100%; border-radius: 3px; transition: width 0.4s ease; }
  </style>
</head>

<body class="bg-gray-50 font-['Roboto']">
  <!-- Top Bar -->
  <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
    <div class="max-w-full mx-auto px-4 py-3">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <a href="/admin/dashboard" class="p-2 text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
            <i class="ri-arrow-left-line text-xl"></i>
          </a>
          <h1 class="text-lg font-bold text-gray-900">Matches Management</h1>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <span class="text-gray-500"><%= isAdmin ? 'Admin' : 'Moderator' %></span>
          <a href="/logout" class="text-red-500 hover:text-red-700 font-medium">Logout</a>
        </div>
      </div>
    </div>
  </header>

  <main class="py-6 min-h-screen">
    <div class="max-w-full mx-auto px-4">

      <!-- Tabs -->
      <div class="flex gap-2 mb-6 flex-wrap">
        <button class="tab-btn active px-5 py-2.5 rounded-lg text-sm font-medium material-shadow" data-tab="search-user">
          <i class="ri-user-search-line mr-1"></i> Search User
        </button>
        <button class="tab-btn px-5 py-2.5 rounded-lg text-sm font-medium border border-gray-200" data-tab="compare">
          <i class="ri-scales-line mr-1"></i> Compare Matches
        </button>
      </div>

      <!-- Tab: Search User & View Matches -->
      <div id="tab-search-user" class="tab-content">
        <!-- Search Bar -->
        <div class="bg-white rounded-xl material-shadow p-4 mb-6">
          <div class="flex items-center gap-3 flex-wrap">
            <div class="relative flex-1 min-w-[250px]">
              <input type="text" id="userSearchInput" placeholder="Search by name, username, or phone..." class="block w-full pl-4 pr-10 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-gray-900 text-sm">
              <button id="userSearchBtn" class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer text-gray-400 hover:text-primary">
                <i class="ri-search-line text-lg"></i>
              </button>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <label class="flex items-center gap-1 cursor-pointer"><input type="radio" name="userSearchBy" value="name" checked class="accent-pink-500"><span class="text-gray-700">Name</span></label>
              <label class="flex items-center gap-1 cursor-pointer"><input type="radio" name="userSearchBy" value="username" class="accent-pink-500"><span class="text-gray-700">Username</span></label>
              <label class="flex items-center gap-1 cursor-pointer"><input type="radio" name="userSearchBy" value="phone" class="accent-pink-500"><span class="text-gray-700">Phone</span></label>
            </div>
          </div>
          <div id="userSearchResults" class="mt-4"></div>
        </div>

        <!-- User Detail & Matches Container -->
        <div id="userMatchesContainer"></div>
      </div>

      <!-- Tab: Compare Two Users -->
      <div id="tab-compare" class="tab-content hidden">
        <div class="bg-white rounded-xl material-shadow p-6 mb-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Compare Match Scores</h2>
          <p class="text-sm text-gray-600 mb-4">Search for two users to compare their compatibility score and see the detailed breakdown.</p>

          <div class="grid md:grid-cols-2 gap-6">
            <!-- User A -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">User A</label>
              <div class="relative">
                <input type="text" id="compareUserASearch" placeholder="Search by name, username, or phone..." class="block w-full pl-4 pr-10 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-sm">
                <button class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-primary" onclick="searchCompareUser('A')">
                  <i class="ri-search-line text-lg"></i>
                </button>
              </div>
              <div id="compareUserAResult" class="mt-2 text-sm"></div>
              <input type="hidden" id="compareUserIdA">
            </div>
            <!-- User B -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">User B</label>
              <div class="relative">
                <input type="text" id="compareUserBSearch" placeholder="Search by name, username, or phone..." class="block w-full pl-4 pr-10 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-sm">
                <button class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-primary" onclick="searchCompareUser('B')">
                  <i class="ri-search-line text-lg"></i>
                </button>
              </div>
              <div id="compareUserBResult" class="mt-2 text-sm"></div>
              <input type="hidden" id="compareUserIdB">
            </div>
          </div>
          <button id="compareBtn" class="mt-4 px-6 py-2.5 bg-primary text-white hover:bg-pink-600 transition-all rounded-lg text-sm font-medium disabled:bg-gray-300 disabled:cursor-not-allowed" disabled>
            <i class="ri-scales-line mr-1"></i> Compare
          </button>
          <div id="compareResults" class="mt-6"></div>
        </div>
      </div>

    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // ── Tab Switching ──────────────────────────────────────────────────────
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabContents = document.querySelectorAll('.tab-content');
      tabBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          tabBtns.forEach(b => { b.classList.remove('active', 'material-shadow'); b.classList.add('border', 'border-gray-200'); });
          this.classList.add('active', 'material-shadow');
          this.classList.remove('border', 'border-gray-200');
          tabContents.forEach(tc => tc.classList.add('hidden'));
          document.getElementById('tab-' + this.dataset.tab).classList.remove('hidden');
        });
      });

      // ── User Search ───────────────────────────────────────────────────────
      const userSearchInput = document.getElementById('userSearchInput');
      const userSearchBtn = document.getElementById('userSearchBtn');

      function getUserSearchBy() {
        const radio = document.querySelector('input[name="userSearchBy"]:checked');
        return radio ? radio.value : 'name';
      }

      userSearchBtn.addEventListener('click', searchUsers);
      userSearchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); searchUsers(); }
      });

      async function searchUsers() {
        const term = userSearchInput.value.trim();
        if (!term) return;
        const by = getUserSearchBy();
        const container = document.getElementById('userSearchResults');
        container.innerHTML = '<div class="text-center py-4"><i class="ri-loader-4-line animate-spin text-2xl text-gray-400"></i><p class="text-sm text-gray-500 mt-2">Searching...</p></div>';

        try {
          const resp = await fetch(`/api/admin/matches/search?term=${encodeURIComponent(term)}&by=${by}`);
          const data = await resp.json();
          if (data.success && data.users.length > 0) {
            container.innerHTML = '<div class="text-xs text-gray-500 mb-2">Found ' + data.users.length + ' user(s). Click to view matches:</div>' +
              data.users.map(u => `
                <button onclick="loadUserMatches('${u._id}')" class="block w-full text-left px-4 py-3 bg-gray-50 hover:bg-pink-50 hover:text-primary rounded-lg mb-1 transition-colors text-sm">
                  <span class="font-medium">${u.name || u.username}</span>
                  <span class="text-gray-500 ml-2">@${u.username}</span>
                  <span class="text-gray-400 ml-2">· ${u.gender || '?'} · ${u.age || '?'}y</span>
                  ${u.email ? `<span class="text-gray-400 ml-2">· ${u.email}</span>` : ''}
                </button>
              `).join('');
          } else {
            container.innerHTML = '<p class="text-sm text-gray-500 text-center py-4">No users found.</p>';
          }
        } catch (err) {
          container.innerHTML = '<p class="text-sm text-red-500 text-center py-4">Search failed. Try again.</p>';
        }
      }

      // ── Load User Matches ─────────────────────────────────────────────────
      window.loadUserMatches = async function(userId) {
        const container = document.getElementById('userMatchesContainer');
        container.innerHTML = '<div class="text-center py-8"><i class="ri-loader-4-line animate-spin text-3xl text-gray-400"></i><p class="text-gray-500 mt-2">Loading matches...</p></div>';

        try {
          const resp = await fetch(`/api/admin/matches/user/${userId}`);
          const data = await resp.json();
          if (!data.success) { container.innerHTML = '<p class="text-red-500 text-center py-4">' + (data.error || 'Failed to load') + '</p>'; return; }

          const user = data.user;
          const matches = data.matches || [];

          // Build user info table
          const userFields = [
            ['Name', user.name || '-'], ['Username', user.username || '-'], ['Age', user.age || '-'],
            ['Gender', user.gender || '-'], ['Email', user.email || '-'], ['Phone', user.contact || '-'],
            ['City', user.city || '-'], ['Country', user.country || '-'], ['Nationality', user.nationality || '-'],
            ['Ethnicity', user.ethnicity || '-'], ['Height', user.height ? (user.height / 30.48).toFixed(1) + ' ft' : '-'],
            ['Marital Status', user.maritalStatus || '-'], ['Islamic Sect', user.islamicSect || '-'],
            ['Preferred Sect', user.preferredIslamicSect || '-'], ['Prays', user.prays != null ? (user.prays ? 'Yes' : 'No') : '-'],
            ['Born Muslim', user.bornMuslim != null ? (user.bornMuslim ? 'Yes' : 'No') : '-'],
            ['Education', user.highestEducation || '-'], ['Work', user.work || '-'],
            ['Tier', user.profileCompletenessTier || '-'], ['Approved', user.isApproved ? 'Yes' : 'No'],
            ['Deactivated', user.isDeactivated ? 'Yes' : 'No'],
          ];

          let html = `
            <div class="bg-white rounded-xl material-shadow p-6 mb-6">
              <h2 class="text-lg font-bold text-gray-900 mb-4">${user.username}'s Profile</h2>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead><tr class="bg-gray-50"><th class="px-4 py-2 text-left font-medium text-gray-600 w-40">Field</th><th class="px-4 py-2 text-left text-gray-900">Value</th></tr></thead>
                  <tbody>${userFields.map(f => `<tr class="border-t border-gray-100"><td class="px-4 py-2 text-gray-500 font-medium">${f[0]}</td><td class="px-4 py-2">${f[1]}</td></tr>`).join('')}</tbody>
                </table>
              </div>
            </div>
          `;

          // Matches section
          html += `
            <div class="bg-white rounded-xl material-shadow p-6">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-bold text-gray-900">${user.username}'s Matches (${matches.length})</h2>
                <div class="flex items-center gap-2">
                  <label class="text-sm text-gray-600">Sort by:</label>
                  <select id="matchSortSelect" onchange="sortMatches()" class="text-sm border border-gray-300 rounded-lg px-3 py-1.5">
                    <option value="score-desc">Score ↓</option>
                    <option value="score-asc">Score ↑</option>
                    <option value="name-asc">Name A-Z</option>
                  </select>
                </div>
              </div>
          `;

          if (matches.length === 0) {
            html += '<p class="text-gray-500 text-center py-8">No matches computed for this user yet.</p>';
          } else {
            html += `<div id="matchesList">${buildMatchesHTML(matches)}</div>`;
          }

          html += '</div>';
          container.innerHTML = html;
          window._currentMatches = matches;
          window._currentUserId = userId;
        } catch (err) {
          container.innerHTML = '<p class="text-red-500 text-center py-4">Failed to load matches.</p>';
        }
      };

      function buildMatchesHTML(matches) {
        return matches.map((m, i) => {
          const v = m.viewee || {};
          const score = m.finalScore || 0;
          let scoreClass = 'score-low';
          if (score >= 70) scoreClass = 'score-high';
          else if (score >= 50) scoreClass = 'score-mid';

          const mainFields = [
            ['Name', v.name || '-'], ['Username', v.username || '-'], ['Age', v.age || '-'],
            ['Gender', v.gender || '-'], ['Email', v.email || '-'],
          ];
          const extraFields = [
            ['Phone', v.contact || '-'], ['City', v.city || '-'], ['Country', v.country || '-'],
            ['Nationality', v.nationality || '-'], ['Ethnicity', v.ethnicity || '-'],
            ['Height', v.height ? (v.height / 30.48).toFixed(1) + ' ft' : '-'],
            ['Marital Status', v.maritalStatus || '-'], ['Islamic Sect', v.islamicSect || '-'],
            ['Preferred Sect', v.preferredIslamicSect || '-'], ['Education', v.highestEducation || '-'],
            ['Work', v.work || '-'], ['Tier', v.profileCompletenessTier || '-'],
          ];

          const sub = m.subScores || {};
          const scoreDetails = buildScoreDissection(sub, m.pointsEarned, m.pointsAvailable, score);

          return `
            <div class="border border-gray-200 rounded-xl mb-4 overflow-hidden">
              <!-- Match Header -->
              <div class="flex items-center gap-4 p-4 bg-gray-50 cursor-pointer" onclick="toggleMatchExpand(${i})">
                <div class="flex items-center gap-3 flex-1 min-w-0">
                  <span class="w-10 h-10 rounded-full ${scoreClass} flex items-center justify-center font-bold text-sm flex-shrink-0">${score}%</span>
                  <div class="min-w-0">
                    <span class="font-semibold text-gray-900">${v.username || 'Unknown'}</span>
                    <span class="text-gray-500 text-sm ml-2">${v.age ? v.age + 'y' : ''} · ${v.city || v.country || ''}</span>
                  </div>
                </div>
                <i id="matchChevron${i}" class="ri-arrow-down-s-line text-gray-400 text-lg rotate-icon transition-transform"></i>
              </div>
              <!-- Expandable Details -->
              <div id="matchDetails${i}" class="hidden">
                <!-- Match Profile Fields -->
                <div class="p-4 border-t border-gray-200">
                  <h4 class="text-sm font-semibold text-gray-700 mb-3">Profile Details</h4>
                  <table class="w-full text-sm">
                    <tbody>
                      ${mainFields.map(f => `<tr class="border-t border-gray-50"><td class="px-3 py-1.5 text-gray-500 w-32">${f[0]}</td><td class="px-3 py-1.5">${f[1]}</td></tr>`).join('')}
                      ${extraFields.map(f => `<tr class="border-t border-gray-50"><td class="px-3 py-1.5 text-gray-500 w-32">${f[0]}</td><td class="px-3 py-1.5">${f[1]}</td></tr>`).join('')}
                    </tbody>
                  </table>
                </div>
                <!-- Score Dissection -->
                <div class="p-4 border-t border-gray-200 bg-gray-50">
                  <h4 class="text-sm font-semibold text-gray-700 mb-3">Score Dissection</h4>
                  ${scoreDetails}
                  <div class="mt-3 text-xs text-gray-500">
                    Computed: ${m.computedAt ? new Date(m.computedAt).toLocaleString() : 'N/A'}
                    ${m.pointsAvailable < 90 ? ' · <span class="text-amber-600">Partial profile match (scored on ' + m.pointsAvailable + ' of 100 points)</span>' : ''}
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      function buildScoreDissection(subScores, pointsEarned, pointsAvailable, finalScore) {
        const categories = [
          { key: 'islamic', label: 'Islamic Compatibility', max: 30 },
          { key: 'age', label: 'Age Compatibility', max: 15 },
          { key: 'height', label: 'Height Compatibility', max: 10 },
          { key: 'maritalFamily', label: 'Marital/Family Alignment', max: 10 },
          { key: 'location', label: 'Location & Openness', max: 15 },
          { key: 'nationalityEthnicity', label: 'Nationality/Ethnicity', max: 10 },
          { key: 'education', label: 'Education', max: 10 },
        ];

        let html = '<div class="space-y-2">';
        categories.forEach(cat => {
          const s = subScores[cat.key] || { earned: 0, available: 0 };
          const pct = s.available > 0 ? Math.round((s.earned / cat.max) * 100) : 0;
          const barColor = pct >= 80 ? '#16a34a' : pct >= 40 ? '#d97706' : '#94a3b8';
          const excluded = s.available === 0;
          html += `
            <div class="flex items-center gap-3">
              <span class="text-xs text-gray-600 w-40 flex-shrink-0">${cat.label}</span>
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <div class="subscore-bar flex-1">
                    <div class="subscore-bar-fill" style="width:${excluded ? 0 : pct}%; background:${barColor};"></div>
                  </div>
                  <span class="text-xs ${excluded ? 'text-gray-400 italic' : 'text-gray-700'} w-16 text-right">${excluded ? 'excluded' : s.earned + '/' + cat.max}</span>
                </div>
              </div>
            </div>
          `;
        });
        html += `
          <div class="flex items-center gap-3 pt-2 border-t border-gray-200 mt-2">
            <span class="text-xs font-bold text-gray-700 w-40">Total</span>
            <span class="text-sm font-bold text-primary">${pointsEarned}/${pointsAvailable} = ${finalScore}%</span>
          </div>`;
        html += '</div>';
        return html;
      }

      window.toggleMatchExpand = function(idx) {
        const details = document.getElementById('matchDetails' + idx);
        const chevron = document.getElementById('matchChevron' + idx);
        details.classList.toggle('hidden');
        chevron.classList.toggle('open');
      };

      window.sortMatches = function() {
        const sortBy = document.getElementById('matchSortSelect').value;
        const matches = window._currentMatches || [];
        let sorted;
        switch (sortBy) {
          case 'score-desc': sorted = [...matches].sort((a, b) => (b.finalScore || 0) - (a.finalScore || 0)); break;
          case 'score-asc': sorted = [...matches].sort((a, b) => (a.finalScore || 0) - (b.finalScore || 0)); break;
          case 'name-asc': sorted = [...matches].sort((a, b) => ((a.viewee && a.viewee.username) || '').localeCompare((b.viewee && b.viewee.username) || '')); break;
          default: sorted = matches;
        }
        document.getElementById('matchesList').innerHTML = buildMatchesHTML(sorted);
      };

      // ── Compare Two Users ─────────────────────────────────────────────────
      window.searchCompareUser = async function(slot) {
        const input = document.getElementById('compareUser' + slot + 'Search');
        const resultDiv = document.getElementById('compareUser' + slot + 'Result');
        const hiddenInput = document.getElementById('compareUserId' + slot);
        const term = input.value.trim();
        if (!term) return;

        resultDiv.innerHTML = '<span class="text-gray-400"><i class="ri-loader-4-line animate-spin mr-1"></i>Searching...</span>';

        try {
          const resp = await fetch(`/api/admin/matches/search?term=${encodeURIComponent(term)}&by=name`);
          const data = await resp.json();
          if (data.success && data.users.length > 0) {
            resultDiv.innerHTML = data.users.slice(0, 5).map(u => `
              <button onclick="selectCompareUser('${slot}', '${u._id}', '${(u.name || u.username).replace(/'/g, "\\'")}')" class="block w-full text-left px-3 py-1.5 hover:bg-pink-50 hover:text-primary rounded text-sm">
                ${u.name || u.username} (@${u.username}) · ${u.gender || '?'} · ${u.age || '?'}y
              </button>
            `).join('');
          } else {
            resultDiv.innerHTML = '<span class="text-gray-500 text-sm">No users found.</span>';
          }
        } catch (err) {
          resultDiv.innerHTML = '<span class="text-red-500 text-sm">Search failed.</span>';
        }
      };

      window.selectCompareUser = function(slot, userId, displayName) {
        document.getElementById('compareUserId' + slot).value = userId;
        document.getElementById('compareUser' + slot + 'Search').value = displayName;
        document.getElementById('compareUser' + slot + 'Result').innerHTML = '<span class="text-green-600 text-sm"><i class="ri-check-line"></i> Selected: ' + displayName + '</span>';
        checkCompareReady();
      };

      function checkCompareReady() {
        const btn = document.getElementById('compareBtn');
        btn.disabled = !(document.getElementById('compareUserIdA').value && document.getElementById('compareUserIdB').value);
      }

      document.getElementById('compareBtn').addEventListener('click', async function() {
        const idA = document.getElementById('compareUserIdA').value;
        const idB = document.getElementById('compareUserIdB').value;
        if (!idA || !idB) return;

        const container = document.getElementById('compareResults');
        container.innerHTML = '<div class="text-center py-6"><i class="ri-loader-4-line animate-spin text-3xl text-gray-400"></i><p class="text-gray-500 mt-2">Computing comparison...</p></div>';

        try {
          const resp = await fetch(`/api/admin/matches/compare?a=${idA}&b=${idB}`);
          const data = await resp.json();
          if (!data.success) { container.innerHTML = '<p class="text-red-500 text-center">' + (data.error || 'Comparison failed') + '</p>'; return; }

          const score = data.score || {};
          const uA = data.userA || {};
          const uB = data.userB || {};

          container.innerHTML = `
            <div class="border border-gray-200 rounded-xl overflow-hidden">
              <div class="grid grid-cols-3 gap-0">
                <div class="p-4 bg-gray-50 border-r border-gray-200 text-center">
                  <div class="font-bold text-gray-900">${uA.username || 'User A'}</div>
                  <div class="text-xs text-gray-500">${uA.age || '?'}y · ${uA.city || '?'}</div>
                </div>
                <div class="p-4 bg-pink-50 text-center flex items-center justify-center">
                  <div>
                    <div class="text-2xl font-bold text-primary">${score.finalScore != null ? score.finalScore + '%' : 'N/A'}</div>
                    <div class="text-xs text-gray-500">Compatibility</div>
                  </div>
                </div>
                <div class="p-4 bg-gray-50 border-l border-gray-200 text-center">
                  <div class="font-bold text-gray-900">${uB.username || 'User B'}</div>
                  <div class="text-xs text-gray-500">${uB.age || '?'}y · ${uB.city || '?'}</div>
                </div>
              </div>
              <div class="p-4 border-t border-gray-200">
                <h4 class="text-sm font-semibold text-gray-700 mb-3">Score Dissection</h4>
                ${score.subScores ? buildScoreDissection(score.subScores, score.pointsEarned || 0, score.pointsAvailable || 0, score.finalScore || 0) : '<p class="text-sm text-gray-500">No score data available between these users.</p>'}
              </div>
              ${score.finalScore == null ? `
              <div class="p-4 border-t border-gray-200 bg-amber-50">
                <p class="text-sm text-amber-700"><i class="ri-information-line mr-1"></i> These two users have no precomputed score. They may not have passed hard filters, or scores haven't been generated yet.</p>
              </div>` : ''}
            </div>
          `;
        } catch (err) {
          container.innerHTML = '<p class="text-red-500 text-center py-4">Comparison failed.</p>';
        }
      });

      // Enter key for compare search inputs
      ['A', 'B'].forEach(slot => {
        const input = document.getElementById('compareUser' + slot + 'Search');
        if (input) {
          input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); searchCompareUser(slot); }
          });
        }
      });
    });
  </script>
</body>

</html>
