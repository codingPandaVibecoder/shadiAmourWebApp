<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Ad Media — D'amour Muslim Admin</title>
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#E91E63">
  <link rel="stylesheet" href="/css/output.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css">
  <style>
    :where([class^="ri-"])::before { content: "\f3c2"; }
    .material-shadow { box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .material-shadow-hover { box-shadow: 0 4px 16px rgba(0,0,0,0.15); }
    .gradient-bg { background: linear-gradient(135deg, #E91E63 0%, #673AB7 100%); }

    #toast {
      position: fixed; bottom: 1.5rem; right: 1.5rem;
      padding: 0.875rem 1.25rem; border-radius: 0.75rem;
      font-size: 0.875rem; font-weight: 500; color: #fff; z-index: 9999;
      transform: translateY(120%); opacity: 0;
      transition: transform 0.3s ease, opacity 0.3s ease; max-width: 320px;
    }
    #toast.show { transform: translateY(0); opacity: 1; }

    .drop-zone {
      border: 2px dashed #d1d5db;
      transition: border-color 0.2s, background-color 0.2s;
    }
    .drop-zone.dragover { border-color: #E91E63; background-color: #fdf2f8; }

    .media-thumb {
      aspect-ratio: 16/9;
      background: #f3f4f6;
      border-radius: 0.5rem;
      overflow: hidden;
      position: relative;
    }
    .media-thumb img, .media-thumb video { width: 100%; height: 100%; object-fit: cover; }

    .ad-item { transition: background 0.15s; }
    .ad-item:hover { background: #fafafa; }

    .upload-progress {
      height: 4px; background: #e5e7eb; border-radius: 2px; overflow: hidden; margin-top: 0.5rem;
    }
    .upload-progress-bar {
      height: 100%; width: 0; background: linear-gradient(135deg, #E91E63, #673AB7);
      border-radius: 2px; transition: width 0.3s;
    }
  </style>
</head>

<body class="bg-gray-50 font-['Roboto']">
  <%- include('../partials/header') %>

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <!-- Page Header -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-1 font-['Playfair_Display']">Ad Pictures &amp; Media</h1>
          <p class="text-gray-500 text-sm">Upload images and videos to display on the <a href="/our-ads" target="_blank" class="text-primary hover:underline">/our-ads</a> public page.</p>
        </div>
        <a href="/admin/dashboard" class="inline-flex items-center gap-2 px-4 py-2 text-gray-600 hover:text-gray-800 transition-colors text-sm">
          <i class="ri-arrow-left-line"></i> Back to Dashboard
        </a>
      </div>

      <div class="grid lg:grid-cols-5 gap-6">

        <!-- Upload Form -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-xl material-shadow p-6 sticky top-24">
            <h2 class="text-lg font-semibold text-gray-900 mb-5 flex items-center gap-2">
              <i class="ri-upload-cloud-2-line text-primary"></i> Upload Media
            </h2>
            <form id="uploadForm" enctype="multipart/form-data">
              <!-- Drop Zone -->
              <div
                id="dropZone"
                class="drop-zone rounded-xl p-8 text-center cursor-pointer mb-5"
                onclick="document.getElementById('mediaFile').click()"
              >
                <input type="file" id="mediaFile" name="media" accept="image/*,video/*" class="hidden" required>
                <div id="dropZoneContent">
                  <i class="ri-image-video-line text-4xl text-gray-300 mb-3 block"></i>
                  <p class="text-gray-600 font-medium">Click or drag &amp; drop</p>
                  <p class="text-gray-400 text-sm mt-1">Images (JPG, PNG, WebP) or Videos (MP4, MOV, WebM)</p>
                  <p class="text-gray-400 text-xs mt-1">Max 100 MB</p>
                </div>
                <!-- Preview -->
                <div id="filePreview" class="hidden">
                  <div class="media-thumb mb-3">
                    <img id="previewImage" src="" alt="" class="hidden">
                    <video id="previewVideo" class="hidden" muted></video>
                  </div>
                  <p id="previewFileName" class="text-sm text-gray-600 truncate"></p>
                </div>
              </div>

              <!-- Upload progress -->
              <div id="uploadProgressWrapper" class="hidden mb-4">
                <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
                  <span>Uploading…</span>
                  <span id="uploadPercent">0%</span>
                </div>
                <div class="upload-progress">
                  <div class="upload-progress-bar" id="uploadProgressBar"></div>
                </div>
              </div>

              <!-- Caption -->
              <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Caption <span class="text-gray-400 font-normal">(optional)</span></label>
                <input type="text" name="caption" id="captionInput" maxlength="200" placeholder="e.g. Spring 2025 Campaign" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none">
                <p class="text-xs text-gray-400 mt-1"><span id="captionCount">0</span>/200</p>
              </div>

              <!-- Display Order -->
              <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 mb-1">Display Order</label>
                <input type="number" name="order" value="0" min="0" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none">
                <p class="text-xs text-gray-400 mt-1">Lower number = shown first</p>
              </div>

              <button type="submit" id="uploadBtn" class="w-full flex items-center justify-center gap-2 px-5 py-3 gradient-bg text-white rounded-xl font-semibold text-sm hover:opacity-90 transition-opacity disabled:opacity-50">
                <i class="ri-upload-cloud-2-line"></i>
                <span id="uploadBtnText">Upload Media</span>
              </button>
            </form>
          </div>
        </div>

        <!-- Media List -->
        <div class="lg:col-span-3">
          <div class="bg-white rounded-xl material-shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
              <h2 class="text-lg font-semibold text-gray-900">
                All Media
                <span class="ml-2 px-2 py-0.5 bg-gray-100 text-gray-600 text-xs rounded-full font-normal" id="mediaCount"><%= ads.length %></span>
              </h2>
              <a href="/our-ads" target="_blank" class="text-sm text-primary hover:underline flex items-center gap-1">
                <i class="ri-external-link-line"></i> View Public Page
              </a>
            </div>

            <% if (ads && ads.length > 0) { %>
            <div id="mediaList" class="divide-y divide-gray-100">
              <% ads.forEach(ad => { %>
              <div class="ad-item flex gap-4 p-4 items-start" data-id="<%= ad._id %>">
                <!-- Thumbnail -->
                <div class="media-thumb w-28 flex-shrink-0">
                  <% if (ad.mediaType === 'image') { %>
                  <img src="<%= ad.url %>" alt="<%= ad.caption || 'Ad image' %>" class="rounded-lg">
                  <% } else { %>
                  <div class="w-full h-full bg-gray-900 rounded-lg flex items-center justify-center relative">
                    <video class="w-full h-full object-cover opacity-60" muted preload="none">
                      <source src="<%= ad.url %>" type="video/mp4">
                    </video>
                    <i class="ri-play-circle-line text-white text-3xl absolute"></i>
                  </div>
                  <% } %>
                </div>

                <!-- Info -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap mb-1">
                    <span class="px-2 py-0.5 text-xs rounded-full font-medium <%= ad.mediaType === 'image' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700' %>">
                      <i class="ri-<%= ad.mediaType === 'image' ? 'image' : 'video' %>-line mr-0.5"></i>
                      <%= ad.mediaType %>
                    </span>
                    <span class="px-2 py-0.5 text-xs rounded-full font-medium <%= ad.isPublished ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600' %>">
                      <%= ad.isPublished ? 'Published' : 'Hidden' %>
                    </span>
                  </div>
                  <p class="text-sm text-gray-700 truncate"><%= ad.caption || '<span class="text-gray-400">No caption</span>' %></p>
                  <p class="text-xs text-gray-400 mt-1">Order: <%= ad.order %> · Added <%= new Date(ad.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
                  <div class="flex items-center gap-2 mt-3">
                    <button
                      class="toggle-btn px-3 py-1 text-xs rounded-lg font-medium border transition-all duration-200 <%= ad.isPublished ? 'border-gray-200 text-gray-600 hover:bg-gray-50' : 'border-green-200 text-green-600 hover:bg-green-50' %>"
                      data-id="<%= ad._id %>"
                    >
                      <%= ad.isPublished ? 'Hide' : 'Show' %>
                    </button>
                    <button
                      class="delete-btn px-3 py-1 text-xs rounded-lg font-medium border border-red-200 text-red-600 hover:bg-red-50 transition-all duration-200"
                      data-id="<%= ad._id %>"
                    >
                      <i class="ri-delete-bin-line mr-1"></i>Delete
                    </button>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
            <% } else { %>
            <div id="mediaList" class="py-16 text-center">
              <i class="ri-image-line text-5xl text-gray-200 mb-3 block"></i>
              <h3 class="text-lg font-semibold text-gray-500">No media uploaded yet</h3>
              <p class="text-gray-400 text-sm">Upload your first image or video using the form on the left.</p>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>

  <div id="toast"></div>

  <script>
    const form = document.getElementById('uploadForm');
    const fileInput = document.getElementById('mediaFile');
    const dropZone = document.getElementById('dropZone');
    const dropZoneContent = document.getElementById('dropZoneContent');
    const filePreview = document.getElementById('filePreview');
    const previewImage = document.getElementById('previewImage');
    const previewVideo = document.getElementById('previewVideo');
    const previewFileName = document.getElementById('previewFileName');
    const uploadBtn = document.getElementById('uploadBtn');
    const uploadBtnText = document.getElementById('uploadBtnText');
    const captionInput = document.getElementById('captionInput');
    const captionCount = document.getElementById('captionCount');
    const uploadProgressWrapper = document.getElementById('uploadProgressWrapper');
    const uploadProgressBar = document.getElementById('uploadProgressBar');
    const uploadPercent = document.getElementById('uploadPercent');
    const mediaCount = document.getElementById('mediaCount');
    const mediaList = document.getElementById('mediaList');

    // Caption counter
    captionInput.addEventListener('input', () => {
      captionCount.textContent = captionInput.value.length;
    });

    // File selection preview
    function handleFileSelect(file) {
      if (!file) return;
      previewFileName.textContent = file.name;
      dropZoneContent.classList.add('hidden');
      filePreview.classList.remove('hidden');
      if (file.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = e => { previewImage.src = e.target.result; previewImage.classList.remove('hidden'); previewVideo.classList.add('hidden'); };
        reader.readAsDataURL(file);
      } else if (file.type.startsWith('video/')) {
        const url = URL.createObjectURL(file);
        previewVideo.src = url;
        previewVideo.classList.remove('hidden');
        previewImage.classList.add('hidden');
      }
    }

    fileInput.addEventListener('change', () => { if (fileInput.files[0]) handleFileSelect(fileInput.files[0]); });

    // Drag & drop
    dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop', e => {
      e.preventDefault();
      dropZone.classList.remove('dragover');
      const file = e.dataTransfer.files[0];
      if (file) { const dt = new DataTransfer(); dt.items.add(file); fileInput.files = dt.files; handleFileSelect(file); }
    });

    // Toast helper
    function showToast(msg, type) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.background = type === 'success' ? '#10b981' : type === 'error' ? '#ef4444' : '#3b82f6';
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3500);
    }

    // Upload form submit (XHR for progress)
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      if (!fileInput.files[0]) { showToast('Please select a file to upload', 'error'); return; }
      const fd = new FormData(form);
      uploadBtn.disabled = true;
      uploadBtnText.textContent = 'Uploading…';
      uploadProgressWrapper.classList.remove('hidden');

      const xhr = new XMLHttpRequest();
      xhr.open('POST', '/admin/ads', true);

      xhr.upload.onprogress = function(e) {
        if (e.lengthComputable) {
          const pct = Math.round((e.loaded / e.total) * 100);
          uploadProgressBar.style.width = pct + '%';
          uploadPercent.textContent = pct + '%';
        }
      };

      xhr.onload = function() {
        uploadBtn.disabled = false;
        uploadBtnText.textContent = 'Upload Media';
        uploadProgressWrapper.classList.add('hidden');
        uploadProgressBar.style.width = '0';
        uploadPercent.textContent = '0%';

        if (xhr.status === 200) {
          let data;
          try { data = JSON.parse(xhr.responseText); } catch(err) { showToast('Upload failed — unexpected response', 'error'); return; }
          if (data.success) {
            showToast('Media uploaded successfully!', 'success');
            // Reset form
            form.reset();
            captionCount.textContent = '0';
            dropZoneContent.classList.remove('hidden');
            filePreview.classList.add('hidden');
            previewImage.classList.add('hidden');
            previewVideo.classList.add('hidden');
            // Add to list
            prependToList(data.ad);
            mediaCount.textContent = parseInt(mediaCount.textContent || 0) + 1;
          } else {
            showToast(data.error || 'Upload failed', 'error');
          }
        } else {
          showToast('Upload failed — server error', 'error');
        }
      };
      xhr.onerror = function() {
        uploadBtn.disabled = false;
        uploadBtnText.textContent = 'Upload Media';
        uploadProgressWrapper.classList.add('hidden');
        showToast('Network error. Please try again.', 'error');
      };
      xhr.send(fd);
    });

    function prependToList(ad) {
      const typeClass = ad.mediaType === 'image' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700';
      const typeIcon = ad.mediaType === 'image' ? 'ri-image-line' : 'ri-video-line';
      const thumbHtml = ad.mediaType === 'image'
        ? `<img src="${ad.url}" alt="Ad" class="rounded-lg w-full h-full object-cover">`
        : `<div class="w-full h-full bg-gray-900 rounded-lg flex items-center justify-center relative"><i class="ri-play-circle-line text-white text-3xl absolute"></i></div>`;
      const date = new Date(ad.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      const html = `
        <div class="ad-item flex gap-4 p-4 items-start" data-id="${ad._id}">
          <div class="media-thumb w-28 flex-shrink-0">${thumbHtml}</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap mb-1">
              <span class="px-2 py-0.5 text-xs rounded-full font-medium ${typeClass}">
                <i class="${typeIcon} mr-0.5"></i>${ad.mediaType}
              </span>
              <span class="px-2 py-0.5 text-xs rounded-full font-medium bg-green-100 text-green-700">Published</span>
            </div>
            <p class="text-sm text-gray-700 truncate">${ad.caption || '<span class="text-gray-400">No caption</span>'}</p>
            <p class="text-xs text-gray-400 mt-1">Order: ${ad.order} · Added ${date}</p>
            <div class="flex items-center gap-2 mt-3">
              <button class="toggle-btn px-3 py-1 text-xs rounded-lg font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 transition-all duration-200" data-id="${ad._id}">Hide</button>
              <button class="delete-btn px-3 py-1 text-xs rounded-lg font-medium border border-red-200 text-red-600 hover:bg-red-50 transition-all duration-200" data-id="${ad._id}"><i class="ri-delete-bin-line mr-1"></i>Delete</button>
            </div>
          </div>
        </div>`;
      // Remove empty state if present
      const empty = mediaList.querySelector('.py-16');
      if (empty) mediaList.innerHTML = '';
      mediaList.insertAdjacentHTML('afterbegin', html);
      attachHandlers();
    }

    // Toggle & Delete handlers
    function attachHandlers() {
      document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.onclick = async function() {
          const id = this.getAttribute('data-id');
          const res = await fetch(`/admin/ads/${id}/toggle`, { method: 'PATCH' });
          const data = await res.json();
          if (data.success) {
            const item = this.closest('.ad-item');
            const badge = item.querySelector('.bg-green-100, .bg-gray-100');
            const isNowPublished = data.ad.isPublished;
            if (badge) {
              badge.className = `px-2 py-0.5 text-xs rounded-full font-medium ${isNowPublished ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'}`;
              badge.textContent = isNowPublished ? 'Published' : 'Hidden';
            }
            this.textContent = isNowPublished ? 'Hide' : 'Show';
            showToast(isNowPublished ? 'Media is now visible' : 'Media is now hidden', 'success');
          } else {
            showToast('Failed to toggle', 'error');
          }
        };
      });

      document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.onclick = async function() {
          if (!confirm('Delete this media item? This cannot be undone.')) return;
          const id = this.getAttribute('data-id');
          const res = await fetch(`/admin/ads/${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            this.closest('.ad-item').remove();
            const count = parseInt(mediaCount.textContent || 1) - 1;
            mediaCount.textContent = count;
            if (count === 0) {
              mediaList.innerHTML = '<div class="py-16 text-center"><i class="ri-image-line text-5xl text-gray-200 mb-3 block"></i><h3 class="text-lg font-semibold text-gray-500">No media uploaded yet</h3></div>';
            }
            showToast('Media deleted', 'success');
          } else {
            showToast('Failed to delete', 'error');
          }
        };
      });
    }

    attachHandlers();
  </script>
</body>
</html>
