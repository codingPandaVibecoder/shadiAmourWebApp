        'Germany': ['Bavaria','Berlin','Hesse','Hamburg','North Rhine-Westphalia','Baden-Württemberg','Other'],
        'France': ["Île-de-France","Provence-Alpes-Côte d'Azur","Auvergne-Rhône-Alpes","Hauts-de-France","Occitanie","Other"],
        'Malaysia': ['Selangor','Kuala Lumpur','Penang','Johor','Perak','Sabah','Sarawak','Other'],
        'Singapore': ['Central','East','North','North-East','West','Other'],
        'Other': ['Other']
      };

      const countrySel = document.getElementById('filterCountry');
      const citySel = document.getElementById('filterCity');
      const stateSel = document.getElementById('filterState');

      function fillSelect(sel, items, placeholder, selected) {
        if (!items || items.length === 0) {
          sel.innerHTML = '<option value="">' + placeholder + '</option>';
          sel.disabled = true;
          return;
        }
        sel.innerHTML = '<option value="">' + placeholder + '</option>';
        items.forEach(function (v) {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = v;
          if (selected && String(v).toLowerCase() === String(selected).toLowerCase()) opt.selected = true;
          sel.appendChild(opt);
        });
        sel.disabled = false;
      }

      countrySel.addEventListener('change', function () {
        const c = this.value;
        fillSelect(citySel, cityData[c], 'All Cities', '');
        fillSelect(stateSel, stateData[c], 'All States / Provinces', '');
      });

      // Restore selections from query params (fall back to server-rendered values) on load
      (function init() {
        const params = new URLSearchParams(window.location.search);
        const country = params.get('country') || (countrySel ? countrySel.value : '');
        const city = params.get('city') || (citySel ? citySel.value : '');
        const state = params.get('state') || (stateSel ? stateSel.value : '');
        if (country && countrySel) {
          countrySel.value = country;
          fillSelect(citySel, cityData[country], 'All Cities', city);
          fillSelect(stateSel, stateData[country], 'All States / Provinces', state);
        }
      })();

      // Submit: send ONLY non-empty filter values in the query string
      const filterForm = document.getElementById('filterForm');
      if (filterForm) {
        filterForm.addEventListener('submit', function (e) {
          e.preventDefault();
          const params = new URLSearchParams();
          new FormData(filterForm).forEach(function (v, k) {
            if (v !== '' && v !== null && v !== undefined) params.set(k, v);
          });
          const s = params.toString();
          window.location.href = '/admin/filter-profiles' + (s ? '?' + s : '');
        });
      }
    });
  </script>
</body>
</html>
