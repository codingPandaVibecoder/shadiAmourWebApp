<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pages Management - D'amour Muslim Admin</title>
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#E91E63">
  <link rel="stylesheet" href="/css/output.css">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.0.0/fonts/remixicon.css" rel="stylesheet">
  <style>
    .material-shadow { box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    .line-clamp-2 { display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden; }
  </style>
</head>
<body class="bg-gray-50 font-['Roboto']">
  <%- include('../partials/header') %>

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-6">

      <!-- Page Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2 font-['Playfair_Display']">Pages Management</h1>
          <p class="text-gray-600">Create content pages with linked Islamic FAQs</p>
        </div>
        <a href="/admin/pages/create" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-button hover:bg-pink-600 transition-colors mt-4 md:mt-0">
          <i class="ri-add-line"></i>
          Create New Page
        </a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-xl p-6 material-shadow">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-2xl font-bold text-gray-900"><%= stats.total %></p>
              <p class="text-sm text-gray-600 mt-1">Total Pages</p>
            </div>
            <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
              <i class="ri-pages-line text-xl text-purple-600"></i>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl p-6 material-shadow">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-2xl font-bold text-gray-900"><%= stats.published %></p>
              <p class="text-sm text-gray-600 mt-1">Published</p>
            </div>
            <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
              <i class="ri-checkbox-circle-line text-xl text-green-600"></i>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl p-6 material-shadow">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-2xl font-bold text-gray-900"><%= stats.drafts %></p>
              <p class="text-sm text-gray-600 mt-1">Drafts</p>
            </div>
            <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
              <i class="ri-draft-line text-xl text-yellow-600"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Pages Table -->
      <div class="bg-white rounded-xl material-shadow overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
                <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">URL</th>
                <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">FAQ Categories</th>
                <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% if (pages.length === 0) { %>
              <tr>
                <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                  <i class="ri-pages-line text-5xl text-gray-300 block mb-3"></i>
                  <p class="font-medium">No pages yet</p>
                  <a href="/admin/pages/create" class="text-primary hover:underline text-sm mt-1 inline-block">Create your first page</a>
                </td>
              </tr>
              <% } else { %>
              <% pages.forEach(page => { %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4">
                  <p class="font-medium text-gray-900 line-clamp-2"><%= page.title %></p>
                  <% if (page.excerpt) { %>
                  <p class="text-xs text-gray-400 mt-1 line-clamp-2"><%= page.excerpt %></p>
                  <% } %>
                </td>
                <td class="px-6 py-4">
                  <span class="text-sm text-gray-500 font-mono">/<%= page.categorySlug %>/<%= page.pageSlug %></span>
                </td>
                <td class="px-6 py-4">
                  <% if (page.faqCategories && page.faqCategories.length > 0) { %>
                  <div class="flex flex-wrap gap-1">
                    <% page.faqCategories.slice(0, 2).forEach(cat => { %>
                    <span class="inline-block px-2 py-0.5 bg-amber-100 text-amber-800 rounded-full text-xs"><%= cat %></span>
                    <% }) %>
                    <% if (page.faqCategories.length > 2) { %>
                    <span class="inline-block px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full text-xs">+<%= page.faqCategories.length - 2 %> more</span>
                    <% } %>
                  </div>
                  <% } else { %>
                  <span class="text-xs text-gray-400">None</span>
                  <% } %>
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= page.isPublished ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                    <i class="<%= page.isPublished ? 'ri-checkbox-circle-line' : 'ri-draft-line' %> mr-1"></i>
                    <%= page.isPublished ? 'Published' : 'Draft' %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500">
                  <%= new Date(page.createdAt).toLocaleDateString('en-GB', { year:'numeric', month:'short', day:'numeric' }) %>
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2">
                    <% if (page.isPublished) { %>
                    <a href="/<%= page.categorySlug %>/<%= page.pageSlug %>" target="_blank" class="text-gray-400 hover:text-blue-600 transition-colors" title="View Live">
                      <i class="ri-external-link-line text-lg"></i>
                    </a>
                    <% } %>
                    <a href="/admin/pages/<%= page._id %>/edit" class="text-gray-400 hover:text-yellow-600 transition-colors" title="Edit">
                      <i class="ri-edit-line text-lg"></i>
                    </a>
                    <button data-page-id="<%= page._id %>" data-page-title="<%= page.title.replace(/"/g, '&quot;').replace(/'/g, '&#39;') %>" onclick="deletePage(this.dataset.pageId, this.dataset.pageTitle)" class="text-gray-400 hover:text-red-600 transition-colors" title="Delete">
                      <i class="ri-delete-bin-line text-lg"></i>
                    </button>
                  </div>
                </td>
              </tr>
              <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>

  <!-- Delete Modal -->
  <div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-md w-full p-6">
      <div class="flex items-center mb-4">
        <i class="ri-error-warning-line text-2xl text-red-500 mr-3"></i>
        <h3 class="text-lg font-semibold text-gray-900">Delete Page</h3>
      </div>
      <p class="text-gray-600 mb-6">Are you sure you want to delete "<span id="deletePageTitle" class="font-medium"></span>"? This action cannot be undone.</p>
      <div class="flex justify-end gap-3">
        <button onclick="closeDeleteModal()" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-button transition-colors">Cancel</button>
        <button id="confirmDeleteBtn" class="px-4 py-2 bg-red-500 text-white rounded-button hover:bg-red-600 transition-colors">Delete</button>
      </div>
    </div>
  </div>

  <script>
    let pageToDelete = null;
    function deletePage(pageId, pageTitle) {
      pageToDelete = pageId;
      document.getElementById('deletePageTitle').textContent = pageTitle;
      document.getElementById('deleteModal').classList.remove('hidden');
    }
    function closeDeleteModal() {
      document.getElementById('deleteModal').classList.add('hidden');
      pageToDelete = null;
    }
    document.getElementById('confirmDeleteBtn').addEventListener('click', async function () {
      if (!pageToDelete) return;
      try {
        const res = await fetch(`/admin/pages/${pageToDelete}/delete`, { method: 'POST' });
        const data = await res.json();
        if (data.success) window.location.reload();
        else alert('Failed to delete: ' + data.error);
      } catch (e) {
        alert('Failed to delete page');
      }
      closeDeleteModal();
    });
    document.getElementById('deleteModal').addEventListener('click', function (e) {
      if (e.target === this) closeDeleteModal();
    });
  </script>
</body>
</html>
