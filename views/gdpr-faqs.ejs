<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GDPR FAQs | shadiAmour Data Protection</title>
  <meta name="description" content="Answers to common questions about how shadiAmour handles your personal data under UK GDPR.">
  <meta name="keywords" content="GDPR matrimony, data protection Muslim marriage, privacy FAQ, personal data rights, UK data protection, matrimonial privacy">
  
  <!-- Open Graph / Social Media -->
  <meta property="og:title" content="GDPR FAQs | shadiAmour Data Protection">
  <meta property="og:description" content="Answers to common questions about how shadiAmour handles your personal data under UK GDPR.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://shadiamour.com/gdpr-faqs">

  <!-- Favicon -->
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#00113a">

  <!-- Tailwind CSS -->
  <link rel="stylesheet" href="/css/output.css">
  <!-- Remix Icons -->
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"></noscript>

  <style>
    .faq-item {
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .faq-item:hover {
      background-color: #f9fafb;
    }
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out, padding 0.3s ease;
    }
    .faq-item.active .faq-answer {
      max-height: 2000px;
      padding-top: 1rem;
    }
    .faq-item.active .faq-icon {
      transform: rotate(180deg);
    }
    .faq-icon {
      transition: transform 0.3s ease;
    }
    .gdpr-badge {
      background: linear-gradient(135deg, #00113a 0%, #002366 100%);
    }
  </style>
  <%- include('partials/clarity') %>
  <%- include('partials/thirdparty') %>
  <%- include('partials/analytics') %>
</head>

<body class="bg-background text-on-background font-body-md antialiased flex flex-col min-h-screen">
  <%- include('partials/header') %>

  <main class="flex-grow pt-[92px] pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Hero -->
      <section class="py-section-padding text-center flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-secondary-container/20 border border-secondary-container/40 rounded-full text-secondary font-label-md text-sm font-medium mb-6">
          <i class="ri-shield-user-line"></i>
          <span>Data Protection</span>
        </div>
        <h1 class="text-display-lg-mobile md:text-display-lg font-display-lg-mobile md:font-display-lg text-primary mb-6 leading-tight">
          GDPR &amp; Data Protection FAQs
        </h1>
        <p class="text-body-lg font-body-lg text-on-surface-variant max-w-2xl mx-auto">
          Answers to common questions about how shadiAmour handles your personal data under UK GDPR.
        </p>
      </section>

      <!-- GDPR Compliance Banner -->
      <div class="gdpr-badge rounded-xl p-6 text-white mb-8 shadow-lg">
        <div class="flex flex-col md:flex-row items-center gap-4">
          <div class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
            <i class="ri-eu-fill text-4xl"></i>
          </div>
          <div class="text-center md:text-left">
            <h2 class="text-xl font-bold mb-2">GDPR Compliant Platform</h2>
            <p class="text-white/90">
              shadiAmour is committed to protecting your privacy and complying with the General Data Protection Regulation (GDPR) and UK Data Protection Act 2018. Your data security is our priority.
            </p>
          </div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] overflow-hidden">
        
        <!-- YOUR DATA & PRIVACY SECTION -->
        <div class="p-6 border-b border-outline-variant/30 bg-primary-fixed/40">
          <h2 class="text-headline-md font-headline-md text-primary flex items-center">
            <i class="ri-shield-check-fill text-primary-container mr-2"></i>
            Your Data &amp; Privacy
          </h2>
        </div>

        <div class="divide-y divide-outline-variant/30">
          <!-- FAQ 1 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-lg font-medium text-on-surface pr-4">What personal data does shadiAmour collect?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Profile details (name, age, location, religious practice, family background, preferences), contact information, and technical data like your IP address and device type. See our full <a href="/privacy" class="text-primary hover:underline">Privacy Policy</a> for details.</p>
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-lg font-medium text-on-surface pr-4">Why do you ask about religious practice — isn't that sensitive data?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Yes — under UK GDPR, information about religious belief is "special category data." We only collect it because it's essential to matchmaking on a faith-based platform, and we rely on your explicit consent to process it. You can choose what to share on your profile.</p>
            </div>
          </div>

          <!-- FAQ 3 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-lg font-medium text-on-surface pr-4">Who can see my profile?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Only verified members can view profiles, based on the visibility settings you choose. Your phone number and full contact details are never shared without your explicit consent.</p>
            </div>
          </div>

          <!-- FAQ 4 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-lg font-medium text-on-surface pr-4">Do you share my data with WhatsApp groups?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Only if you opt in to having your profile shared in our community WhatsApp groups. This is optional and separate from your core platform profile.</p>
            </div>
          </div>

          <!-- FAQ 5 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-lg font-medium text-on-surface pr-4">Do you sell my data to advertisers?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>No. We do not sell personal data to third parties.</p>
            </div>
          </div>

          <!-- FAQ 6 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-lg font-medium text-on-surface pr-4">Is my data stored securely?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Yes — we use industry-standard security measures to protect member data, and we work with service providers who are contractually bound to protect your data.</p>
            </div>
          </div>
        </div>

        <!-- YOUR RIGHTS & CHOICES SECTION -->
        <div class="p-6 border-b border-t border-outline-variant/30 bg-primary-fixed/40">
          <h2 class="text-headline-md font-headline-md text-primary flex items-center">
            <i class="ri-user-star-fill text-primary-container mr-2"></i>
            Your Rights &amp; Choices
          </h2>
        </div>

        <div class="divide-y divide-outline-variant/30">
          <!-- FAQ 7 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-lg font-medium text-on-surface pr-4">Can I see what data you hold about me?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Yes. Under UK GDPR you have the right to request a copy of your data (a "Subject Access Request"). Email <a href="mailto:contact@shadiamour.com" class="text-primary hover:underline">contact@shadiamour.com</a> and we'll respond within one month.</p>
            </div>
          </div>

          <!-- FAQ 8 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-lg font-medium text-on-surface pr-4">Can I ask you to delete my data?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Yes, you can request deletion of your account and personal data at any time by emailing <a href="mailto:contact@shadiamour.com" class="text-primary hover:underline">contact@shadiamour.com</a>. Some data may be retained briefly for legal, safety, or fraud-prevention purposes.</p>
            </div>
          </div>

          <!-- FAQ 9 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-lg font-medium text-on-surface pr-4">What if I'm unhappy with how my data is handled?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>Contact us first at <a href="mailto:contact@shadiamour.com" class="text-primary hover:underline">contact@shadiamour.com</a>. If you're still not satisfied, you can complain to the UK Information Commissioner's Office (ICO) at ico.org.uk.</p>
            </div>
          </div>

          <!-- FAQ 10 -->
          <div class="faq-item p-6" onclick="toggleFaq(this)">
            <div class="flex items-start justify-between">
              <h3 class="text-lg font-medium text-on-surface pr-4">Can a parent register me without my consent?</h3>
              <i class="ri-arrow-down-s-line faq-icon text-outline text-xl flex-shrink-0"></i>
            </div>
            <div class="faq-answer text-on-surface-variant">
              <p>No. While parents/guardians may create a profile on a family member's behalf as part of our family-inclusive approach, the individual's own knowledge and consent is required, and they retain full rights over their data.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Contact for GDPR Section -->
      <div class="mt-8 bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] p-8">
        <h2 class="text-headline-md font-headline-md text-primary text-center mb-6">
          <i class="ri-questionnaire-line text-primary-container mr-2"></i>
          Data Protection Contact
        </h2>
        <div class="text-center">
          <p class="text-on-surface-variant mb-6">
            For any questions about data protection, GDPR rights, or to exercise any of your rights, please contact us:
          </p>
          <div class="inline-flex flex-col sm:flex-row gap-4 items-center justify-center">
            <a href="mailto:contact@shadiamour.com" class="inline-flex items-center px-6 py-3 bg-primary text-on-primary rounded-full font-medium hover:bg-primary-container transition-colors">
              <i class="ri-mail-line mr-2"></i>
              contact@shadiamour.com
            </a>
          </div>
          <p class="text-sm text-outline mt-4">
            We aim to respond to all data protection enquiries within 30 days.
          </p>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="mt-8 text-center">
        <p class="text-on-surface-variant mb-4">Related Pages</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/privacy" class="inline-flex items-center px-4 py-2 bg-neutral-gray border border-outline-variant rounded-full text-on-surface-variant hover:border-primary hover:text-primary transition-colors">
            <i class="ri-shield-check-line mr-2"></i>
            Privacy Policy
          </a>
          <a href="/terms" class="inline-flex items-center px-4 py-2 bg-neutral-gray border border-outline-variant rounded-full text-on-surface-variant hover:border-primary hover:text-primary transition-colors">
            <i class="ri-file-list-line mr-2"></i>
            Terms &amp; Conditions
          </a>
          <a href="/company-details" class="inline-flex items-center px-4 py-2 bg-neutral-gray border border-outline-variant rounded-full text-on-surface-variant hover:border-primary hover:text-primary transition-colors">
            <i class="ri-building-line mr-2"></i>
            Company Details
          </a>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    function toggleFaq(element) {
      // Close all other FAQs
      document.querySelectorAll('.faq-item').forEach(item => {
        if (item !== element && item.classList.contains('active')) {
          item.classList.remove('active');
        }
      });
      // Toggle current FAQ
      element.classList.toggle('active');
    }
  </script>
</body>

</html>
