<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% const appName="shadiamour" ; const city=profile.city || 'UK' ; const country=profile.country
    || 'United Kingdom' ; const genderLabel=profile.gender==='male' ? 'Muslim Man' : 'Muslim Woman' ; const
    ethnicity=profile.ethnicity || 'Muslim' ; 
    
    // Check for SEO overrides first
    const autoGeneratedTitle = `${ethnicity} ${genderLabel} for Halal Marriage in ${city} | ${appName}`;
    const pageTitle = (profile.seoSettings && profile.seoSettings.customMetaTitle) 
      ? profile.seoSettings.customMetaTitle 
      : autoGeneratedTitle;
    
    const profileUrl = (profile.seoSettings && profile.seoSettings.canonicalUrlOverride) 
      ? profile.seoSettings.canonicalUrlOverride 
      : `https://shadiamour.com/profiles/${profile.profileSlug || profile._id}`;
    
    const imageUrl = (profile.seoSettings && profile.seoSettings.ogImageOverride) 
      ? profile.seoSettings.ogImageOverride 
      : (profile.profilePic && profile.profilePic.url) 
        ? profile.profilePic.url
        : 'https://shadiamour.com/images/default-profile-og.jpg';
    
    const baseKeywords=[ "Muslim matrimony"
    , "Halal marriage" , "Muslim marriage UK" , "Islamic marriage site" , "Muslim matchmaking" , "Halal Muslim marriage"
    , "Muslim spouse search" ]; const locationKeywords=city.toLowerCase().includes('london') ?
    [ "Muslim marriage London" , "Shaadi in London" , "Find Halal Partner London" , "Nikkah London" , "London Rishta" ]
    : city.toLowerCase().includes('leicester') ? [ "Leicester Muslim marriage" , "Muslim rishta Leicester"
    , "Pakistani shaadi Leicester" ] : city.toLowerCase().includes('birmingham') ? [ "Muslim marriage Birmingham"
    , "Muslim shaadi Birmingham" , "Birmingham shaadi" ] : [ "Muslim marriage site UK" , "Halal marriage site UK"
    , "Muslim matrimonial UK" ]; const ethnicityKeywords=ethnicity.toLowerCase().includes('pakistani') ?
    [ "Pakistani Muslim wedding" , "Pakistani marriage" , "Pakistani nikkah" , "Pakistani shaadi" , "Pakistani Muslim" ]
    : ethnicity.toLowerCase().includes('bengali') ? [ "Bengali Muslim wedding" , "Bengali wedding"
    , "Bengali Muslim marriage" ] : ethnicity.toLowerCase().includes('arab') ? [ "Arab Muslim wedding"
    , "Arab Muslim marriage" , "Arab Muslim" ] : [ "Muslim wedding" , "Islamic wedding" , "Nikkah ceremony"
    , "Sunnah marriage" ]; 
    
    // Merge custom keywords with auto-generated
    const customKeywords = (profile.seoSettings && profile.seoSettings.customKeywords) 
      ? profile.seoSettings.customKeywords 
      : [];
    const keywordList = [...baseKeywords, ...locationKeywords, ...ethnicityKeywords, ...customKeywords].join(', ');

    // Check for custom meta description override
    const autoGeneratedDescription = `Meet ${profile.randomNameForSeo || profile.username}, a verified ${ethnicity} ${genderLabel.toLowerCase()} for Muslim marriage in ${city}, UK. Join ${appName} to find Muslim rishta in uk.`;
    const metaDescription = (profile.seoSettings && profile.seoSettings.customMetaDescription) 
      ? profile.seoSettings.customMetaDescription 
      : autoGeneratedDescription;

  const richDescription = `${profile.randomNameForSeo}, ${profile.age}, from ${city}, ${country} — a ${ethnicity} ${genderLabel.toLowerCase()} seeking halal Muslim marriage. Connect on ${appName}, the trusted Islamic matrimony and matchmaking site for UK Muslims.`;
  
  // Check if profile should be noindexed — default is noindex unless explicitly overridden
  const shouldNoIndex = !(profile.seoSettings && profile.seoSettings.indexOverride === true);
  %>

  <% if (shouldNoIndex) { %>
  <meta name="robots" content="noindex, nofollow">
  <% } %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= metaDescription %>">
  <meta name="keywords" content="<%= keywordList %>">
  <link rel="canonical" href="<%= profileUrl %>">

  <!-- ✅ Favicon & Theme -->
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#00113a">

  <!-- ✅ Open Graph / Facebook -->
  <meta property="og:type" content="profile">
  <meta property="og:url" content="<%= profileUrl %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= richDescription %>">
  <meta property="og:image" content="<%= imageUrl %>">
  <meta property="og:image:width" content="400">
  <meta property="og:image:height" content="400">
  <meta property="og:site_name" content="D' amour Muslim">
  <meta property="og:image:alt" content="<%= profile.username %>'s verified Muslim marriage profile">
  <meta property="og:locale" content="en_GB">

  <!-- ✅ Profile-specific OG -->
  <meta property="profile:first_name" content="<%= profile.username %>">
  <meta property="profile:username" content="<%= profile.username %>">
  <meta property="profile:gender" content="<%= profile.gender %>">

  <!-- ✅ Twitter Meta -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@shadiamour">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= richDescription %>">
  <meta name="twitter:image" content="<%= imageUrl %>">

  <!-- ✅ JSON-LD Structured Data (ProfilePage + Person Schema) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "dateCreated": "<%= profile.createdAt ? new Date(profile.createdAt).toISOString() : new Date().toISOString() %>",
      "dateModified": "<%= profile.updatedAt ? new Date(profile.updatedAt).toISOString() : new Date().toISOString() %>",
      "mainEntity": {
        "@type": "Person",
        "name": "<%= profile.randomNameForSeo || profile.username %>",
        "gender": "<%= profile.gender %>",
        "birthDate": "<%= profile.age ? (new Date().getFullYear() - profile.age) + '-01-01' : '' %>",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "<%= profile.city || '' %>",
          "addressRegion": "<%= profile.state || '' %>",
          "addressCountry": "<%= profile.country || 'United Kingdom' %>"
        },
        "image": "<%= imageUrl %>",
        "url": "<%= profileUrl %>",
        "description": "<%= richDescription %>",
        "jobTitle": "<%= profile.work || '' %>",
        "alumniOf": [
          <% if (profile.education && profile.education.length > 0) { %>
            <% profile.education.forEach((edu, index) => { %>
              {
                "@type": "EducationalOrganization",
                "name": "<%= edu.institute || 'Educational Institution' %>"
              }<%= index < profile.education.length - 1 ? ',' : '' %>
            <% }) %>
          <% } %>
        ],
        "knowsLanguage": [
          <% if (profile.languagesSpoken && profile.languagesSpoken.length > 0) { %>
            <% profile.languagesSpoken.forEach((lang, index) => { %>
              "<%= lang %>"<%= index < profile.languagesSpoken.length - 1 ? ',' : '' %>
            <% }) %>
          <% } %>
        ],
        "seeks": {
          "@type": "Thing",
          "description": "<%= profile.lookingForASpouseThatIs || 'A compatible marriage partner' %>"
        },
        "nationality": {
          "@type": "Country",
          "name": "<%= profile.nationality || profile.country || 'United Kingdom' %>"
        }
      }
    }
  </script>

  <!-- Add BreadcrumbList Schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://shadiamour.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Profiles",
          "item": "https://shadiamour.com/profiles"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "<%= profile.gender === 'male' ? 'Male' : 'Female' %> Profiles",
          "item": "https://shadiamour.com/profiles?gender=<%= profile.gender %>"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "<%= profile.randomNameForSeo || profile.username %>",
          "item": "<%= profileUrl %>"
        }
      ]
    }
  </script>
  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>
  <link rel="stylesheet" href="/css/output.css">

  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"></noscript>
  <style>
    :where([class^="ri-"])::before {
      content: "\f3c2";
    }

    #shareProfileBtn:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }

    #profileCard img {
      max-width: 100%;
      height: auto;
    }

    .line-clamp-3 {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

/* Mobile similar profiles adjustments */
@media (max-width: 640px) {
  /* Reduce padding on mobile for similar profiles */
  .similar-profile-card .p-4 {
    padding: 0.75rem;
  }

  /* Smaller text on mobile */
  .similar-profile-card h3 {
    font-size: 0.875rem;
  }

  .similar-profile-card .text-sm {
    font-size: 0.75rem;
  }

  /* Adjust icon sizes */
  .similar-profile-card i {
    font-size: 0.875rem;
  }

  /* Make age badge smaller */
  .similar-profile-card .absolute.top-3 {
    top: 0.5rem;
    right: 0.5rem;
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
  }
}
  </style>
  <%- include('partials/clarity') %>
  <%- include('partials/thirdparty') %>
  <%- include('partials/analytics') %>
</head>

<body class="bg-neutral-gray text-on-surface font-body-md antialiased min-h-screen flex flex-col">
  <!-- Global header -->
  <%- include('partials/header') %>

  <main class="flex-grow pt-[92px] pb-section-padding">
    <div class="max-w-container-max mx-auto px-margin-x py-10">
      <!-- Breadcrumb -->
      <div class="mb-8 flex flex-wrap items-center gap-2 text-on-surface-variant text-label-md font-label-md">
        <a class="hover:text-primary transition-colors" href="/">Home</a>
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <a class="hover:text-primary transition-colors" href="/profiles">Profiles</a>
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <a class="hover:text-primary transition-colors" href="/profiles?gender=<%= profile.gender %>"><%= profile.gender === 'male' ? 'Male' : 'Female' %> Profiles</a>
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-primary font-semibold truncate max-w-[220px]"><%= profile.username %></span>
      </div>

      <!-- Pending Approval Notice - Show only when viewing own unapproved profile -->
      <% if (isOwnProfile && !profile.isApproved) { %>
      <div class="mb-6 bg-amber-50 border border-amber-200 rounded-xl p-5">
        <div class="flex items-start gap-4">
          <div class="flex-1">
            <h3 class="text-lg font-semibold text-amber-800 mb-2 flex items-center">
              <span class="material-symbols-outlined text-amber-600 mr-1">schedule</span>
              Your Profile is Pending Approval
            </h3>
            <p class="text-amber-700 mb-3">
              Your profile is <strong>currently only visible to you</strong>. Once our team reviews and approves your profile, other users will be able to see it and connect with you.
            </p>
            <div class="bg-white rounded-lg p-4 border border-amber-200">
              <p class="text-sm text-gray-700 mb-3 flex items-center">
                <span class="material-symbols-outlined text-amber-500 mr-1">lightbulb</span>
                <strong>Increase your approval chances:</strong> Fill in as many fields as possible in your profile to help our team verify your information.
              </p>
              <a href="/account/info" data-track="true" data-event-name="complete_profile_from_profile" data-category="engagement" data-label="Complete Your Profile" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-on-primary rounded-lg hover:bg-primary-container font-medium text-sm transition-colors">
                <span class="material-symbols-outlined text-base">edit</span>
                Complete Your Profile
              </a>
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Profile Hero & Layout Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
        <!-- Left Column: Filters (desktop only — mobile uses slide-in drawer) -->
        <aside class="hidden lg:block lg:col-span-4">
          <%- include('partials/profilesFilter') %>
        </aside>

        <!-- Right Column: Details Bento Grid -->
        <div class="lg:col-span-8 flex flex-col gap-gutter">
          <!-- Header Info -->
          <div class="bento-card">
            <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-6">
              <div>
                <div class="flex items-center flex-wrap gap-3 mb-2">
                  <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary leading-tight">
                    <span class="material-symbols-outlined text-primary align-middle" style="font-variation-settings: 'FILL' 1;">verified</span>
                    <%= profile.username %>
                  </h1>
                  <% if (user && user._id && user._id.toString()===profile._id.toString()) { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary/10 text-primary">
                    <span class="material-symbols-outlined text-sm mr-1">person</span>
                    You
                  </span>
                  <% } %>
                </div>
                <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-on-surface-variant font-body-lg text-body-lg">
                  <% if (profile.age) { %>
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary/60">cake</span>
                    <%= profile.age %> Years Old
                  </div>
                  <% } %>
                  <% if (profile.city || profile.country) { %>
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary/60">location_on</span>
                    <%= profile.city %><% if (profile.city && profile.country) { %>, <% } %><%= profile.country %>
                  </div>
                  <% } %>
                </div>
              </div>

              <!-- Action buttons -->
              <div class="flex items-center gap-3 flex-wrap">
                <% if (user && user._id && user._id.toString()===profile._id.toString()) { %>
                <!-- Edit Profile Button (only for own profile) -->
                <a href="/account" data-track="true" data-event-name="edit_profile_click" data-category="engagement" data-label="Edit Profile" class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary hover:bg-primary-container text-on-primary rounded-lg transition-all duration-300 shadow-md">
                  <span class="material-symbols-outlined text-lg">edit</span>
                  <span>Edit Profile</span>
                </a>
                <% } %>

                <!-- Share Profile Button -->
                <button id="shareProfileBtn" data-track="true" data-event-name="share_profile_click" data-category="engagement" data-label="Share Profile" class="inline-flex items-center gap-2 px-4 py-2.5 bg-halal-green hover:bg-halal-green/90 text-white rounded-lg transition-all duration-300 shadow-md">
                  <span id="shareIcon" class="material-symbols-outlined text-lg">share</span>
                  <span id="shareText">Share Profile</span>
                </button>

                <% /* Chat button – only show between different users with accepted connection */ %>
                <% if (user && user._id && user._id.toString() !== profile._id.toString() && connectionStatus === 'connected') { %>
                <button id="startChatBtn" onclick="startChat('<%= profile._id %>')" data-track="true" data-event-name="start_chat_click" data-category="conversion" data-label="Start Chat" class="inline-flex items-center gap-2 px-4 py-2.5 bg-trust-blue hover:bg-primary text-on-primary rounded-lg transition-all duration-300 shadow-md">
                  <span class="material-symbols-outlined text-lg">chat</span>
                  <span>Chat</span>
                </button>
                <% } %>
              </div>
            </div>

            <!-- Compatibility Score Badge (for logged-in viewers looking at others) -->
            <% if (typeof matchScore !== 'undefined' && matchScore && user && !isOwnProfile) { %>
            <div class="mt-5 flex">
              <%
                const ms = (matchScore && matchScore.finalScore != null) ? matchScore.finalScore : 0;
                let badgeBg = 'bg-surface-container-low text-on-surface-variant border-outline-variant';
                if (ms >= 70) badgeBg = 'bg-halal-green/10 text-halal-green border-halal-green/30';
                else if (ms >= 50) badgeBg = 'bg-secondary-container/20 text-on-secondary-container border-secondary-container/40';
              %>
              <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold border <%= badgeBg %>">
                <span class="material-symbols-outlined text-lg">monitor_heart</span>
                <%= ms %>% Compatible
                <% if (profile && profile.profileCompletenessTier === 'B') { %>
                <span class="text-xs font-normal opacity-75">(partial profile)</span>
                <% } %>
              </span>
            </div>
            <% } %>
          </div>

          <!-- Connection Status Banners -->
          <% if (user && user._id && user._id.toString() !== profile._id.toString()) { %>
          <!-- Connected Banner - Show when users are connected -->
          <% if (connectionStatus === 'connected' && outgoingRequest) { %>
          <div id="connectedBanner" class="bg-surface-white border border-halal-green/30 rounded-xl p-4">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 flex items-center justify-center rounded-full bg-halal-green/10 text-halal-green">
                  <span class="material-symbols-outlined text-xl">link</span>
                </div>
                <div>
                  <h3 class="font-semibold text-halal-green">You're Connected</h3>
                  <p class="text-sm text-on-surface-variant">You and <%= profile.username %> can view each other's full profiles</p>
                </div>
              </div>
              <button
                onclick="confirmRevokeAccess('<%= outgoingRequest._id %>', '<%= profile.username %>')"
                data-track="true" data-event-name="revoke_access_click" data-category="engagement" data-label="Revoke Access"
                class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-error/30 text-error hover:bg-error-container/20 transition-all duration-300 rounded-lg text-sm font-medium whitespace-nowrap"
              >
                <span class="material-symbols-outlined text-lg">link_off</span>
                <span>Revoke Access</span>
              </button>
            </div>
          </div>
          <% } %>

          <!-- Incoming Request Banner - Show when profile owner has sent us a request -->
          <% if (incomingRequest) { %>
          <div id="incomingRequestBanner" class="bg-surface-white border border-primary/20 rounded-xl p-4">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 flex items-center justify-center rounded-full bg-primary/10 text-primary">
                  <span class="material-symbols-outlined text-xl">mail</span>
                </div>
                <div>
                  <h3 class="font-semibold text-on-surface"><%= profile.username %> wants to connect!</h3>
                  <p class="text-sm text-on-surface-variant">They've requested to share profiles with you</p>
                </div>
              </div>
              <div class="flex items-center gap-2 w-full sm:w-auto">
                <button
                  onclick="confirmRespondToRequest('<%= incomingRequest._id %>', 'accept', '<%= profile.username %>')"
                  data-track="true" data-event-name="accept_request_click" data-category="conversion" data-label="Accept Connection"
                  class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2 bg-halal-green hover:bg-halal-green/90 text-white transition-all duration-300 rounded-lg text-sm font-medium"
                >
                  <span class="material-symbols-outlined text-lg">check</span>
                  <span>Accept</span>
                </button>
                <button
                  onclick="confirmRespondToRequest('<%= incomingRequest._id %>', 'reject', '<%= profile.username %>')"
                  data-track="true" data-event-name="decline_request_click" data-category="conversion" data-label="Decline Connection"
                  class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2 bg-white border border-outline-variant text-on-surface-variant hover:bg-surface-container-low transition-all duration-300 rounded-lg text-sm font-medium"
                >
                  <span class="material-symbols-outlined text-lg">close</span>
                  <span>Decline</span>
                </button>
              </div>
            </div>
          </div>
          <% } %>
          <% } %>

          <!-- Hidden canvas for generating image - UPDATED to be dynamic -->
          <div id="profileCard" style="position: absolute; left: -9999px; top: -9999px;">
            <div id="shareCanvas" style="width: 450px; min-width: 450px; max-width: 450px; padding: 20px; background: <%= profile.gender === 'female' ? 'linear-gradient(135deg, #F6D6E5 0%, #F1CCDE 50%, #F4C4DC 100%)' : 'linear-gradient(135deg, #89cff0 0%)' %>; border-radius: 16px; color: #2D3748; font-family: 'Roboto', sans-serif; font-size: 13px; border: 2px solid; box-sizing: border-box; overflow: visible; height: auto;">
              <!-- This will be populated dynamically by JavaScript -->
            </div>
          </div>

          <!-- About Me -->
          <% if (profile.aboutMe) { %>
          <div class="bento-card">
            <h2 class="font-headline-md text-headline-md text-primary mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-premium-gold">info</span>
              About Me
            </h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed"><%= profile.aboutMe %></p>
          </div>
          <% } %>

          <!-- Personal Info Grid (Public Information) -->
          <div class="bento-card">
            <h2 class="font-headline-md text-headline-md text-primary mb-6 flex items-center gap-2">
              <span class="material-symbols-outlined text-premium-gold">badge</span>
              Public Information
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <% if (profile.gender) { %>
              <div class="bg-surface-white rounded-xl p-6 shadow-sm border border-surface-container-highest flex flex-col items-center text-center gap-3">
                <div class="w-12 h-12 rounded-full bg-primary-container/5 flex items-center justify-center text-primary-container">
                  <span class="material-symbols-outlined"><%= profile.gender === 'male' ? 'male' : 'female' %></span>
                </div>
                <div>
                  <div class="font-label-md text-label-md text-on-surface-variant/70 text-xs uppercase tracking-wider mb-1">Gender</div>
                  <div class="font-body-md text-body-md font-medium capitalize"><%= profile.gender %></div>
                </div>
              </div>
              <% } %>
              <% if (profile.age) { %>
              <div class="bg-surface-white rounded-xl p-6 shadow-sm border border-surface-container-highest flex flex-col items-center text-center gap-3">
                <div class="w-12 h-12 rounded-full bg-primary-container/5 flex items-center justify-center text-primary-container">
                  <span class="material-symbols-outlined">cake</span>
                </div>
                <div>
                  <div class="font-label-md text-label-md text-on-surface-variant/70 text-xs uppercase tracking-wider mb-1">Age</div>
                  <div class="font-body-md text-body-md font-medium"><%= profile.age %> years</div>
                </div>
              </div>
              <% } %>
              <% if (profile.city) { %>
              <div class="bg-surface-white rounded-xl p-6 shadow-sm border border-surface-container-highest flex flex-col items-center text-center gap-3">
                <div class="w-12 h-12 rounded-full bg-primary-container/5 flex items-center justify-center text-primary-container">
                  <span class="material-symbols-outlined">location_on</span>
                </div>
                <div>
                  <div class="font-label-md text-label-md text-on-surface-variant/70 text-xs uppercase tracking-wider mb-1">City</div>
                  <div class="font-body-md text-body-md font-medium"><%= profile.city %></div>
                </div>
              </div>
              <% } %>
              <% if (profile.country) { %>
              <div class="bg-surface-white rounded-xl p-6 shadow-sm border border-surface-container-highest flex flex-col items-center text-center gap-3">
