              <span class="material-symbols-outlined text-sm mr-1">info</span>
              <strong>General Information:</strong> The following content provides additional context about Muslim matrimony services and is not specific to this individual profile.
            </p>
            <% if (profile.seoField1 && profile.seoField1.trim()) { %>
            <div class="mb-4 text-sm text-on-surface-variant leading-relaxed">
              <%- profile.seoField1.replace(/\n/g, '<br>') %>
            </div>
            <% } %>
            <% if (profile.seoField2 && profile.seoField2.trim()) { %>
            <div class="text-sm text-on-surface-variant leading-relaxed">
              <%- profile.seoField2.replace(/\n/g, '<br>') %>
            </div>
            <% } %>
            <% if (profile.seoKeywords && profile.seoKeywords.length > 0) { %>
            <div class="text-sm text-on-surface-variant leading-relaxed mt-3">
              <%= profile.seoKeywords.join(', ') %>
            </div>
            <% } %>
          </div>
        </div>
        <% } %>
      </section>
    </div>
  </main>

