<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Islamic FAQs - Marriage & Nikah Questions Answered | D'amour Muslim</title>
  <meta name="description" content="Get answers to your Islamic marriage questions. Our collection of expert-answered FAQs covers destiny, engagement, nikah, divorce, family rights and more for Muslims in the UK." />
  <meta name="keywords" content="Islamic marriage questions, nikah FAQs, Muslim marriage advice, Islamic guidance on marriage, halal relationship questions UK" />
  <link rel="canonical" href="https://damourmuslim.com/islamic-faqs" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Islamic FAQs - Marriage & Nikah Questions Answered | D'amour Muslim" />
  <meta property="og:description" content="Get answers to your Islamic marriage questions. Expert-answered FAQs covering destiny, engagement, nikah, divorce, family rights and more." />
  <meta property="og:url" content="https://damourmuslim.com/islamic-faqs" />
  <meta property="og:site_name" content="D'amour Muslim" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Islamic FAQs - Marriage & Nikah Questions Answered" />
  <meta name="twitter:description" content="Get answers to your Islamic marriage questions from respected scholars." />

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#E91E63">

  <link rel="stylesheet" href="/css/output.css" />
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"></noscript>

  <%- include('../partials/clarity') %>
  <%- include('../partials/thirdparty') %>
  <%- include('../partials/analytics') %>

  <% if (faqs && faqs.length > 0) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      <%- faqs.slice(0,10).map((f, i) => JSON.stringify({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": (f.excerpt || f.answer.replace(/<[^>]*>/g, '').substring(0, 300))
        }
      })).join(',') %>
    ]
  }
  </script>
  <% } %>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://damourmuslim.com" },
      { "@type": "ListItem", "position": 2, "name": "Islamic FAQs", "item": "https://damourmuslim.com/islamic-faqs" }
    ]
  }
  </script>
</head>

<body class="bg-gray-50 font-['Roboto']">
  <%- include('../partials/header') %>

  <main class="pt-16 min-h-screen">

    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gray-900" style="min-height:340px;">
      <!-- Hero image — URL to be provided -->
      <img src="" alt="Islamic marriage guidance and FAQs" class="absolute inset-0 w-full h-full object-cover opacity-50" style="<% if (!true) { %>display:none;<% } %>">
      <!-- Gradient overlay always visible so hero looks good even without image -->
      <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-700 opacity-90"></div>
      <div class="relative z-10 flex flex-col items-center justify-center text-center px-6 py-20">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-amber-400/20 border border-amber-400/40 rounded-full text-amber-300 text-sm font-medium mb-5">
          <i class="ri-question-answer-line"></i>
          <span>Scholar-Answered Questions</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 font-['Playfair_Display']">
          Islamic FAQs
        </h1>
        <p class="text-gray-300 text-lg max-w-2xl">
          The ins and outs of finding your Muslim spouse — questions answered by respected Islamic scholars.
        </p>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-6 py-12">

      <!-- SEO Text -->
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-2xl font-bold text-gray-800 mb-4 font-['Playfair_Display']">Your Islamic Marriage Questions, Answered</h2>
        <p class="text-gray-600 leading-relaxed mb-3">
          Finding a spouse in a halal, Islamic way can raise many questions — from understanding destiny (<em>qadar</em>) and the rights of a spouse, to navigating engagement, nikah contracts, and family obligations. Our collection of Islamic FAQs is answered by knowledgeable scholars to help you navigate your journey with confidence and clarity.
        </p>
        <p class="text-gray-600 leading-relaxed">
          Browse by category below, or explore all questions. Each answer is rooted in authentic Islamic scholarship to ensure you receive reliable guidance for your marriage journey.
        </p>
      </div>

      <!-- Category Filter -->
      <div class="flex flex-wrap gap-2 justify-center mb-10">
        <a href="/islamic-faqs"
           class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 <%= !currentCategory ? 'bg-primary text-white shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:border-primary hover:text-primary' %>">
          All
        </a>
        <% const categoryColors = {
          'Destiny': 'purple',
          'Birth': 'blue',
          'Divorce': 'red',
          'Engagement': 'pink',
          'Family': 'green',
          'Getting Married': 'emerald',
          'Intimacy': 'rose',
          'Prayer & Purification': 'indigo',
          'Rights & Responsibilities': 'orange',
          'Spouse Search': 'amber'
        }; %>
        <% const allCategories = ['Destiny','Birth','Divorce','Engagement','Family','Getting Married','Intimacy','Prayer & Purification','Rights & Responsibilities','Spouse Search']; %>
        <% allCategories.forEach(cat => { %>
        <a href="/islamic-faqs?category=<%= encodeURIComponent(cat) %>"
           class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 <%= currentCategory === cat ? 'bg-primary text-white shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:border-primary hover:text-primary' %>">
          <%= cat %>
        </a>
        <% }) %>
      </div>

      <!-- Questions Grid -->
      <% if (faqs.length === 0) { %>
      <div class="text-center py-20">
        <i class="ri-question-answer-line text-6xl text-gray-300 mb-4 block"></i>
        <h3 class="text-xl font-semibold text-gray-500 mb-2">No questions found</h3>
        <p class="text-gray-400">
          <% if (currentCategory) { %>
            No questions in the "<%= currentCategory %>" category yet.
            <a href="/islamic-faqs" class="text-primary hover:underline">View all questions</a>
          <% } else { %>
            Check back soon — we're adding new questions regularly.
          <% } %>
        </p>
      </div>
      <% } else { %>
      <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-6">
        <% faqs.forEach(faq => { %>
        <article class="bg-white rounded-2xl material-shadow hover:material-shadow-hover transition-all duration-300 overflow-hidden group">
          <a href="/islamic-faqs/<%= faq.slug %>" class="block">
            <!-- Image -->
            <div class="relative overflow-hidden bg-gradient-to-br from-amber-50 to-amber-100" style="aspect-ratio:16/9;">
              <% if (faq.featuredImage && faq.featuredImage.url) { %>
              <img
                src="<%= faq.featuredImage.url %>"
                alt="<%= faq.featuredImage.alt || faq.question %>"
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy">
              <% } else { %>
              <div class="absolute inset-0 flex items-center justify-center">
                <i class="ri-question-answer-line text-5xl text-amber-400/40"></i>
              </div>
              <% } %>
            </div>

            <!-- Content -->
            <div class="p-5">
              <h2 class="text-base font-semibold text-gray-800 mb-3 group-hover:text-primary transition-colors duration-200" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                <%= faq.question %>
              </h2>
              <div class="flex items-center justify-between">
                <span class="inline-block px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-semibold uppercase tracking-wide">
                  <%= faq.category %>
                </span>
                <% if (faq.scholar) { %>
                <span class="text-xs text-gray-400 truncate ml-2">– <%= faq.scholar %></span>
                <% } %>
              </div>
            </div>
          </a>
        </article>
        <% }) %>
      </div>
      <% } %>

      <!-- Internal Links Section -->
      <div class="mt-16 pt-10 border-t border-gray-200">
        <h3 class="text-lg font-semibold text-gray-700 mb-4 text-center">Explore More on D'amour Muslim</h3>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="/blog" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm text-gray-600 hover:border-primary hover:text-primary transition-all">
            <i class="ri-article-line"></i> Marriage Blog
          </a>
          <a href="/podcasts" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm text-gray-600 hover:border-primary hover:text-primary transition-all">
            <i class="ri-mic-line"></i> Podcasts
          </a>
          <a href="/profiles?gender=male" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm text-gray-600 hover:border-primary hover:text-primary transition-all">
            <i class="ri-user-line"></i> Browse Men
          </a>
          <a href="/profiles?gender=female" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm text-gray-600 hover:border-primary hover:text-primary transition-all">
            <i class="ri-user-3-line"></i> Browse Women
          </a>
          <a href="/account-faqs" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm text-gray-600 hover:border-primary hover:text-primary transition-all">
            <i class="ri-questionnaire-line"></i> Account FAQs
          </a>
        </div>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>

  <style>
    .material-shadow { box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    .material-shadow-hover { box-shadow: 0 4px 16px rgba(0,0,0,.15); }
  </style>
</body>

</html>
