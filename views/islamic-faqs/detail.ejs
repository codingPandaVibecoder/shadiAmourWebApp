<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= faq.metaTitle || faq.question %> | shadiamour Islamic FAQs</title>
  <meta name="description" content="<%= faq.metaDescription || faq.excerpt || 'Get the Islamic answer to: ' + faq.question %>" />
  <% if (faq.keywords && faq.keywords.length > 0) { %>
  <meta name="keywords" content="<%= faq.keywords.join(', ') %>" />
  <% } %>
  <link rel="canonical" href="https://shadiamour.com/islamic-faqs/<%= faq.slug %>" />

  <!-- Open Graph -->
  <meta property="og:type" content="article" />
  <meta property="og:title" content="<%= faq.metaTitle || faq.question %>" />
  <meta property="og:description" content="<%= faq.metaDescription || faq.excerpt || faq.question %>" />
  <meta property="og:url" content="https://shadiamour.com/islamic-faqs/<%= faq.slug %>" />
  <meta property="og:site_name" content="shadiamour" />
  <% if (faq.featuredImage && faq.featuredImage.url) { %>
  <meta property="og:image" content="<%= faq.featuredImage.url %>" />
  <meta property="og:image:alt" content="<%= faq.featuredImage.alt || faq.question %>" />
  <% } %>
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= faq.metaTitle || faq.question %>" />
  <meta name="twitter:description" content="<%= faq.metaDescription || faq.excerpt || faq.question %>" />

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#E91E63">

  <link rel="stylesheet" href="/css/output.css" />
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"></noscript>

  <%- include('../partials/clarity') %>
  <%- include('../partials/thirdparty') %>
  <%- include('../partials/analytics') %>

  <!-- QAPage structured data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "QAPage",
    "mainEntity": {
      "@type": "Question",
      "name": <%- JSON.stringify(faq.question) %>,
      "text": <%- JSON.stringify(faq.question) %>,
      "dateCreated": "<%= faq.publishedAt ? faq.publishedAt.toISOString() : faq.createdAt.toISOString() %>",
      "url": "https://shadiamour.com/islamic-faqs/<%= faq.slug %>",
      "answerCount": 1,
      "author": {
        "@type": "Organization",
        "name": "D\u2019amour Muslim",
        "url": "https://shadiamour.com"
      },
      "acceptedAnswer": {
        "@type": "Answer",
        "text": <%- JSON.stringify(faq.answer.replace(/<[^>]*>/g, '').substring(0, 1000)) %>,
        "dateCreated": "<%= faq.publishedAt ? faq.publishedAt.toISOString() : faq.createdAt.toISOString() %>",
        "url": "https://shadiamour.com/islamic-faqs/<%= faq.slug %>",
        "upvoteCount": 0,
        "author": {
          "@type": "<%= faq.scholar ? 'Person' : 'Organization' %>",
          "name": <%- JSON.stringify(faq.scholar || "D\u2019amour Muslim Editorial Team") %>,
          "url": "https://shadiamour.com"
        }
      }
    }
  }
  </script>

  <!-- BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://shadiamour.com" },
      { "@type": "ListItem", "position": 2, "name": "Islamic FAQs", "item": "https://shadiamour.com/islamic-faqs" },
      { "@type": "ListItem", "position": 3, "name": <%- JSON.stringify(faq.question) %>, "item": "https://shadiamour.com/islamic-faqs/<%= faq.slug %>" }
    ]
  }
  </script>
</head>

<body class="bg-gray-50 font-['Roboto']">
  <%- include('../partials/header') %>

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-3xl mx-auto px-6">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <i class="ri-arrow-right-s-line"></i>
        <a href="/islamic-faqs" class="hover:text-primary transition-colors">Islamic FAQs</a>
        <i class="ri-arrow-right-s-line"></i>
        <span class="text-gray-400 truncate max-w-xs"><%= faq.category %></span>
      </nav>

      <!-- Article -->
      <article>
        <!-- Category Badge -->
        <div class="mb-4">
          <a href="/islamic-faqs?category=<%= encodeURIComponent(faq.category) %>"
             class="inline-block px-4 py-1.5 bg-amber-100 text-amber-800 rounded-full text-xs font-bold uppercase tracking-wide hover:bg-amber-200 transition-colors">
            <%= faq.category %>
          </a>
        </div>

        <!-- Question H1 -->
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 font-['Playfair_Display'] leading-snug">
          <%= faq.question %>
        </h1>

        <!-- Featured Image -->
        <% if (faq.featuredImage && faq.featuredImage.url) { %>
        <figure class="mb-8 rounded-2xl overflow-hidden material-shadow">
          <img
            src="<%= faq.featuredImage.url %>"
            alt="<%= faq.featuredImage.alt || faq.question %>"
            class="w-full object-cover"
            style="max-height:400px;"
            loading="eager">
          <% if (faq.featuredImage.caption) { %>
          <figcaption class="text-xs text-gray-400 text-center py-2 bg-white px-4"><%= faq.featuredImage.caption %></figcaption>
          <% } %>
        </figure>
        <% } %>

        <!-- Scholar Attribution -->
        <% if (faq.scholar) { %>
        <div class="flex items-center gap-3 mb-8 p-4 bg-amber-50 border border-amber-200 rounded-xl">
          <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center flex-shrink-0">
            <i class="ri-user-star-line text-amber-700 text-lg"></i>
          </div>
          <div>
            <p class="text-xs text-gray-500 mb-0.5">Answered by</p>
            <p class="font-semibold text-gray-800"><%= faq.scholar %></p>
          </div>
        </div>
        <% } %>

        <!-- Answer Content -->
        <div class="prose prose-gray max-w-none faq-answer-content">
          <%- faq.answer %>
        </div>

        <!-- Tags: category + related links -->
        <div class="mt-10 pt-8 border-t border-gray-200">
          <div class="flex flex-wrap items-center gap-3">
            <span class="text-sm text-gray-500 font-medium">Category:</span>
            <a href="/islamic-faqs?category=<%= encodeURIComponent(faq.category) %>"
               class="inline-flex items-center gap-1 px-3 py-1.5 bg-amber-100 text-amber-800 rounded-full text-sm hover:bg-amber-200 transition-colors">
              <i class="ri-price-tag-3-line text-xs"></i>
              <%= faq.category %>
            </a>
          </div>
        </div>
      </article>

      <!-- Back Button -->
      <div class="mt-10">
        <a href="/islamic-faqs" class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-300 text-gray-700 rounded-full hover:bg-gray-50 transition-colors text-sm font-medium">
          <i class="ri-arrow-left-line"></i>
          Back to Islamic FAQs
        </a>
      </div>

      <!-- Related Questions -->
      <% if (related && related.length > 0) { %>
      <section class="mt-14 pt-10 border-t border-gray-200">
        <h2 class="text-2xl font-bold text-gray-800 mb-6 font-['Playfair_Display']">
          More <span class="text-primary"><%= faq.category %></span> Questions
        </h2>
        <div class="grid sm:grid-cols-3 gap-5">
          <% related.forEach(r => { %>
          <article class="bg-white rounded-xl material-shadow hover:material-shadow-hover transition-all duration-300 overflow-hidden group">
            <a href="/islamic-faqs/<%= r.slug %>" class="block">
              <div class="relative overflow-hidden bg-gradient-to-br from-amber-50 to-amber-100" style="aspect-ratio:16/9;">
                <% if (r.featuredImage && r.featuredImage.url) { %>
                <img src="<%= r.featuredImage.url %>" alt="<%= r.featuredImage.alt || r.question %>"
                     class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy">
                <% } else { %>
                <div class="absolute inset-0 flex items-center justify-center">
                  <i class="ri-question-answer-line text-4xl text-amber-400/40"></i>
                </div>
                <% } %>
              </div>
              <div class="p-4">
                <p class="text-sm font-semibold text-gray-800 group-hover:text-primary transition-colors"
                   style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                  <%= r.question %>
                </p>
                <span class="inline-block mt-2 px-2.5 py-0.5 bg-amber-100 text-amber-700 rounded-full text-xs font-medium">
                  <%= r.category %>
                </span>
              </div>
            </a>
          </article>
          <% }) %>
        </div>
        <div class="text-center mt-6">
          <a href="/islamic-faqs?category=<%= encodeURIComponent(faq.category) %>"
             class="inline-flex items-center gap-2 text-primary hover:text-pink-600 font-medium transition-colors">
            View all <%= faq.category %> questions
            <i class="ri-arrow-right-line"></i>
          </a>
        </div>
      </section>
      <% } %>

      <!-- Internal Links -->
      <div class="mt-12 pt-8 border-t border-gray-200">
        <div class="flex flex-wrap gap-3">
          <a href="/islamic-faqs" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm text-gray-600 hover:border-primary hover:text-primary transition-all">
            <i class="ri-question-answer-line"></i> All Islamic FAQs
          </a>
          <a href="/blog" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm text-gray-600 hover:border-primary hover:text-primary transition-all">
            <i class="ri-article-line"></i> Marriage Blog
          </a>
          <a href="/register" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-full text-sm hover:bg-pink-600 transition-all">
            <i class="ri-heart-line"></i> Find Your Spouse
          </a>
        </div>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>

  <style>
    .material-shadow { box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    .material-shadow-hover { box-shadow: 0 4px 16px rgba(0,0,0,.15); }

    .faq-answer-content { font-size: 1.0625rem; line-height: 1.8; color: #374151; }
    .faq-answer-content p { margin-bottom: 1.25rem; }
    .faq-answer-content h2 { font-size: 1.5rem; font-weight: 700; color: #111827; margin: 1.75rem 0 0.75rem; font-family: 'Playfair Display', serif; }
    .faq-answer-content h3 { font-size: 1.25rem; font-weight: 600; color: #1f2937; margin: 1.5rem 0 0.5rem; }
    .faq-answer-content ul, .faq-answer-content ol { padding-left: 1.5rem; margin-bottom: 1.25rem; }
    .faq-answer-content li { margin-bottom: 0.4rem; }
    .faq-answer-content blockquote { border-left: 4px solid #f59e0b; background: #fffbeb; padding: 1rem 1.25rem; margin: 1.5rem 0; border-radius: 0 0.5rem 0.5rem 0; color: #92400e; font-style: italic; }
    .faq-answer-content a { color: #e91e63; text-decoration: underline; }
    .faq-answer-content a:hover { color: #be185d; }
    .faq-answer-content strong { color: #111827; }
    .faq-answer-content img { max-width: 100%; border-radius: 0.75rem; margin: 1rem 0; }
  </style>
</body>

</html>
