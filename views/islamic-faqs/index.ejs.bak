<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Islamic FAQs - Marriage & Nikah Questions Answered | shadiamour</title>
  <meta name="description" content="Get answers to your Islamic marriage questions. Our collection of expert-answered FAQs covers destiny, engagement, nikah, divorce, family rights and more for Muslims in the UK." />
  <meta name="keywords" content="Islamic marriage questions, nikah FAQs, Muslim marriage advice, Islamic guidance on marriage, halal relationship questions UK" />
  <link rel="canonical" href="https://shadiamour.com/islamic-faqs" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Islamic FAQs - Marriage & Nikah Questions Answered | shadiamour" />
  <meta property="og:description" content="Get answers to your Islamic marriage questions. Expert-answered FAQs covering destiny, engagement, nikah, divorce, family rights and more." />
  <meta property="og:url" content="https://shadiamour.com/islamic-faqs" />
  <meta property="og:site_name" content="shadiamour" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Islamic FAQs - Marriage & Nikah Questions Answered" />
  <meta name="twitter:description" content="Get answers to your Islamic marriage questions from respected scholars." />

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#00113a">

  <link rel="stylesheet" href="/css/output.css" />
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"></noscript>

  <%- include('../partials/clarity') %>
  <%- include('../partials/thirdparty') %>
  <%- include('../partials/analytics') %>

  <% if (faqs && faqs.length > 0) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      <%- faqs.slice(0,10).map((f, i) => JSON.stringify({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": (f.excerpt || ((f.answer || '').replace(/<[^>]*>/g, '').substring(0, 300)))
        }
      })).join(',') %>
    ]
  }
  </script>
  <% } %>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://shadiamour.com" },
      { "@type": "ListItem", "position": 2, "name": "Islamic FAQs", "item": "https://shadiamour.com/islamic-faqs" }
    ]
  }
  </script>
</head>

<body class="bg-background text-on-background font-body-md antialiased flex flex-col min-h-screen">
  <%- include('../partials/header') %>

  <main class="flex-grow pt-[92px]">
    <!-- Hero Section -->
    <section class="bg-neutral-gray py-section-padding text-center px-margin-x">
      <div class="max-w-container-max mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-secondary-container/20 border border-secondary-container/40 rounded-full text-secondary font-label-md text-sm font-medium mb-5">
          <i class="ri-question-answer-line"></i>
          <span>Scholar-Answered Questions</span>
        </div>
        <h1 class="text-display-lg-mobile md:text-display-lg font-display-lg-mobile md:font-display-lg text-primary mb-element-gap">
          Islamic FAQs
        </h1>
        <p class="text-body-lg font-body-lg text-on-surface-variant max-w-2xl mx-auto">
          The ins and outs of finding your Muslim spouse — questions answered by respected Islamic scholars.
        </p>
      </div>
    </section>

    <div class="max-w-container-max mx-auto px-margin-x py-section-padding">

      <!-- SEO Text -->
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-headline-lg font-headline-lg text-primary mb-element-gap">Your Islamic Marriage Questions, Answered</h2>
        <p class="text-body-md font-body-md text-on-surface-variant leading-relaxed mb-3">
          Finding a spouse in a halal, Islamic way can raise many questions — from understanding destiny (<em>qadar</em>) and the rights of a spouse, to navigating engagement, nikah contracts, and family obligations. Our collection of Islamic FAQs is answered by knowledgeable scholars to help you navigate your journey with confidence and clarity.
        </p>
        <p class="text-body-md font-body-md text-on-surface-variant leading-relaxed">
          Browse by category below, or explore all questions. Each answer is rooted in authentic Islamic scholarship to ensure you receive reliable guidance for your marriage journey.
        </p>
      </div>

      <!-- Category Filter -->
      <div class="flex flex-wrap gap-2 justify-center mb-10">
        <a href="/islamic-faqs"
           class="px-4 py-2 rounded-full text-label-md font-label-md transition-all duration-200 <%= !currentCategory ? 'bg-primary-container text-on-primary shadow-md' : 'bg-surface text-on-surface-variant border border-outline-variant hover:border-primary-container' %>">
          All
        </a>
        <% (categories || []).forEach(cat => { %>
        <a href="/islamic-faqs?category=<%= encodeURIComponent(cat) %>"
           class="px-4 py-2 rounded-full text-label-md font-label-md transition-all duration-200 <%= currentCategory === cat ? 'bg-primary-container text-on-primary shadow-md' : 'bg-surface text-on-surface-variant border border-outline-variant hover:border-primary-container' %>">
          <%= cat %>
        </a>
        <% }) %>
      </div>

      <!-- Questions Grid -->
      <% if (faqs.length === 0) { %>
      <div class="text-center py-20">
        <i class="ri-question-answer-line text-6xl text-outline-variant mb-4 block"></i>
        <h3 class="text-headline-md font-headline-md text-on-surface-variant mb-2">No questions found</h3>
        <p class="text-body-md font-body-md text-on-surface-variant/70">
          <% if (currentCategory) { %>
            No questions in the "<%= currentCategory %>" category yet.
            <a href="/islamic-faqs" class="text-primary hover:underline">View all questions</a>
          <% } else { %>
            Check back soon — we're adding new questions regularly.
          <% } %>
        </p>
      </div>
      <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        <% faqs.forEach(faq => { %>
        <article class="bg-surface-white rounded-xl overflow-hidden shadow-[0px_4px_20px_rgba(0,35,102,0.05)] border border-outline-variant/30 hover:-translate-y-1 transition-transform duration-300 flex flex-col h-full group">
          <a href="/islamic-faqs/<%= faq.slug %>" class="block flex flex-col h-full">
            <!-- Image -->
            <div class="h-48 w-full bg-neutral-gray relative overflow-hidden">
              <% if (faq.featuredImage && faq.featuredImage.url) { %>
              <img
                src="<%= faq.featuredImage.url %>"
                alt="<%= faq.featuredImage.alt || faq.question %>"
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy">
              <% } else { %>
              <div class="absolute inset-0 flex items-center justify-center">
                <i class="ri-question-answer-line text-5xl text-primary-container/20"></i>
              </div>
              <% } %>
            </div>

            <!-- Content -->
            <div class="p-6 flex-grow flex flex-col">
              <span class="text-label-md font-label-md text-premium-gold mb-2 block uppercase tracking-wider">
                <%= faq.category %>
              </span>
              <h2 class="text-headline-md font-headline-md text-primary mb-3" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                <%= faq.question %>
              </h2>
              <% if (faq.excerpt) { %>
              <p class="text-body-md font-body-md text-on-surface-variant mb-6 flex-grow" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                <%= faq.excerpt %>
              </p>
              <% } %>
              <% if (faq.scholar) { %>
              <div class="flex items-center gap-3 pt-4 border-t border-outline-variant/30 mt-auto">
                <span class="material-symbols-outlined text-outline">account_circle</span>
                <span class="text-label-md font-label-md text-on-surface-variant">Answered by <%= faq.scholar %></span>
              </div>
              <% } %>
            </div>
          </a>
        </article>
        <% }) %>
      </div>
      <% } %>

      <!-- Internal Links Section -->
      <div class="mt-16 pt-10 border-t border-outline-variant/30">
        <h3 class="text-headline-md font-headline-md text-on-surface mb-4 text-center">Explore More on shadiamour</h3>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="/blog" class="inline-flex items-center gap-2 px-4 py-2 bg-surface-white border border-outline-variant rounded-full text-label-md font-label-md text-on-surface-variant hover:border-primary hover:text-primary transition-all">
            <i class="ri-article-line"></i> Marriage Blog
          </a>
          <a href="/podcasts" class="inline-flex items-center gap-2 px-4 py-2 bg-surface-white border border-outline-variant rounded-full text-label-md font-label-md text-on-surface-variant hover:border-primary hover:text-primary transition-all">
            <i class="ri-mic-line"></i> Podcasts
          </a>
          <a href="/profiles?gender=male" class="inline-flex items-center gap-2 px-4 py-2 bg-surface-white border border-outline-variant rounded-full text-label-md font-label-md text-on-surface-variant hover:border-primary hover:text-primary transition-all">
            <i class="ri-user-line"></i> Browse Men
          </a>
          <a href="/profiles?gender=female" class="inline-flex items-center gap-2 px-4 py-2 bg-surface-white border border-outline-variant rounded-full text-label-md font-label-md text-on-surface-variant hover:border-primary hover:text-primary transition-all">
            <i class="ri-user-3-line"></i> Browse Women
          </a>
          <a href="/account-faqs" class="inline-flex items-center gap-2 px-4 py-2 bg-surface-white border border-outline-variant rounded-full text-label-md font-label-md text-on-surface-variant hover:border-primary hover:text-primary transition-all">
            <i class="ri-questionnaire-line"></i> Account FAQs
          </a>
        </div>
      </div>

    </div>
  </main>

  <%- include('../partials/reservationPopup', { popupId: 'scrollPopup', headingText: "Ready to take the next step? Book a free, confidential call with a matchmaker.", triggerType: 'scroll' }) %>

  <%- include('../partials/footer') %>
</body>

</html>
