<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Our Ads | shadiAmour Advertising &amp; Marketing Standards</title>

  <!-- SEO Meta Tags -->
  <meta name="description" content="Learn about shadiAmour's approach to advertising, sponsored content, and marketing standards across our platform and social channels." />
  <meta name="keywords" content="shadiamour ads, muslim marriage ads, halal matrimony media, muslim matchmaking advertisements, shadiamour campaign" />
  <link rel="canonical" href="https://shadiamour.com/our-ads" />

  <!-- Open Graph -->
  <meta property="og:title" content="Our Ads | shadiAmour Advertising & Marketing Standards" />
  <meta property="og:description" content="Learn about shadiAmour's approach to advertising, sponsored content, and marketing standards across our platform and social channels." />
  <meta property="og:url" content="https://shadiamour.com/our-ads" />
  <meta property="og:type" content="website" />

  <!-- Favicon -->
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/images/site.webmanifest">
  <meta name="theme-color" content="#00113a">

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/output.css" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" />

  <style>
    .material-shadow { box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .material-shadow-hover { box-shadow: 0 4px 16px rgba(0,0,0,0.15); }
    .ad-card { transition: transform 0.25s ease, box-shadow 0.25s ease; }
    .ad-card:hover { transform: translateY(-4px); box-shadow: 0 8px 28px rgba(0,35,102,0.12); }
    /* Lightbox */
    #lightbox { backdrop-filter: blur(6px); }
    #lightbox video, #lightbox img { max-height: 85vh; max-width: 90vw; border-radius: 12px; }
  </style>
</head>

<body class="bg-background text-on-background font-body-md antialiased flex flex-col min-h-screen">
  <%- include('./partials/header') %>

  <main class="flex-grow pt-[92px]">
    <!-- Hero -->
    <section class="py-section-padding px-margin-x max-w-container-max mx-auto text-center flex flex-col items-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-secondary-container/20 border border-secondary-container/40 rounded-full text-secondary font-label-md text-sm font-medium mb-6">
        <i class="ri-image-line"></i>
        <span>Official Media Gallery</span>
      </div>
      <h1 class="text-display-lg-mobile md:text-display-lg font-display-lg-mobile md:font-display-lg text-primary mb-6 leading-tight">
        Our Ads &amp; Media
      </h1>
      <p class="text-body-lg font-body-lg text-on-surface-variant max-w-2xl mx-auto">
        shadiAmour advertises across social media, search engines, and community channels (including WhatsApp groups) to reach Muslim professionals looking for a halal spouse.
      </p>
      <div class="mt-8">
        <a href="/register" class="inline-flex items-center gap-2 bg-primary text-on-primary font-semibold px-8 py-4 rounded-xl hover:bg-primary-container transition-all duration-300 shadow-[0px_4px_20px_rgba(0,35,102,0.15)]">
          <i class="ri-user-add-line"></i>
          Join Free Today
        </a>
      </div>
    </section>

    <section class="px-margin-x max-w-container-max mx-auto pb-section-padding">

      <!-- Intro Text (SEO content) -->
      <div class="bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] p-6 md:p-10 mb-10">
        <h2 class="text-headline-md font-headline-md text-primary mb-4">About Our Campaigns</h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <p class="text-on-surface-variant leading-relaxed mb-4">
              At shadiamour, every campaign we run is rooted in one purpose: helping Muslim men and women across the UK find their spouse through a halal, family-friendly, and fully verified platform. Our advertisements reflect the values we stand for — modesty, sincerity, and Islamic etiquette — without compromise.
            </p>
            <p class="text-on-surface-variant leading-relaxed">
              From our social media reels to our print campaigns, every piece of media you see here represents our ongoing commitment to making the rishta and Muslim matchmaking process dignified, accessible, and trustworthy for the British Muslim community.
            </p>
          </div>
          <div>
            <p class="text-on-surface-variant leading-relaxed mb-4">
              Our campaigns span multiple channels — Instagram, Facebook, TikTok, YouTube, and community events across London, Birmingham, Manchester, Bradford, and Leicester. Whether you discovered shadiamour through a reel, a flyer, or word of mouth, this gallery brings together the best of what we have created.
            </p>
            <div class="flex flex-wrap gap-3 mt-4">
              <span class="px-3 py-1.5 bg-secondary-container/20 text-secondary text-sm rounded-full font-medium border border-secondary-container/30">Halal Marriage</span>
              <span class="px-3 py-1.5 bg-primary-fixed text-primary-container text-sm rounded-full font-medium border border-primary-fixed">UK Muslim Community</span>
              <span class="px-3 py-1.5 bg-secondary-container/20 text-secondary text-sm rounded-full font-medium border border-secondary-container/30">Verified Profiles</span>
              <span class="px-3 py-1.5 bg-primary-fixed text-primary-container text-sm rounded-full font-medium border border-primary-fixed">Family Friendly</span>
            </div>
          </div>
        </div>
      </div>

  

      <% if (ads && ads.length > 0) { %>
      <!-- Filter Tabs -->
      <div class="flex items-center gap-3 mb-8 flex-wrap">
        <button class="filter-btn active px-5 py-2 rounded-full text-sm font-medium bg-primary text-white transition-all duration-200" data-type="all">All</button>
        <% if (ads.some(a => a.mediaType === 'image')) { %>
        <button class="filter-btn px-5 py-2 rounded-full text-sm font-medium bg-white text-gray-700 border border-gray-200 hover:border-primary hover:text-primary transition-all duration-200" data-type="image">
          <i class="ri-image-line mr-1"></i>Images
        </button>
        <% } %>
        <% if (ads.some(a => a.mediaType === 'video')) { %>
        <button class="filter-btn px-5 py-2 rounded-full text-sm font-medium bg-white text-gray-700 border border-gray-200 hover:border-primary hover:text-primary transition-all duration-200" data-type="video">
          <i class="ri-video-line mr-1"></i>Videos
        </button>
        <% } %>
      </div>


<!-- Media Grid -->
<div id="mediaGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6">
  <% ads.forEach(ad => { %>

  <div
    class="ad-card bg-surface-white rounded-xl overflow-hidden border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] cursor-pointer"
    data-type="<%= ad.mediaType %>"
  >

    <% if (ad.mediaType === 'image') { %>

    <!-- IMAGE CARD -->
    <div
      class="relative overflow-hidden aspect-[4/3] bg-gray-100"
      onclick="openLightbox('<%= ad.url %>', 'image', '<%= (ad.caption || '').replace(/'/g, '\\\'') %>')"
    >
      <img
        src="<%= ad.url %>"
        alt="<%= ad.caption || 'D\'amour Muslim advertisement' %>"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />

      <!-- Hover Overlay -->
      <div class="absolute inset-0 bg-black bg-opacity-0 hover:bg-opacity-20 transition-all duration-300 flex items-center justify-center">
        <div class="w-12 h-12 bg-white bg-opacity-0 hover:bg-opacity-90 rounded-full flex items-center justify-center transition-all duration-300">
          <i class="ri-zoom-in-line text-xl text-gray-800 opacity-0 hover:opacity-100 transition-opacity duration-300"></i>
        </div>
      </div>

      <!-- Image Badge -->
      <span class="absolute top-3 left-3 px-2 py-1 bg-black/60 text-white text-xs rounded-full font-medium backdrop-blur-sm">
        <i class="ri-image-line mr-1"></i>Image
      </span>
    </div>

    <% } else { %>

    <!-- VIDEO CARD -->
    <div
      class="relative bg-gray-900 cursor-pointer aspect-[4/3] overflow-hidden"
      onclick="openLightbox('<%= ad.url %>', 'video', '<%= (ad.caption || '').replace(/'/g, '\\\'') %>')"
    >

      <!-- <video
        class="w-full h-full object-cover opacity-75"
        muted
        preload="metadata"
        playsinline
      >
        <source src="<%= ad.url %>" type="video/mp4">
      </video> -->
      <video
  class="w-full h-full object-cover opacity-90"
  muted
  preload="metadata"
  playsinline
  autoplay
  loop
>
  <source src="<%= ad.url %>" type="video/mp4">
</video>

      <!-- Play Button -->
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="w-16 h-16 bg-white/90 rounded-full flex items-center justify-center material-shadow hover:scale-110 transition-transform duration-200">
          <i class="ri-play-fill text-2xl text-primary ml-1"></i>
        </div>
      </div>

      <!-- Video Badge -->
      <span class="absolute top-3 left-3 px-2 py-1 bg-primary text-white text-xs rounded-full font-medium">
        <i class="ri-video-line mr-1"></i>Video
      </span>

      <!-- Dark Overlay -->
      <div class="absolute inset-0 bg-black/10 hover:bg-black/20 transition-all duration-300"></div>
    </div>

    <% } %>

    <!-- Caption -->
    <% if (ad.caption) { %>
    <div class="px-4 py-4">
      <p class="text-sm text-on-surface-variant leading-relaxed">
        <%= ad.caption %>
      </p>
    </div>
    <% } %>

  </div>

  <% }) %>
</div>

      <% } else { %>
      <!-- Empty State -->
      <div class="bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] p-16 text-center">
        <i class="ri-image-line text-6xl text-outline-variant mb-4 block"></i>
        <h3 class="text-headline-md font-headline-md text-on-surface mb-2">No Media Yet</h3>
        <p class="text-on-surface-variant">Our media gallery is being updated. Check back soon!</p>
      </div>
      <% } %>

      <!-- Lightbox -->
      <div id="lightbox" class="fixed inset-0 bg-black bg-opacity-80 z-[200] hidden items-center justify-center p-4" onclick="closeLightbox()">
        <div class="relative max-w-5xl w-full flex flex-col items-center" onclick="event.stopPropagation()">
          <button onclick="closeLightbox()" class="absolute -top-12 right-0 text-white text-4xl hover:text-secondary transition-colors z-10">&times;</button>
          <div id="lightboxContent" class="w-full flex justify-center"></div>
          <p id="lightboxCaption" class="mt-4 text-white text-center text-sm opacity-80 max-w-xl hidden"></p>
        </div>
      </div>

   

      <!-- Our Ads -->
      <div class="bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] p-6 md:p-10 mb-10">
        <h2 class="text-headline-md font-headline-md text-primary mb-4">
          <i class="ri-megaphone-line text-primary-container mr-2"></i>
          Our Ads
        </h2>
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div>
            <p class="text-on-surface-variant leading-relaxed mb-4">
              shadiAmour's advertisements are designed to connect Muslim professionals in the UK (and beyond) with a halal, verified, and family-focused way to find their spouse. Our ads appear across social media platforms, search engines, and community channels — including the WhatsApp groups where British Muslims already share news, events, and rishta recommendations.
            </p>
            <p class="text-on-surface-variant leading-relaxed">
              Every campaign reflects our core values: modesty, sincerity, and Islamic etiquette. We market a dignified matchmaking experience — never a casual dating app.
            </p>
          </div>
          <div class="space-y-4">
            <div class="flex items-start gap-3 bg-neutral-gray border border-outline-variant rounded-xl p-4">
              <i class="ri-instagram-line text-primary-container text-xl mt-0.5"></i>
              <div>
                <p class="font-medium text-on-surface">Social Media</p>
                <p class="text-sm text-on-surface-variant">Instagram, Facebook, TikTok &amp; YouTube campaigns.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-neutral-gray border border-outline-variant rounded-xl p-4">
              <i class="ri-google-line text-primary-container text-xl mt-0.5"></i>
              <div>
                <p class="font-medium text-on-surface">Search Engines</p>
                <p class="text-sm text-on-surface-variant">Google search &amp; display advertising.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-neutral-gray border border-outline-variant rounded-xl p-4">
              <i class="ri-whatsapp-line text-primary-container text-xl mt-0.5"></i>
              <div>
                <p class="font-medium text-on-surface">Community Channels</p>
                <p class="text-sm text-on-surface-variant">WhatsApp groups &amp; community events.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- How We Advertise -->
      <div class="mb-10">
        <h2 class="text-headline-md font-headline-md text-primary mb-6">How We Advertise</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] p-6">
            <div class="w-12 h-12 bg-primary-fixed text-primary-container rounded-xl flex items-center justify-center mb-4">
              <i class="ri-target-line text-xl"></i>
            </div>
            <h3 class="text-lg font-bold text-on-surface mb-2">Targeted, Relevant Reach</h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">We target our ads to Muslim professionals searching for halal marriage and matchmaking — not random or intrusive placements.</p>
          </div>
          <div class="bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] p-6">
            <div class="w-12 h-12 bg-primary-fixed text-primary-container rounded-xl flex items-center justify-center mb-4">
              <i class="ri-group-line text-xl"></i>
            </div>
            <h3 class="text-lg font-bold text-on-surface mb-2">Community-First Approach</h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">We advertise where our community already gathers — Islamic events, university Islamic societies, mosques, and trusted WhatsApp groups.</p>
          </div>
          <div class="bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] p-6">
            <div class="w-12 h-12 bg-primary-fixed text-primary-container rounded-xl flex items-center justify-center mb-4">
              <i class="ri-shield-check-line text-xl"></i>
            </div>
            <h3 class="text-lg font-bold text-on-surface mb-2">Honest, Never Misleading</h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">Our ads accurately describe shadiAmour's services and pricing. We never make promises about matches or outcomes we cannot deliver.</p>
          </div>
        </div>
      </div>

      <!-- Advertising Standards We Follow -->
      <div class="mb-10">
        <h2 class="text-headline-md font-headline-md text-primary mb-6">Advertising Standards We Follow</h2>
        <div class="bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] p-6 md:p-10">
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <span class="w-8 h-8 shrink-0 bg-halal-green/10 text-halal-green rounded-lg flex items-center justify-center"><i class="ri-check-line"></i></span>
              <div>
                <h3 class="text-lg font-bold text-on-surface mb-1">Compliance with Advertising Law</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">All shadiAmour advertisements comply with UK advertising standards, including the CAP Code and consumer protection regulations. Claims are substantiated and pricing is transparent.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="w-8 h-8 shrink-0 bg-halal-green/10 text-halal-green rounded-lg flex items-center justify-center"><i class="ri-check-line"></i></span>
              <div>
                <h3 class="text-lg font-bold text-on-surface mb-1">Modesty &amp; Islamic Etiquette</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">Our creative reflects Islamic values of modesty and respect. Imagery and language are always dignified and family-friendly.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="w-8 h-8 shrink-0 bg-halal-green/10 text-halal-green rounded-lg flex items-center justify-center"><i class="ri-check-line"></i></span>
              <div>
                <h3 class="text-lg font-bold text-on-surface mb-1">Privacy &amp; Data Protection</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">We follow the GDPR and the Advertising Standards Authority (ASA) guidance. We never use members' personal data or photos in advertising without explicit consent.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <!-- Advertise or Partner With Us -->
      <div class="mb-10">
        <h2 class="text-headline-md font-headline-md text-primary mb-6">Advertise or Partner With Us</h2>
        <div class="bg-primary rounded-xl shadow-[0px_4px_20px_rgba(0,35,102,0.15)] p-6 md:p-10 text-on-primary">
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <p class="text-lg leading-relaxed mb-4">
                Are you an organisation, Islamic centre, or community partner that would like to work with shadiAmour? We welcome respectful partnerships that help more Muslim professionals find their naseeb.
              </p>
              <p class="text-on-primary/80 leading-relaxed">
                For advertising, sponsorship, or partnership enquiries, email us at:
              </p>
            </div>
            <div class="text-center">
              <a href="mailto:contact@shadiamour.com" class="inline-flex items-center gap-2 bg-on-primary text-primary font-semibold px-6 py-3 rounded-xl hover:bg-secondary-container transition-colors">
                <i class="ri-mail-line"></i>
                contact@shadiamour.com
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Reporting a Concern About Our Ads -->
      <div class="mb-10">
        <h2 class="text-headline-md font-headline-md text-primary mb-6">Reporting a Concern About Our Ads</h2>
        <div class="bg-surface-white rounded-xl border border-outline-variant/30 shadow-[0px_4px_20px_rgba(0,35,102,0.05)] p-6 md:p-10">
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <p class="text-on-surface-variant leading-relaxed mb-4">
                If you believe a shadiAmour advertisement is inaccurate, misleading, or inappropriate in any way, please let us know. We take advertising standards seriously and investigate every report.
              </p>
              <p class="text-on-surface-variant leading-relaxed">
                To report a concern, email our compliance team at:
              </p>
            </div>
            <div class="text-center">
              <a href="mailto:issues@shadiamour.com" class="inline-flex items-center gap-2 bg-primary text-on-primary font-semibold px-6 py-3 rounded-xl hover:bg-primary-container transition-colors">
                <i class="ri-flag-line"></i>
                issues@shadiamour.com
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <%- include('./partials/footer') %>
  <%- include('./partials/analytics') %>

  <script>
    // Lightbox
    function openLightbox(url, type, caption) {
      const lb = document.getElementById('lightbox');
      const content = document.getElementById('lightboxContent');
      const cap = document.getElementById('lightboxCaption');
      if (type === 'image') {
        content.innerHTML = '<img src="' + url + '" alt="D\'amour Muslim ad" class="rounded-xl max-h-[85vh] max-w-[90vw] object-contain" />';
      } else {
        content.innerHTML = '<video controls autoplay class="rounded-xl max-h-[85vh] max-w-[90vw]"><source src="' + url + '" type="video/mp4"></video>';
      }
      if (caption) {
        cap.textContent = caption;
        cap.classList.remove('hidden');
      } else {
        cap.classList.add('hidden');
      }
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      const lb = document.getElementById('lightbox');
      const content = document.getElementById('lightboxContent');
      lb.classList.add('hidden');
      lb.classList.remove('flex');
      content.innerHTML = '';
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeLightbox();
    });

    // Filter tabs
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const type = this.getAttribute('data-type');
        document.querySelectorAll('.filter-btn').forEach(b => {
          b.classList.remove('active', 'bg-primary', 'text-white');
          b.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        });
        this.classList.add('active', 'bg-primary', 'text-white');
        this.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        document.querySelectorAll('.ad-card').forEach(card => {
          if (type === 'all' || card.getAttribute('data-type') === type) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</body>
</html>
